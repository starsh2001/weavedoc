# rights (§6). See TRADEMARK.md; functional use (this path, the weavedoc-*
# skill names, the command name) is expressly permitted.
#
# weavedoc — deterministic checks for a WeaveDoc project (the floor under the AI fidelity gate).
#   validate          format + truth coherence (exit non-zero on any problem)
#   pull <term>       protocol-correct mine lookup for consumers outside the pipeline (see READ.md)
#   impact <mID>      which truths were extracted from a material + which documents cite it (blast radius)
#   status            each document's status + the next step
#   scope             what a verify round still owes — unverified materials + truths, computed
#   attest <verdict> <round> <standard> <id...>   record a verification: digest-bound sidecar row
#   seal-review <doc-id> [draft|final]   pin the clean review to the reviewed bytes + context
#   consecrate <doc-id>   stage candidate → verify seals → ONE full validation → atomic promote
#   upgrade [--check|--dry-run|--apply]   v1 mine → schema 2 (default --check, read-only)
#   gaps              mine census + declared-marker scan (non-blocking floor for the weavedoc-gaps skill)
#   census            mine census only (truth files vs index, numbering holes, live/status tallies)
#   reindex [--check] regenerate truths/index.md + truths/tree.md from truth frontmatter (--check: diff only)
#   retag <old> <new> rename/merge a tag across truths·required_tags·scope_tags (--dry: report only)
#   version           the installed runtime bundle version (.weavedoc/VERSION)
#   lang              the project's reply/artifact language (config.language)
#   locale            detect the OS language (for init); prints nothing if undetectable
#
# No runtime beyond bash + POSIX tools (grep/awk/sed/sort). Ships inside .weavedoc/ — no install.
# Format SoT: .weavedoc/schema   Paths: .weavedoc/config.yaml

set -u
# NOTE (v0.3.1): a blanket `export LC_ALL=C` was tried here to make NBSP-in-heading verdicts
# locale-independent (the macOS leg's 5 failures). It broke Korean tag rewriting in retag — the
# project language is NOT opaque bytes to gawk's gsub/match — so the fix belongs at the specific
# patterns instead: heading readers use explicit ASCII space classes, never [[:space:]].
# ---- preflight (WD-CLI-001): the documented floor, enforced before anything structural ----
# bash >= 4 must be checked BEFORE the first `declare -A`: on 3.2 that line errors and execution
# CONTINUES with arrays silently behaving as scalars — the exact cryptic failure this line ends.
if [ -z "${BASH_VERSINFO:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  echo "weavedoc: bash >= 4 required — this is ${BASH_VERSION:-not bash}. macOS: brew install bash, then run via that bash" >&2
  exit 2
fi
preflight_gnu() { # GNU sed+awk, checked by validate and the write commands (two forks — not
  # spent on light reads; BSD tools don't fail here, they differ silently, which is worse).
  sed --version >/dev/null 2>&1 && awk --version >/dev/null 2>&1 && return 0
  echo "weavedoc: GNU sed + GNU awk required (BSD tools differ silently) — macOS: brew install gawk gnu-sed, and put their gnubin dirs on PATH" >&2
  return 2
}
SCRIPT_DIR=$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd)

# ---- find project ROOT: walk up from CWD for a .weavedoc/ dir; fallback to the script's repo ----
find_root() {
  local d="$PWD"
  while [ "$d" != "/" ] && [ -n "$d" ]; do
    [ -d "$d/.weavedoc" ] && { echo "$d"; return; }
    d=$(dirname "$d")
  done
  ( cd "$SCRIPT_DIR/../.." >/dev/null 2>&1 && pwd )
}
ROOT=$(find_root)
CONFIG="$ROOT/.weavedoc/config.yaml"
SCHEMA="$ROOT/.weavedoc/schema"
[ -f "$SCHEMA" ] || SCHEMA="$SCRIPT_DIR/../schema"   # fallback: schema beside the script

# ---- config readers ----
cfg() { # $1=key $2=default -> a paths: value, resolved relative to ROOT
  local v
  v=$(grep -E "^[[:space:]]+$1:[[:space:]]" "$CONFIG" 2>/dev/null | head -1 \
      | sed -E "s/^[[:space:]]+$1:[[:space:]]*//; s/[[:space:]]*#.*$//; s/[[:space:]]*$//")
  [ -z "$v" ] && v="$2"
  case "$v" in
    /*) echo "$v" ;;
    # A Windows drive-absolute path is absolute, not a folder name to glue under ROOT — the old
    # fallthrough produced "$ROOT/C:\x", a path that exists nowhere and misreports as a redirect.
    [A-Za-z]:[\\/]*) printf '%s\n' "${v//\\//}" ;;
    *) echo "$ROOT/$v" ;;
  esac
}
# The config is read ONCE (WD-PERF-001): cfgval was grep+head+sed and cfg2 an awk, both inside
# `$(…)`, and validate asks ~19 questions of a 30-line file — 38 forks at ~190ms. One pass fills
# two views: CFGFLAT (first match anywhere, what cfgval means) and CFG (section.key, what cfg2
# means). Value rules unchanged: a trailing YAML comment is stripped outside quotes, and a key
# whose colon has no value is absent, exactly as the old grep required.
declare -A CFG CFGFLAT
CFG_LOADED=""
cfg_load() {
  [ -n "$CFG_LOADED" ] && return 0
  CFG_LOADED=1
  [ -f "$CONFIG" ] || return 0
  local line t sec="" k v
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    t=${line#"${line%%[![:space:]]*}"}                 # ltrim
    case "$t" in ''|'#'*) continue ;; *:*) ;; *) continue ;; esac
    k=${t%%:*}; v=${t#*:}
    case "$k" in ''|*[!A-Za-z0-9_.-]*) continue ;; esac
    v=${v#"${v%%[![:space:]]*}"}                       # ltrim value
    case "$v" in '"'*) ;; *) v=${v%%[[:space:]]#*} ;; esac   # strip trailing comment outside quotes
    v=${v%"${v##*[![:space:]]}"}                       # rtrim
    if [ "$t" = "$line" ]; then sec=$k; else [ -n "$sec" ] && [ -n "${CFG[$sec.$k]+x}" ] || CFG[$sec.$k]=$v; fi
    [ -n "$v" ] && { [ -n "${CFGFLAT[$k]+x}" ] || CFGFLAT[$k]=$v; }
  done < "$CONFIG"
  return 0
}
cfgval() { cfg_load; printf '%s\n' "${CFGFLAT[$1]-}"; }
cfg2() { # $1=top-level section $2=key -> the value inside that section ONLY (WD-CFG-001).
  # cfgval is first-match across the whole file and can never see review.strength behind
  # verify.strength — the section walls are what make the two knobs two knobs.
  # Answered from the one-pass cache; nested levels (repeat's per-scale map) sit under their
  # section exactly as the old indented-key match put them.
  cfg_load; printf '%s\n' "${CFG[$1.$2]-}"
}
rp() { ( cd "$1" >/dev/null 2>&1 && pwd -P ); }   # real path; empty when it does not exist
require_inside_root() { # $1=dir $2=command — a WRITE target outside the project, or reached
  # through a symlink, is refused (WD-IO-001). Reads may follow a redirected path wherever the
  # user pointed it; writing there is another matter.
  local p="${1%/}" rr pr
  if [ -L "$p" ]; then echo "$2: refusing to write through a symlink: $p" >&2; return 1; fi
  rr=$(rp "$ROOT"); pr=$(rp "$p")
  [ -n "$pr" ] || { echo "$2: write target does not exist: $p" >&2; return 1; }
  case "$pr/" in "$rr"/*) return 0 ;; esac
  echo "$2: refusing to write outside the project root: $p (resolves to $pr; root is $rr)" >&2
  return 1
}
# Two spellings of one folder are one folder. String-comparing `paths` read `./materials` and an
# absolute path to the default folder as redirects, and validate then falsely blocked the run.
MATERIALS=$(cfg materials "materials"); MATERIALS=${MATERIALS%/}
TRUTHS=$(cfg truths "truths"); TRUTHS=${TRUTHS%/}
DOCUMENTS=$(cfg documents "documents"); DOCUMENTS=${DOCUMENTS%/}
PROJECT="$ROOT/project.md"
CATALOG="$ROOT/catalog.md"

# ---- schema + generic markdown helpers ----
# The schema is read ONCE into memory (WD-PERF-001): the old sch() spawned grep+head+sed on every
# lookup and validate makes hundreds, which on MSYS is most of the runtime. Exact-key matching also
# fixes a latent bug — the old pattern interpolated the key into a regex, so `.` matched any char.
declare -A SCH
sch_load() {
  [ -f "$SCHEMA" ] || return 0
  local line k v
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    case "$line" in *:*) ;; *) continue ;; esac
    k=${line%%:*}
    case "$k" in ''|*[!a-zA-Z0-9._]*) continue ;; esac
    v=${line#*:}; v=${v#"${v%%[![:space:]]*}"}
    [ -n "${SCH[$k]+x}" ] || SCH["$k"]=$v   # first match wins, as the grep|head-1 did
  done < "$SCHEMA"
}
sch()   { printf '%s\n' "${SCH[$1]-}"; }
# MSYS forks at ~190ms (measured: 100 `echo|tr` pipelines = 38s, 100 builtin loops = 0.07s), so on
# Windows the runtime IS the process count. These two do in-shell what `pipes … | grep -qx` and
# `$(…)` did with three forks each; the pipe-list contract (values may contain spaces, never `|`)
# is what makes the pure-string form exact rather than a word-splitting approximation.
in_list() { # $1=needle $2=pipe-separated list -> 0 when the list holds exactly $1
  case "|$2|" in *"|$1|"*) return 0 ;; esac
  return 1
}
# (pipes is defined ONCE, below sch_load — a second definition here silently won the name for
#  months while calls were counted against this one. One name, one body.)
# Every key the code reads through sch(). Declared, not derived: validate used to grep its own
# source for this roster at runtime (WD-ARC-001) — a behavior that broke the moment the file was
# renamed or read-only. `meta_schema_roster` proves this list still covers every sch() call site.
SCH_KEYS="config.enum.attribution config.enum.completeness config.enum.detection config.enum.scale
config.repeat.scales config.strength.range config.toplevel fm.placeholder humanqueue.enum.ownership
humanqueue.enum.state material.fm.enum.origin material.fm.enum.stage material.fm.enum.status
material.fm.required material.fm.required_when.research plan.fm.enum.status plan.fm.required
plan.fm.enum.audience
project.fm.required review.enum.kind review.enum.reviewed_kind review.sections schema.version truth.fm.enum.provenance
truth.fm.enum.status truth.fm.required truth.fm.resolution.decided_by
truth.fm.resolution.decision_kind truth.fm.resolution.type verify.fm.enum.status verify.fm.required
verify.ledger.file verify.ledger.origin.material verify.ledger.origin.truths verify.ledger.verdicts verify.sections verify.units.verified"
sch_load
pipes() { # pipe-separated list -> one item per line; also in REPLY (v0.3.4 — a `$(pipes …)`
  # in a per-material loop is one subshell per material)
  local IFS='|' out="" x
  for x in $1; do out+="$x"$'\n'; done
  REPLY=$out
  [ -n "$out" ] && printf '%s' "$out"
  return 0
}
is_placeholder() { # $1=value -> 0 when it is an untouched template placeholder
  # An unfilled `{…}` placeholder is not a value (ruled 2026-07-31) — write once read a placeholder
  # tone AS the document's tone. Pattern lives in the schema so there is one spelling.
  # The schema pattern is `^[{][^{}]*[}]$` — "entirely ONE brace group". Matched with shell globs
  # so the hot path spends no fork; the schema stays the SoT and meta_placeholder_pattern pins the
  # two spellings together.
  [ -n "$1" ] || return 1
  case "$1" in
    '{'*'}') case "$1" in *'{'*'{'*|*'}'*'}'*) return 1 ;; esac; return 0 ;;
  esac
  return 1
}
req_value() { # $1=file $2=key $3=label-for-message -> 0 when the field holds a real value
  local rv; fmv "$1" "$2"; rv=$REPLY
  if [ -z "$rv" ]; then
    prob FM-MISSING "$1  frontmatter '$2' missing"; return 1
  elif is_placeholder "$rv"; then
    prob FM-PLACEHOLDER "$1  frontmatter '$2' still holds the template placeholder $rv — that is an instruction, not a value, and every consumer reads it as one (write took a placeholder tone as the document's tone). Replace it with the real value; if the value genuinely belongs in braces, put any character outside them"
    return 1
  fi
  return 0
}
has_fm() { # $1=file -> 0 when line 1 opens a frontmatter block
  # One spelling of the opening fence — `^---[[:space:]]*$`, the same pattern every in-frontmatter
  # reader uses. A bare `"---"` literal comparison split on a trailing space and disabled the seal.
  # Three forks (head|tr|grep) for one line became a builtin read — same pattern, same verdict.
  local l
  [ -f "$1" ] || return 1
  IFS= read -r l < "$1" 2>/dev/null || return 1
  l=${l%$'\r'}; l=${l%"${l##*[![:space:]]}"}
  [ "$l" = "---" ]
}
# Frontmatter is parsed ONCE PER FILE, not once per key (WD-PERF-001): validate asks a material for
# ~15 fields, and at ~190ms per fork that was 15 awk spawns for one file. One pass fills the cache;
# every later read is an array lookup. Value rules unchanged — trailing YAML comment stripped
# outside quotes, quotes peeled, first spelling of a key wins.
# The VALUE rules live in ONE awk function shared by the per-file and the batch loader (v0.3.4):
# two spellings of "how a value is read" is the drift class the schema roster exists to kill.
FM_KV_AWK='function emitkv(   line, k, v) {
  line=$0; k=line; sub(/[[:space:]]*:.*$/, "", k)
  v=line; sub("^" k "[[:space:]]*:[[:space:]]*", "", v)
  if (v !~ /^"/) { sub(/[[:space:]]+#.*$/, "", v); if (v ~ /^#/) v="" }
  sub(/[[:space:]]*$/, "", v); sub(/^"/, "", v); sub(/"$/, "", v)
  printf "%s\037%s\n", k, v }'
declare -A FMV FMLOADED
fm_load() { # $1=file -> parse its frontmatter into FMV once
  local f="$1" line k v
  [ -n "${FMLOADED[$f]+x}" ] && return 0
  FMLOADED[$f]=1
  [ -f "$f" ] || return 0
  while IFS= read -r line; do
    k=${line%%$'\037'*}; v=${line#*$'\037'}
    [ -n "${FMV[$f$'\037'$k]+x}" ] || FMV[$f$'\037'$k]=$v
  done < <(awk "$FM_KV_AWK"'
    NR==1 { if ($0 ~ /^---[[:space:]]*$/) infm=1; next }
    infm && /^---[[:space:]]*$/ { exit }
    infm && /^[A-Za-z_][A-Za-z0-9_-]*[[:space:]]*:/ { emitkv() }
  ' "$f" 2>/dev/null)
  return 0
}
fm_preload() { # $@=files -> ONE awk fills the frontmatter cache for every file (v0.3.4 fold).
  # fm_load's one-awk-per-file is right for a command touching three files and is 60+ spawns
  # for a command touching a mine — the single largest residual after the loop folds. Same
  # value rules (FM_KV_AWK), same first-spelling-wins; already-loaded files are skipped.
  local f line k v cur=""
  local -a want_=()
  for f in "$@"; do
    [ -n "${FMLOADED[$f]+x}" ] && continue
    FMLOADED[$f]=1
    [ -f "$f" ] && want_+=("$f")
  done
  [ "${#want_[@]}" -gt 0 ] || return 0
  while IFS= read -r line; do
    case "$line" in
      $'\036'*) cur=${line#$'\036'} ;;
      *) [ -n "$cur" ] || continue
         k=${line%%$'\037'*}; v=${line#*$'\037'}
         [ -n "${FMV[$cur$'\037'$k]+x}" ] || FMV[$cur$'\037'$k]=$v ;;
    esac
  done < <(awk "$FM_KV_AWK"'
    FNR==1 { infm = ($0 ~ /^---[[:space:]]*$/); printf "\036%s\n", FILENAME; next }
    !infm { next }
    /^---[[:space:]]*$/ { infm=0; next }
    /^[A-Za-z_][A-Za-z0-9_-]*[[:space:]]*:/ { emitkv() }
  ' "${want_[@]}" 2>/dev/null)
  return 0
}
fmv() { # $1=file $2=key -> value in REPLY, zero forks (the form hot loops must use)
  fm_load "$1"; REPLY=${FMV[$1$'\037'$2]-}
}
fm() { fmv "$1" "$2"; printf '%s\n' "$REPLY"; }   # compat: still costs the caller's own $()
listfield() { # `[a, b]` -> one item per line. Was five piped processes (echo|tr|tr|sed|grep);
  # IFS=',' keeps items that contain spaces intact, which word splitting would have broken.
  # Also sets REPLY (newline-joined, v0.3.4 fold): `for x in $(listfield …)` costs a subshell,
  # and the caller's unquoted expansion re-splits on whitespace anyway — `for x in $REPLY` after
  # a bare call has the identical splitting semantics for zero forks.
  local s=$1 item IFS=',' out=""
  s=${s//[/}; s=${s//]/}; s=${s//\"/}
  for item in $s; do
    item=${item#"${item%%[![:space:]]*}"}; item=${item%"${item##*[![:space:]]}"}
    [ -n "$item" ] && out+="$item"$'\n'
  done
  REPLY=$out
  [ -n "$out" ] && printf '%s' "$out"
  return 0
}
# Both take the FIRST matching section, ending at the next heading of that level. The exit rule is
# listed BEFORE the heading rule, or an adjacent repeat of the heading re-enters instead of ending.
# Repeats are `dup_section`'s job (not merged here); comments are `nocomment`'s.
section_body() { # $1=file (or - for stdin) $2="Header" -> body under the first "# Header"
  awk -v h="$2" '
    on && /^#+[[:space:]]/ { exit }
    $0 ~ ("^#[ 	]+" h "[[:space:]]*$") { on=1; next }
    on { print }
  ' "${1:--}" 2>/dev/null
}
section_body2() { # $1=file (or - for stdin) $2="Header" -> body under the first "## Header"
  awk -v h="$2" '
    on && (/^#[ 	]/ || /^##[ 	]/) { exit }
    $0 ~ ("^##[ 	]+" h "[[:space:]]*$") { on=1; next }
    on { print }
  ' "${1:--}" 2>/dev/null
}
section_all() { # $1=file (or -) $2="Header" -> body of EVERY matching section, any heading level
  # For ledgers that legitimately repeat their heading (Human queue, Adjudications — append-per-round).
  # LEVEL-AGNOSTIC: a section ends only at a SAME-OR-SHALLOWER heading, so the sub-headings a ledger
  # groups its rounds under stay inside and only a sibling section ends it. `Fidelity violations` must
  # NOT use this — a second copy there is a bypass, which `dup_section` blocks.
  awk -v h="$2" '
    function lev(s){ if (match(s, /^#+/)) return RLENGTH; return 0 }
    { if ($0 ~ ("^#+[[:space:]]+" h "[[:space:]]*$")) { on=1; lv=lev($0); next }
      if (on && $0 ~ /^#+[[:space:]]/ && lev($0) <= lv) { on=0 }
      if (on) print }
  ' "${1:--}" 2>/dev/null
}
dup_section() { # $1=file $2=header $3=level(1|2|0=any) $4=raw? (non-empty: do NOT strip comments)
  # Counted through `nocomment`, matching the reader this guards (fid_body): a heading living only in
  # a closed comment must count as absent on both sides, or the gate and the body disagree.
  local pat
  case "${3:-2}" in
    1) pat='^#[ 	]+' ;;
    0) pat='^#{1,6}[ 	]+' ;;   # the spec leaves some section levels unfixed; a copy one
    *) pat='^##[ 	]+' ;;       # level down still hides everything under it
  esac
  # The raw view (skip nocomment) exists for one caller: "the file has this section" vs "the reader
  # can see it". Same pattern, two views at one call site — two functions would drift.
  # Both views are cached per file and counted in-shell (WD-PERF-001): callers ask this ~10 times
  # per document, and each ask used to be a nocomment + a grep. The comment stripper still runs —
  # once per file — because its state machine is the thing fid_body agrees with.
  local body
  if [ -n "${4:-}" ]; then file_raw "$1"; else file_stripped "$1"; fi
  body=$REPLY
  count_headings "$body" "$2" "${3:-2}"
  printf '%s\n' "$REPLY"
}
declare -A FILERAW FILESTRIP
file_raw() { # $1=file -> contents in REPLY, no fork (read builtin, cached)
  local f="$1" c="" l
  if [ -z "${FILERAW[$f]+x}" ]; then
    if [ -f "$f" ]; then while IFS= read -r l || [ -n "$l" ]; do c+="$l"$'\n'; done < "$f"; fi
    FILERAW[$f]=$c
  fi
  REPLY=${FILERAW[$f]}
}
file_stripped() { # $1=file -> comment-stripped contents in REPLY (one nocomment per file, cached)
  local f="$1"
  [ -n "${FILESTRIP[$f]+x}" ] || FILESTRIP[$f]=$(nocomment < "$f" 2>/dev/null)
  REPLY=${FILESTRIP[$f]}
}
count_headings() { # $1=body $2=exact heading text $3=level(1|2|0=any) -> count in REPLY
  # ASCII space/tab ONLY, never [[:space:]] (v0.3.1): under a UTF-8 locale NBSP joins that class,
  # so `# Fidelity violations<NBSP>` would read as the real heading on one machine and not on
  # another — same bytes, different verdict. The gate's readability must not be locale-dependent.
  local want="$2" lv="$3" n=0 l hashes rest
  while IFS= read -r l; do
    l=${l%$'\r'}
    case "$l" in '#'*) ;; *) continue ;; esac
    hashes=""; rest=$l
    while [ "${rest:0:1}" = "#" ]; do hashes+="#"; rest=${rest:1}; done
    case "$rest" in [' 	']*) ;; *) continue ;; esac
    rest=${rest#"${rest%%[! 	]*}"}; rest=${rest%"${rest##*[! 	]}"}
    [ "$rest" = "$want" ] || continue
    case "$lv" in
      1) [ "$hashes" = "#" ] || continue ;;
      0) [ ${#hashes} -le 6 ] || continue ;;
      *) [ "$hashes" = "##" ] || continue ;;
    esac
    n=$((n+1))
  done <<< "$1"
  REPLY=$n
}
comment_balanced() { # $1=file -> 0 if the file does not END inside a comment
  # Runs `nocomment`'s own state machine rather than counting delimiters. Counting was not a
  # balance test at all: one orphan `-->` earlier in the file offsets a later unterminated
  # `<!--`, the totals match, and the check passes on exactly the file whose counts are lies.
  awk '
    { line=$0
      while (1) {
        if (inc) { i=index(line,"-->"); if (i==0) { line=""; break }; line=substr(line,i+3); inc=0 }
        i=index(line,"<!--"); if (i==0) break
        rest=substr(line,i+4); j=index(rest,"-->")
        if (j==0) { inc=1; break }
        line=substr(rest,j+3)
      } }
    END { exit inc?1:0 }' "$1" 2>/dev/null
}
countlines() {
  # Drops a bullet whose bracket still opens a placeholder, nothing more — unlike is_noise it takes a
  # caller-supplied pattern across ledgers with different enums, so it has no enum to override with.
  # KNOWN LIMIT: a gaps entry keeping brackets around a real kind (`- [<reference>] t001 …`) is
  # undercounted here; closing it needs the caller to pass its enum in.
  grep -vE '^[[:space:]]*- [[][{<]' 2>/dev/null | grep -cE "$1" 2>/dev/null || true
}
# (countlines' placeholder-drop keeps a freshly-initialised gaps.md from reporting a gap that isn't
# there — the same two conditions as is_noise, the machine's only judges of "is this a real entry".)
nocomment() { # stdin -> stdin with <!-- ... --> blocks blanked out (spans lines)
  # Ledger files keep closed/audit history in HTML comments; counting those as live entries is a lie.
  awk '
    { line=$0
      while (1) {
        if (inc) { i=index(line,"-->"); if (i==0) { line=""; break }; line=substr(line,i+3); inc=0 }
        i=index(line,"<!--"); if (i==0) break
        rest=substr(line,i+4); j=index(rest,"-->")
        if (j==0) { line=substr(line,1,i-1); inc=1; break }
        line=substr(line,1,i-1) substr(rest,j+3)
      }
      print line
    }'
}
is_noise() { # blank / comment / untouched template entry
  # The SOLE judge of the consecration gate. Three rules in order; both template dialects covered
  # throughout (gaps.md uses {braces}, review.md uses <angles>).
  local s bk rest slot
  case "$1" in ""|"#"*|"<!--"*|"-->"*) return 0 ;; esac
  s=$(printf '%s' "$1" | sed 's/^[[:space:]]*//')
  [ -z "$s" ] && return 0
  # An entry always carries its `[kind]`; a line with no bracket is prose (e.g. "(없음)"). Anything
  # WITH a bracket still counts, even unbulleted, so a malformed entry cannot hide as prose.
  case "$s" in *"["*) ;; *) return 0 ;; esac
  # An untouched template holds the placeholder NAME in its KIND slot — the one thing separating the
  # two shapes. The gate acts on the kind, so a line without a real one is not an entry it can act on.
  for bk in $(pipes "${SCH[review.enum.kind]}"); do
    case "$s" in "- [$bk]"*|"- [<$bk>]"*|"- [{$bk}]"*) return 1 ;; esac
  done
  # A placeholder KIND slot is not enough — the REST decides (ruled 2026-08-01). A filled entry that
  # missed only the `{kind}` slot is a real violation, not a stub, so the test is whether the
  # REMAINDER is still placeholders (`- [{kind}] {where} — {what}`, or gaps.md's Accepted line with
  # its literal `scope:`/`recheck:` labels); nothing written after the slot at all is still a stub.
  # KNOWN LIMIT: prose that itself contains a `<…>` or `{…}` token (`값이 <10%>다`) reads as a
  # placeholder and falls back to the old behaviour — never toward a new false block.
  # NARROW: only a slot with no trace of a kind. A near-miss (`<Contradiction>`) belongs to the
  # near-miss guidance, whose message is better; taking it here would swallow that jurisdiction.
  case "$s" in "- ["["{<"]*)
      slot=$(printf '%s' "$s" | sed -nE 's/^[^][]*\[([^]]*)\].*$/\1/p' | head -1 | tr '[:upper:]' '[:lower:]')
      for bk in $(pipes "${SCH[review.enum.kind]}"); do
        case "$slot" in *"$bk"*) return 0 ;; esac
      done
      rest=${s#*]}
      # No `]` at all: the slot was never closed, so cutting at `]` leaves the slot's own `}`/`>` in
      # the remainder, reading as "still a template". Cut at the placeholder's own closer instead.
      if [ "$rest" = "$s" ]; then
        case "$s" in *"}"*) rest=${s#*\}} ;; *">"*) rest=${s#*>} ;; *) rest="" ;; esac
      fi
      case "$rest" in *[![:space:]]*) ;; *) return 0 ;; esac
      case "$rest" in *"{"*"}"*|*"<"*">"*) return 0 ;; esac
      return 1 ;;
  esac
  return 1
}
material_ids() { # one folder name per line, zero per-item forks (basename per dir was ~30
  # spawns per call on a real mine, and validate calls this three times)
  local d
  for d in "$MATERIALS"/*/; do [ -d "$d" ] || continue; d=${d%/}; printf '%s\n' "${d##*/}"; done
}
doc_ids() {
  local d
  for d in "$DOCUMENTS"/*/; do [ -d "$d" ] || continue; d=${d%/}; printf '%s\n' "${d##*/}"; done
}
mstatus()      { [ -f "$MATERIALS/$1/converted.md" ] && fm "$MATERIALS/$1/converted.md" status; }
mtitle()       { [ -f "$MATERIALS/$1/converted.md" ] && fm "$MATERIALS/$1/converted.md" title; }
truth_labels() { # $1=as_of $2=provenance $3=assumptions $4=source-stage $5=source-status -> REPLY
  # THE one spelling of every consumer-facing label (field report D1): pull attached
  # PLAN-STAGE/as_of/DERIVED/ADOPTED while index/tree carried none, so the fact a consumer
  # received depended on which entry path they took. Both writers call this; label text is
  # written inline nowhere else, or the two surfaces drift apart again.
  local lab=""
  [ -n "$1" ] && lab="$lab (as_of: $1)"
  case "$2" in
    derived)
      # Absent is not `[]`: FORMATS gives the EMPTY LIST a meaning ("uses stated facts only"),
      # so a missing `assumptions` must not render as that positive declaration.
      if [ -n "$3" ] && [ "$3" != "[]" ]; then lab="$lab [DERIVED — assumes $3]"
      elif [ "$3" = "[]" ]; then lab="$lab [DERIVED — declares no unstated assumptions]"
      else lab="$lab [DERIVED — assumptions NOT DECLARED; open the file before reuse]"; fi ;;
    adopted) lab="$lab [ADOPTED — machine-proposed, user-accepted]" ;;
  esac
  [ "$4" = "plan" ] && lab="$lab [PLAN-STAGE SOURCE — never evidence of use]"
  [ "$5" = "retracted" ] && lab="$lab [RETRACTED SOURCE]"
  REPLY=$lab
}
catalog_ids()  { awk -F'|' '/^[[:space:]]*\|/ { gsub(/[[:space:]]/,"",$2); if ($2 ~ /^m[0-9]+$/) print $2 }' "$CATALOG" 2>/dev/null; }

check_hq_tags() { # $1=file holding a "## Human queue" section
  # Enforced only where a [state] tag is already present: an untagged legacy entry is audit A1s
  # job, not a hard failure — a spec change must not break a mine verified under the old shape.
  # Only `open` needs ownership: it drives the confirmation split; a `ruled` entry is closed and
  # nothing reads its ownership, so requiring one there would be enforcement with no consumer.
  local hqline hqs hqo hqw rel="${1#$ROOT/}"
  while IFS= read -r hqline; do
    # Leading whitespace allowed, matching the counters in status/audit — an indented entry that
    # one side counts and the other skips breaks "open total == sum of the three buckets".
    case "$hqline" in *"- ["*) ;; *) continue ;; esac
    # Three forks per queue entry (grep + two seds) became parameter expansion — same two
    # bracket slots, read left to right.
    local hqt=${hqline#"${hqline%%[![:space:]]*}"} hqr
    case "$hqt" in '- ['*) ;; *) continue ;; esac
    hqr=${hqt#- \[}; hqs=${hqr%%\]*}
    case "$hqr" in *\]*) ;; *) hqs="" ;; esac
    in_list "$hqs" "${SCH[humanqueue.enum.state]}" || continue
    [ "$hqs" = "open" ] || continue
    hqo=""; hqr=${hqr#*\]}; hqr=${hqr#"${hqr%%[![:space:]]*}"}
    case "$hqr" in '['*) hqo=${hqr#\[}; case "$hqo" in *\]*) hqo=${hqo%%\]*} ;; *) hqo="" ;; esac ;; esac
    hqw=$(printf '%s' "$hqline" | sed -E 's/^[[:space:]]*- \[[^]]*\][[:space:]]*//; s/[[:space:]]*—.*$//')
    in_list "$hqo" "${SCH[humanqueue.enum.ownership]}" \
      || prob HQ-UNTAGGED "$rel  Human queue '[$hqs]' entry has no valid ownership tag → add [user-only|recommended|machine]: $hqw"
  done < <(hq_body "$1")
}
hq_body() { # $1=file -> the Human queue body, whichever heading level the file uses
  # verify.md is `##`-sectioned, review.md is `#`-sectioned. The spec added the section to both
  # without saying which level, so read either rather than silently finding nothing in one of them.
  # EVERY matching section, not the first. Both levels are read unconditionally: `^# h$` cannot
  # match a `##` heading and vice versa, so the union is exact and the old "try one, fall back to
  # the other" step is unnecessary. Reading only the first hid every later round's entries from
  # the status counter and from check_hq_tags simultaneously — `human queue: 0` and `✓ all checks
  # passed` over a queue holding open, untagged entries.
  file_stripped "$1"; section_all - "Human queue" <<< "$REPLY"
}
fid_body() { # $1=file -> the 'Fidelity violations' body, ended by a SIBLING section, not by a sub-heading
  # A thin wrapper over fid_mark (the boundary judge): its I-marked lines minus their headings. The
  # "which heading ends the violations section" logic lives in fid_mark, keyed on review.sections;
  # here we only strip the section's own sub-headings out of the BODY. The one shape no level rule can
  # decide — siblings at `##` AND a `## Findings` planted inside a `#` violations section, textually
  # identical — is caught by validate's file-wide entry census, which reads no sections at all.
  fid_mark "$1" | sed -n 's/^I	//p' | grep -vE '^#{1,6}[ 	]' || true
}
fid_mark() { # $1=file -> EVERY nocomment line, prefixed I<TAB> (inside the violations section) or O<TAB>
  # The ONE boundary judge: every line marked I (inside the violations section) or O (outside) from a
  # single walk, so "inside" and "outside" can't drift into a third state. Headings inside are I (the
  # near-miss guidance speaks to them); the heading that ENDS the section, and all after it, is O.
  local sib; sib=$(pipes "${SCH[review.sections]}" | grep -vx 'Fidelity violations' | tr '\n' '|' | sed 's/|$//')
  file_stripped "$1"
  awk -v sib="$sib" <<< "$REPLY" '
    function hlev(s){ if(match(s,/^#+/)) return RLENGTH; return 0 }
    function htext(s,   t){ t=s; sub(/^#+[[:space:]]+/,"",t); sub(/[[:space:]]+$/,"",t); return t }
    { L[NR]=$0 }
    END {
      # the tier: the shallowest level at which this file names one of the sibling sections
      for(i=1;i<=NR;i++){
        if(L[i] !~ /^#{1,6}[ 	]/) continue
        if(sib=="" || htext(L[i]) !~ ("^(" sib ")$")) continue
        if(tier==0 || hlev(L[i])<tier) tier=hlev(L[i])
      }
      for(i=1;i<=NR;i++){
        if(!on){
          if(L[i] ~ /^#{1,6}[ 	]+Fidelity violations[ 	]*$/ && !done){ on=1; lvl=hlev(L[i]) }
          print "O\t" L[i]
          continue
        }
        if(L[i] ~ /^#{1,6}[ 	]/){
          if(hlev(L[i])<=lvl){ on=0; done=1; print "O\t" L[i]; continue }
          if(sib!="" && htext(L[i]) ~ ("^(" sib ")$") && hlev(L[i])<=tier){ on=0; done=1; print "O\t" L[i]; continue }
          print "I\t" L[i]; continue
        }
        print "I\t" L[i]
      }
    }'
}
is_date() { # $1 -> 0 when it is a real YYYY-MM-DD
  # One judge for every date in the mine — checks shape AND value (2026-99-99 fails, so does an
  # unpadded 2026-7-3). Zero-padding is required by the format; the message says which half is wrong.
  case "$1" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;; *) return 1 ;; esac
  # Real calendar, not just shape: 2026-02-31 is a value nobody can read as a date, and the one
  # field a supersedes resolution orders by must not hold one. Leap rule is the full Gregorian
  # (div-4 minus centuries plus div-400), in shell arithmetic — no fork.
  local y=$((10#${1%%-*})) m=$((10#${1:5:2})) d=$((10#${1:8:2})) max=31
  [ "$m" -ge 1 ] && [ "$m" -le 12 ] || return 1
  case $m in
    4|6|9|11) max=30 ;;
    2) max=28
       if [ $((y % 4)) -eq 0 ] && { [ $((y % 100)) -ne 0 ] || [ $((y % 400)) -eq 0 ]; }; then max=29; fi ;;
  esac
  [ "$d" -ge 1 ] && [ "$d" -le "$max" ]
}
canon_id() { # $1 = an id in any zero-padding -> its ONE canonical spelling; empty when not a numeric id
  # The single definition of "how a number is spelled as an id" — used both to resolve a file and to
  # reject a file spelling its number any other way, so lookup and naming convention can't drift.
  # Also sets REPLY (v0.3.4 fold): hot loops call `canon_id x >/dev/null` and read $REPLY — a
  # `$(canon_id x)` costs a subshell (~190ms on MSYS), and validate used to pay it per truth.
  local p n
  case "$1" in t*) p=t ;; m*) p=m ;; *) REPLY=""; return 1 ;; esac
  n=${1#?}; case "$n" in *[!0-9]*|"") REPLY=""; return 1 ;; esac
  printf -v REPLY '%s%03d' "$p" "$((10#$n))"
  printf '%s' "$REPLY"
}
tfile_for() { # $1 = a truth id in any zero-padding -> the file that id names, if one exists
  # One resolver for every reference field, so `t5` can't resolve in one and dangle in another.
  # Leniency here is safe only because filenames are canonical (validate enforces canon_id): with one
  # spelling per number on disk, `t5` names exactly one file.
  local n
  [ -f "$TRUTHS/$1.md" ] && { printf '%s' "$TRUTHS/$1.md"; return 0; }
  case "$1" in t*) ;; *) return 1 ;; esac
  n=$(canon_id "$1") || return 1
  [ -f "$TRUTHS/$n.md" ] && { printf '%s' "$TRUTHS/$n.md"; return 0; }
  return 1
}
truth_digest() { # $1 = truth file -> sha256 of its raw bytes. THE spelling of "what was verified".
  sha256sum "$1" | awk '{print $1}'
}
mat_digest() { # $1 = converted.md -> sha256 of the file MINUS its frontmatter `status:` line.
  # `status` is the lifecycle axis: refine rewrites it at consecration, and a verification that
  # died on a lifecycle stamp would re-fuse the two axes WD-COR-001 split. Only that one
  # frontmatter line is excluded — a body line spelling `status:` is content and stays hashed.
  awk '
    NR==1 && /^---[[:space:]]*$/  { infm=1; print; next }
    infm && /^---[[:space:]]*$/   { infm=0; print; next }
    infm && /^status[[:space:]]*:/ { next }
    { print }' "$1" | sha256sum | awk '{print $1}'
}
unit_digest() { # $1 = canonical id -> its digest by kind; rc 1 when the unit has no file
  case "$1" in
    m*) [ -f "$MATERIALS/$1/converted.md" ] || return 1; mat_digest "$MATERIALS/$1/converted.md" ;;
    t*) local f; f=$(tfile_for "$1") || return 1; truth_digest "$f" ;;
    *)  return 1 ;;
  esac
}
ledger_file() { # -> the sidecar's filename; schema key first, code default second — an older
  # project schema (testbed drift) must degrade to the shipped name, never to "truths/" itself.
  local f; f=${SCH[verify.ledger.file]}; printf '%s' "${f:-verify-ledger.tsv}"
}
schema_ver() { # -> the schema version this runtime targets; same degrade rule as ledger_file
  local s; s=${SCH[schema.version]}; printf '%s' "${s:-2}"
}
# ONE structural row filter for the verification sidecar (v0.3.3): the same six-column format
# validate enforces decides what EVERY reader consumes — scope once read any ≥3-column row while
# validate demanded six, so a truncated attest row counted digest-bound in one command and
# blocked the mine in the other. Verdict WORDS are deliberately not judged here (scope
# quarantines unknown verdicts visibly); structure is. The calendar mirrors is_date.
LEDGER_ROW_AWK='
  function realdate(s,  a, y, m, dd, ml) {
    if (s !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) return 0
    split(s, a, "-"); y = a[1] + 0; m = a[2] + 0; dd = a[3] + 0
    if (m < 1 || m > 12 || dd < 1) return 0
    ml = substr("312831303130313130313031", (m-1)*2 + 1, 2) + 0
    if (m == 2 && (y % 4 == 0 && (y % 100 != 0 || y % 400 == 0))) ml = 29
    return dd <= ml
  }
  function rowok() {
    return (NF == 6 && ($2 == "-" || $2 ~ /^[0-9a-f]{64}$/) \
            && ($4 == "-" || $4 ~ /^[0-9]+$/) && $5 != "" && realdate($6))
  }'
ledger_rows() { # -> "id<TAB>digest<TAB>verdict<TAB>standard" per unit; LAST VALID row per id wins.
  # The standard column rides along for the origin rule (v0.3.2): a legacy-unbound m row counts
  # as material evidence only when its standard names the material origin token.
  local lf="$TRUTHS/$(ledger_file)"
  [ -f "$lf" ] || return 0
  awk -F'\t' "$LEDGER_ROW_AWK"'
    /^#/ { next }
    !rowok() { next }
    { d[$1]=$2; v[$1]=$3; s[$1]=$5 }
    END { for (i in d) print i "\t" d[i] "\t" v[i] "\t" s[i] }' "$lf" \
    | LC_ALL=C sort
}
ledger_rows_badstruct() { # -> ids of rows the strict filter rejects — SHOWN by scope, never absorbed
  local lf="$TRUTHS/$(ledger_file)"
  [ -f "$lf" ] || return 0
  awk -F'\t' "$LEDGER_ROW_AWK"'
    /^#/ { next }
    /^[ \t]*$/ { next }
    !rowok() { print $1 }' "$lf" | LC_ALL=C sort -u
}
artifact_digest() { # $1 = file OR directory -> sha256. THE spelling of "which bytes were reviewed".
  # Directory: `relpath\0sha256\n` manifest, relpaths LC_ALL=C ascending, manifest re-hashed —
  # so adding, removing, renaming or editing any file under final/ changes the one digest.
  if [ -d "$1" ]; then
    ( cd "$1" && find . -type f | sed 's|^\./||' | LC_ALL=C sort | while IFS= read -r p; do
        printf '%s\0%s\n' "$p" "$(sha256sum "$p" | awk '{print $1}')"
      done ) | sha256sum | awk '{print $1}'
  elif [ -f "$1" ]; then
    sha256sum "$1" | awk '{print $1}'
  else
    return 1
  fi
}
doc_draft_path() { # $1=doc-id -> the draft artifact (directory wins, mirroring final resolution)
  if   [ -d "$DOCUMENTS/$1/draft" ];    then printf '%s' "$DOCUMENTS/$1/draft"
  elif [ -f "$DOCUMENTS/$1/draft.md" ]; then printf '%s' "$DOCUMENTS/$1/draft.md"
  else return 1; fi
}
doc_final_path() { # $1=doc-id -> the final artifact (directory wins, mirroring cmd_validate)
  if   [ -d "$DOCUMENTS/$1/final" ];    then printf '%s' "$DOCUMENTS/$1/final"
  elif [ -f "$DOCUMENTS/$1/final.md" ]; then printf '%s' "$DOCUMENTS/$1/final.md"
  else return 1; fi
}
context_digest() { # $1=doc-id -> sha256 over the ground the review's verdict rests on:
  # cited truths (whole file) + their source materials (mat_digest — the `used` stamp lands AFTER
  # consecration and must not stale the review it consecrated under) + config + schema.
  # Manifest rule: repo-relative `path\0sha256\n`, LC_ALL=C sorted, re-hashed.
  local d="$1" t tf src seen="" cited
  # Parsed with listfield, not a bare tr: `cited_truths: ["t001"]` is legal YAML spelling, and
  # dropping the quotes' ids SILENTLY excluded those truths from the context manifest — a cited
  # truth could then move without staling the review (v0.3.1 cold-review finding).
  cited=$(listfield "$(fm "$DOCUMENTS/$d/plan.md" cited_truths 2>/dev/null)")
  {
    for t in $cited; do
      tf=$(tfile_for "$t") || continue
      printf '%s\0%s\n' "truths/$(basename "$tf")" "$(truth_digest "$tf")"
      src=$(canon_id "$(fm "$tf" source)") || src=""
      if [ -n "$src" ] && [ -f "$MATERIALS/$src/converted.md" ]; then
        case " $seen " in *" $src "*) ;; *)
          seen="$seen $src"
          printf '%s\0%s\n' "materials/$src/converted.md" "$(mat_digest "$MATERIALS/$src/converted.md")" ;;
        esac
      fi
    done
    [ -f "$CONFIG" ] && printf '%s\0%s\n' ".weavedoc/config.yaml" "$(sha256sum "$CONFIG" | awk '{print $1}')"
    [ -f "$SCHEMA" ] && printf '%s\0%s\n' ".weavedoc/schema" "$(sha256sum "$SCHEMA" | awk '{print $1}')"
  } | LC_ALL=C sort | sha256sum | awk '{print $1}'
}
mdir_for() { # $1 = a material id in any zero-padding -> the folder that id names, if one exists
  local n
  [ -d "$MATERIALS/$1" ] && { printf '%s' "$MATERIALS/$1"; return 0; }
  case "$1" in m*) ;; *) return 1 ;; esac
  n=$(canon_id "$1") || return 1
  [ -d "$MATERIALS/$n" ] && { printf '%s' "$MATERIALS/$n"; return 0; }
  return 1
}
hq_files() { # -> every file carrying a "## Human queue" section, ONE PER LINE
  # One list, one definition — validate and status must see the same set, or one reports
  # "human queue: 0" over decisions open in files it never opened. Emitted line by line, never
  # space-joined, so a project path containing a space can't split into fragments that match no file.
  [ -f "$TRUTHS/verify.md" ] && printf '%s\n' "$TRUTHS/verify.md"
  doc_ids | while IFS= read -r d; do
    [ -f "$DOCUMENTS/$d/review.md" ] && printf '%s\n' "$DOCUMENTS/$d/review.md"
  done
  return 0
}

# ===================== validate =====================
# NOTE: the four `val()` copies below (validate · census · reindex · pull) and `fm()` above all strip
# a trailing YAML comment from an UNQUOTED value, and must stay in sync. If you touch one, touch all
# five and re-run the template project through validate — fixing only `fm()` left the bulk awk broken.
PROBLEMS=0
DIAGS=""; WARNS=""            # JSON mode collectors: CODE\x02message records joined by \x01
WD_JSON=${WD_JSON:-0}
# Diagnostics carry a STABLE code (WD-CLI-002/WD-QA-003): `prob CODE "message"` — the code is the
# contract, the English prose is presentation and may change. The single-arg form still works and
# reports as UNCODED; meta_uncoded_ratchet pins how many such sites remain, so the number can only
# fall. Human output prefixes the code; JSON output carries it as a field.
prob() {
  local code="UNCODED"
  if [ $# -ge 2 ]; then code="$1"; shift; fi
  PROBLEMS=$((PROBLEMS+1))
  if [ "$WD_JSON" = 1 ]; then DIAGS+="${code}"$'\002'"$*"$'\001'
  else printf '  [%s] %s\n' "$code" "$*"; fi
}
warn() { # same shape, non-counting — surfaced, never failing
  local code="UNCODED"
  if [ $# -ge 2 ]; then code="$1"; shift; fi
  if [ "$WD_JSON" = 1 ]; then WARNS+="${code}"$'\002'"$*"$'\001'
  else printf '  warning: [%s] %s\n' "$code" "$*"; fi
}
emit_probs() { # stdin: lines an awk pass emitted, each "[CODE] rest" (or bare → UNCODED)
  local line code
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
      "["*"]"*) code=${line%%]*}; code=${code#\[}; prob "$code" "${line#*\] }" ;;
      *) prob "$line" ;;
    esac
  done
}
json_esc() { # $1 -> JSON-safe string on stdout
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\t'/\\t}; s=${s//$'\r'/}
  printf '%s' "$s"
}
json_diag_array() { # $1=collector -> [{"code":..,"message":..},...]
  local recs=$1 out="" rec code msg
  while [ -n "$recs" ]; do
    rec=${recs%%$'\001'*}; recs=${recs#*$'\001'}
    code=${rec%%$'\002'*}; msg=${rec#*$'\002'}
    out+="${out:+,}{\"code\":\"$(json_esc "$code")\",\"message\":\"$(json_esc "$msg")\"}"
    [ "$recs" = "$rec" ] && break
  done
  printf '[%s]' "$out"
}

cmd_validate() {
  # $1 (optional, internal): doc id whose in-flight consecration artifacts are exempt — passed
  # ONLY by cmd_consecrate's in-process call. A function argument, not a variable: bash imports
  # the caller's environment into shell variables, so a variable channel let any external caller
  # grant themselves the exemption (`WD_CONSEC_DOC=d1 weavedoc validate` — v0.3.3 finding). The
  # dispatch table rejects arguments to `validate`, so no CLI path reaches this parameter.
  local consec_ok_="${1:-}"
  preflight_gnu || return 2
  # Content caches are per-PROCESS, and a write command that re-validates in the same process
  # (upgrade --apply, retag, consecrate) would otherwise validate the bytes it CACHED before its
  # own edits — the marker upgrade had just written was invisible to the very validation gating
  # it (v0.3.1 self-caught). A validate always begins from disk.
  FMV=(); FMLOADED=(); FILERAW=(); FILESTRIP=(); DUPLOADED=(); DUPC=()
  # Config cache included (v0.3.4): validate now reads CFGFLAT directly in-parent, so a write
  # command that edited config.yaml and re-validates in the same process must not see the
  # pre-edit bytes ({cfgval} in $() always re-loaded in a subshell, which hid this before).
  CFG_LOADED=""; CFG=(); CFGFLAT=()
  local f id v k a c d p r w mid ref ROLES idc
  # The v1 flag is computed FIRST: the document loop's seal enforcement branches on it, and it
  # used to be set in the config section that runs AFTER documents — so a genuine v1 mine was
  # blocked as tampered for the length of one ordering bug (v0.3.1 self-caught).
  # ONE frontmatter pass primes the cache for the whole mine (v0.3.4): fm_load's awk-per-file
  # is 60+ spawns for a command that touches every file, and validate touches every file.
  # Config loads once, in-parent, so the flags below cost no subshell.
  local -a pre_=()
  local pf_
  pre_+=("$PROJECT")
  for pf_ in "$MATERIALS"/*/converted.md; do [ -f "$pf_" ] && pre_+=("$pf_"); done
  for pf_ in "$TRUTHS"/t[0-9]*.md; do [ -f "$pf_" ] && pre_+=("$pf_"); done
  [ -f "$TRUTHS/verify.md" ] && pre_+=("$TRUTHS/verify.md")
  while IFS= read -r pf_; do
    [ -f "$DOCUMENTS/$pf_/plan.md" ]   && pre_+=("$DOCUMENTS/$pf_/plan.md")
    [ -f "$DOCUMENTS/$pf_/review.md" ] && pre_+=("$DOCUMENTS/$pf_/review.md")
  done < <(doc_ids)
  fm_preload "${pre_[@]}"
  cfg_load
  local pv0 cv0
  fmv "$PROJECT" version 2>/dev/null; pv0=$REPLY
  cv0=${CFGFLAT[version]-}
  SCHEMA_V1=0; { [ "$pv0" = "1" ] || [ "$cv0" = "1" ]; } && SCHEMA_V1=1
  # What was actually examined, reported next to what exists. The counts decide nothing; they make
  # "did not look" (redirected paths, unreadable schema, empty source, unclosed frontmatter) stop
  # resembling "looked and found nothing".
  local N_TRUTH=0 N_SEALED=0 N_MAT=0 N_DOC=0 N_GATED=0 N_CONSEC=0 N_SEALFAIL=0 N_TOMB=0 N_RSEAL=0 N_RLEGACY=0

  # The checks below now READ the schema instead of paraphrasing it, which is right — but it means an
  # unreadable schema turns them OFF rather than making them fail. Silence would look exactly like a
  # pass. So the SoT is checked first: no schema, no verdict.
  # A configured path that is not there, or mine content sitting outside it, is the same leak as an
  # unreadable schema: the loops run zero times and the tick looks earned. FORMATS explicitly allows
  # moving these, so a typo while moving folders silently switches both membranes off.
  for k in materials truths documents; do
    eval "v=\$$(echo "$k" | tr a-z A-Z)"
    [ -d "$v" ] || prob CFG-PATH-MISSING "config paths.$k → '$v' does not exist. Every check that walks it runs zero times, which is indistinguishable from passing"
    [ "$(rp "$v")" = "$(rp "$ROOT/$k")" ] || { [ -d "$ROOT/$k" ] && prob CFG-PATH-REDIRECT "config paths.$k points at '$v' but '$ROOT/$k' also exists on disk — whatever is in it is NOT being checked"; }
  done

  # The roster is DERIVED from this file, not remembered. Four keys used to stand here while
  # twenty-two were being read, so a schema missing any of the other eighteen switched those checks
  # off and still printed a tick — `material.fm.required_when.research` alone let a fetched value in
  # with no url and no retrieved_at. A hand-kept list drifts, and its drift is invisible in exactly
  # the way this guard exists to prevent.
  local schkeys nschk
  schkeys="$SCH_KEYS"
  nschk=$(printf '%s\n' $schkeys | grep -c . || true)
  # The roster is declared (SCH_KEYS) rather than grepped out of this file at runtime. A truncated
  # constant would check a handful quietly, so its size is still asserted out loud.
  if [ "${nschk:-0}" -lt 10 ]; then
    prob SCHEMA-ROSTER "SCH_KEYS holds only ${nschk:-0} entries — the declared schema roster is truncated, so a schema missing any other key will NOT be reported"
  fi
  for k in $schkeys; do
    [ -n "${SCH[$k]-}" ] && continue
    prob SCHEMA-UNREADABLE "$SCHEMA  cannot read '$k' — the format SoT is missing or unreadable, so the checks that read it would silently pass. Restore .weavedoc/schema before trusting any verdict"
    echo "✗ validate: $PROBLEMS problem(s)"; return 1
  done

  # --- project.md ---
  if [ -f "$PROJECT" ]; then
    for k in $(pipes "${SCH[project.fm.required]}"); do
      req_value "$PROJECT" "$k" || true
    done
    fmv "$PROJECT" roles;     listfield "$REPLY" >/dev/null; ROLES=${REPLY%$'\n'}
    fmv "$PROJECT" authority; listfield "$REPLY" >/dev/null
    for a in $REPLY; do
      case $'\n'"$ROLES" in *$'\n'"$a"$'\n'*|*$'\n'"$a") ;; *) prob PROJ-AUTHORITY "$PROJECT  authority '$a' is not a declared role" ;; esac
    done
  else
    prob PROJ-MISSING "$PROJECT  missing (run 'weavedoc init')"; ROLES=""
  fi

  # --- each material ---
  # ONE awk answers "is the frontmatter closed" for every converted.md up front (v0.3.4 fold):
  # it was one awk spawn per material, ~240ms each on MSYS.
  local -A MATFM=()
  local mfmid_ mfmst_
  while IFS=$'\t' read -r mfmid_ mfmst_; do [ -n "$mfmid_" ] && MATFM[$mfmid_]=$mfmst_; done < <(
    awk 'function emit(  n,p) { if (fn == "") return; n=split(fn, p, /[\/\\]/); print p[n-1] "\t" (closed ? "closed" : (opened ? "unclosed" : "nofm")) }
         FNR==1 { emit(); fn=FILENAME; opened=($0 ~ /^---[[:space:]]*$/); closed=0; infm=opened; next }
         infm && /^---[[:space:]]*$/ { closed=1; infm=0 }
         END { emit() }' "$MATERIALS"/*/converted.md 2>/dev/null)
  local morig_ mstat_
  while IFS= read -r id; do
    f="$MATERIALS/$id/converted.md"
    [ -f "$f" ] || { prob MAT-NO-CONVERTED "$MATERIALS/$id/  no converted.md"; continue; }
    # Counted HERE, in the loop that checks them. It used to come from the truths awk as a by-product,
    # and that awk is skipped entirely when the mine has no t*.md yet — so every project reported
    # "materials 0" for the whole window between gather and map while the materials were in fact being
    # fully checked. That is this line telling the user "I did not look" about work it did do, which is
    # precisely the confusion the accounting exists to end, pointed the other way.
    N_MAT=$((N_MAT+1))
    pipes "${SCH[material.fm.required]}" >/dev/null
    for k in $REPLY; do
      req_value "$f" "$k" || continue
      fmv "$f" "$k"; v=$REPLY
      case "$k" in added) is_date "$v" || prob DATE-INVALID "$f  added '$v' is not a date (YYYY-MM-DD, zero-padded, real month and day) — a field the format calls a date and nobody reads as one is a field that can say anything" ;; esac
    done
    # `dated` is optional, but when present it is the ONE field a supersedes resolution orders
    # materials by — an unparseable value there decides a conflict the wrong way round, silently.
    fmv "$f" dated; v=$REPLY
    [ -n "$v" ] && { is_date "$v" || prob DATE-INVALID "$f  dated '$v' is not a date (YYYY-MM-DD, zero-padded, real month and day) — this is the field a 'supersedes' resolution orders materials by, so a value nobody can read as a date decides conflicts by accident"; }
    # The same leak the truth side has a dedicated check for, one door over — and silent here in a
    # nastier way. The truths awk collects a material body only AFTER its frontmatter closes, so a
    # converted.md whose second `---` is missing has an EMPTY body, and then every truth sourced from
    # it is reported as "quote not found … (laundering risk)" while the actual cause is named nowhere.
    # The reader is told the extractions are fabricated when the material is simply unparsed.
    # Only the unclosed case: with no frontmatter at all, the required-key checks below already say so
    # ten times over, whereas an unclosed one satisfies every one of them (fm reads to EOF).
    case "${MATFM[$id]:-}" in
      unclosed) prob MAT-FM-UNCLOSED "$f  frontmatter is never closed (a second '---' is missing) — the parser stays inside it to EOF, so this material has no body at all and every truth sourced from it is reported as a quote missing from its source" ;;
    esac
    # One number, one spelling. `m5` and `m005` normalise to the same id, so a mine holding both
    # makes every reference to it ambiguous — and the resolvers, which are deliberately lenient about
    # padding, would answer with whichever they happened to find first.
    canon_id "$id" >/dev/null || true; idc=$REPLY
    [ -n "$idc" ] && [ "$id" != "$idc" ] &&
      prob MAT-ID-NONCANON "$MATERIALS/$id/  folder name is not the canonical id spelling — rename it to '$idc' (ids are zero-padded to at least three digits). Two spellings of one number resolve to the same id, so any reference to it becomes ambiguous"
    fmv "$f" id; v=$REPLY
    [ "$v" = "$id" ] || prob MAT-ID-MISMATCH "$f  id '$v' != folder '$id'"
    fmv "$f" origin; morig_=$REPLY
    in_list "$morig_" "${SCH[material.fm.enum.origin]}" || prob MAT-ENUM "$f  origin '$morig_' invalid → use ${SCH[material.fm.enum.origin]}"
    fmv "$f" status; mstat_=$REPLY
    in_list "$mstat_" "${SCH[material.fm.enum.status]}" || prob MAT-ENUM "$f  status '$mstat_' invalid → use ${SCH[material.fm.enum.status]}"
    fmv "$f" role; v=$REPLY
    case $'\n'"$ROLES" in *$'\n'"$v"$'\n'*|*$'\n'"$v") ;; *) prob MAT-ROLE "$f  role '$v' not in project.md roles" ;; esac
    fmv "$f" stage; v=$REPLY
    [ -z "$v" ] || in_list "$v" "${SCH[material.fm.enum.stage]}" || prob MAT-ENUM "$f  stage '$v' invalid → use ${SCH[material.fm.enum.stage]}"
    # origin: research — the machine gathered this, so the record must let a cold reviewer
    # re-reach the source. Without url+retrieved_at an externally-fetched value is indistinguishable
    # from something the user said (a real run filed searched astronomical data as 'user-answer',
    # and the whole age table ended up resting on a value verify could never re-check).
    if [ "$morig_" = "research" ]; then
      pipes "${SCH[material.fm.required_when.research]}" >/dev/null
      for k in $REPLY; do
        fmv "$f" "$k"; v=$REPLY
        [ -n "$v" ] || { prob MAT-RESEARCH-FIELDS "$f  origin 'research' requires frontmatter '$k' (a fetched value must stay re-checkable)"; continue; }
        case "$k" in retrieved_at) is_date "$v" || prob DATE-INVALID "$f  retrieved_at '$v' is not a date (YYYY-MM-DD, zero-padded, real month and day) — a field the format calls a date and nobody reads as one is a field that can say anything" ;; esac
      done
    fi
    # corrects: this material displaces named parts of earlier materials
    fmv "$f" corrects; listfield "$REPLY" >/dev/null
    for ref in $REPLY; do
      case "$ref" in m[0-9]*) ;; *) continue ;; esac
      [[ "$ref" =~ ^(m[0-9]+) ]] && mid=${BASH_REMATCH[1]} || continue
      mdir_for "$mid" >/dev/null || prob MAT-CORRECTS-DANGLING "$f  corrects '$ref' → no such material"
      [ "$mid" = "$id" ] && prob MAT-CORRECTS-SELF "$f  corrects itself"
    done
  done < <(material_ids)

  # --- catalog <-> materials (orphans both ways) ---
  # Absence is reported, not treated as "nothing to check": a missing catalog.md would switch the
  # orphan cross-check off in both directions under a clean tick. Only once materials exist.
  if [ ! -f "$CATALOG" ] && [ -n "$(material_ids)" ]; then
    prob CAT-MISSING "$CATALOG  missing — materials exist but the catalog does not, so the orphan cross-check (material with no row, row with no folder) runs zero times in both directions. Run gather, which writes it"
  fi
  if [ -f "$CATALOG" ]; then
    # catalog_ids captured ONCE (v0.3.4 fold): it was re-spawned per material inside the loop.
    local catids_
    catids_=$(catalog_ids)
    while IFS= read -r id; do
      case $'\n'"$catids_"$'\n' in *$'\n'"$id"$'\n'*) ;; *) prob CAT-NO-ROW "$CATALOG  material '$id' has no catalog row" ;; esac
    done < <(material_ids)
    while IFS= read -r id; do
      [ -d "$MATERIALS/$id" ] || prob CAT-GHOST-ROW "$CATALOG  row '$id' has no material folder"
    done <<< "$catids_"
  fi

  # --- truths (single awk pass) ---
  # One awk over all converted.md (read FIRST to populate body[]) + all truth files — the old
  # per-truth process fan-out took minutes on MSYS. Checks: required fields, id==filename,
  # source→material, status/resolution enums, quote existence (anti-laundering), required_tags.
  # Glob is t[0-9]*.md so generated tree.md/index.md are never mistaken for truths.
  # The material lists and required-tag roster are computed OUTSIDE the truth-file guard below: they
  # describe the mine, and the checks needing them must still run when the truths are gone — that
  # state (files 0, index still naming them) is exactly what those checks exist to catch.
  local matlist="" retlist="" reslist="" reqtags qout qn f d
  # A directory wearing a truth filename is not a truth: gawk skips it with a stderr warning, so
  # every per-file check would quietly not run on it while the name sits in the population.
  for f in "$TRUTHS"/t[0-9]*.md; do
    [ -d "$f" ] && prob TRUTH-DIR "$f  is a directory wearing a truth filename — not a truth and not counted; rename or remove it"
  done
  # Builtin path parsing + the fmv cache (the materials loop above already parsed every file):
  # this pair of loops used to spawn basename×3 + fm×2 per material.
  local mb_
  for d in "$MATERIALS"/*/; do [ -d "$d" ] && { mb_=${d%/}; matlist="$matlist ${mb_##*/}"; }; done
  for d in "$MATERIALS"/*/; do
    [ -f "$d/converted.md" ] || continue
    mb_=${d%/}; mb_=${mb_##*/}
    fmv "$d/converted.md" status; [ "$REPLY" = "retracted" ] && retlist="$retlist $mb_"
    fmv "$d/converted.md" origin; [ "$REPLY" = "research" ]  && reslist="$reslist $mb_"
  done
  fmv "$PROJECT" required_tags; reqtags=$(listfield "$REPLY")
  if [ -d "$TRUTHS" ] && ls "$TRUTHS"/t[0-9]*.md >/dev/null 2>&1; then
    # One tag per line, carried in ENVIRON (not -v). Space-joining split a two-word tag
    # `[계약 범위]` into 계약 and 범위 — both reported as having no truths while the real tag went
    # unchecked. Split on the comma, matching truth tags (seentag below).
    local -a qfiles=()
    for f in "$MATERIALS"/*/converted.md; do [ -f "$f" ] && qfiles+=("$f"); done
    for f in "$TRUTHS"/t[0-9]*.md; do [ -f "$f" ] && qfiles+=("$f"); done

    local remlist
    # All ids on the line, zero-padding normalised — same rule census uses. Taking only the first
    # id made a truth listed second on a shared `removed:` line fail validate for having no record.
    remlist=$(grep -oE '^[[:space:]]*-[[:space:]]*removed:.*' "$TRUTHS/changelog.md" 2>/dev/null \
              | grep -oE '(^|[^[:alnum:]])t[0-9]+([^[:alnum:]]|$)' | grep -oE 't[0-9]+' \
              | sed -E 's/^t0*([0-9]+)$/t\1/' | LC_ALL=C sort -u | tr '\n' ' ')
    # The schema is the SoT — READ, not paraphrased into awk. Hardcoding these enums here once made
    # "edit the schema, behaviour follows" false: editing it changed nothing and warned of nothing.
    qout=$(WD_REQTAGS="$reqtags" awk -v matids="$matlist" -v retids="$retlist" -v mroot="$MATERIALS" -v remids="$remlist" -v resids="$reslist" -v Q="'"       -v treq="${SCH[truth.fm.required]//|/ }"       -v tstenum="${SCH[truth.fm.enum.status]//|/ }"       -v tprenum="${SCH[truth.fm.enum.provenance]//|/ }"       -v rtypes="${SCH[truth.fm.resolution.type]//|/ }"       -v rkinds="${SCH[truth.fm.resolution.decision_kind]//|/ }"       -v rby="${SCH[truth.fm.resolution.decided_by]//|/ }"       -v ph="${SCH[fm.placeholder]}" '
      function val(   s){ s=$0; sub(/^[^:]*:[[:space:]]*/,"",s); if(s !~ /^"/){ sub(/[[:space:]]+#.*$/,"",s); if(s ~ /^#/) s="" } sub(/[[:space:]]*$/,"",s); sub(/^"/,"",s); sub(/"$/,"",s); return s }
      function q(s){ return Q s Q }
      # Whitespace-collapsed so the seal does not fail on spacing. [[:space:]] covers the newline, so
      # this is the text as markdown renders it: an extra blank line is the same quote, a skipped line
      # is not.
      function wsnorm(s){ gsub(/[[:space:]]+/," ",s); sub(/^ /,"",s); sub(/ $/,"",s); return s }
      function prob(m){ print "  " m; probs++ }
      function tf_done(   v,tg,nn,ii,ta,wv,wm,w2,ty,selfwin){
        allfile[tid]=tfile; allstat[tid]=tstatus
        if(tidfield != tid) prob("[TRUTH-ID-MISMATCH] " tfile "  id " q(tidfield) " != filename " q(tid))
        # Driven by truth.fm.required (the key census this awk collects), not hardcoded. Present AND
        # non-empty: checking only that the KEY exists is how a bare `source:` passed — the seal is
        # guarded by `tsrc!=""`, so an empty source ran it zero times and a fabricated body went in as
        # `status: ok`.
        for(rk in reqkey){
          if(!((tfile SUBSEP rk) in kcount)) prob("[FM-MISSING] " tfile "  frontmatter " q(rk) " missing")
          else if(kval[tfile,rk]=="") prob("[FM-MISSING] " tfile "  frontmatter " q(rk) " is empty — a key with no value is not a value, and for " q("source") " it silently switches the quote seal off")
          # Same rule as the shell-side req_value, same pattern — read from the schema, not
          # rewritten here. An unfilled placeholder is an instruction, not a value.
          else if(ph!="" && kval[tfile,rk] ~ ph) prob("[FM-MISSING] " tfile "  frontmatter " q(rk) " still holds the template placeholder " kval[tfile,rk] " — that is an instruction, not a value. Replace it with the real value; if the value genuinely belongs in braces, put any character outside them")
        }
        if(hassource && tsrc!="" && !(tsrc in mat)) prob("[TRUTH-SOURCE-DANGLING] " tfile "  source " q(tsrc) " → no material folder")
        v=tstatus
        if(v=="resolved")
          prob("[TRUTH-STATUS-LEGACY] " tfile "  status " q("resolved") " is the pre-rename legacy value → winner-self/attribute: " q("ok") ", loser: " q("discarded"))
        else if(!(v in okstatus))
          prob("[TRUTH-ENUM] " tfile "  status " q(v) " invalid → use " tstenum " (truth.fm.enum.status)")
        # retracted = never a valid extraction. The file stays as a tombstone so the id is never
        # reused and census need not ask "was t241 deleted or lost?"
        # The resolution enums. Hand-editing frontmatter is allowed, so a hand-written decision record
        # must be validated too — nothing checked these before.
        if(tresolution!=""){
          rv=tresolution
          # Space BEFORE the colon is legal YAML; the keys inside this flow object must allow it too,
          # or `{type : pick, …}` blinds all four readers at once — an out-of-enum type and a winner
          # naming a nonexistent truth then pass under a clean tick.
          if(match(rv,/type[[:space:]]*:[[:space:]]*[^,}]+/)){ rt2=substr(rv,RSTART,RLENGTH); sub(/^type[[:space:]]*:[[:space:]]*/,"",rt2); sub(/[[:space:]]+$/,"",rt2)
            if(!(rt2 in oktype)) prob("[RESOLUTION-ENUM] " tfile "  resolution type " q(rt2) " invalid → use " rtypes " (truth.fm.resolution.type)") }
          if(match(rv,/decision_kind[[:space:]]*:[[:space:]]*[^,}]+/)){ rk2=substr(rv,RSTART,RLENGTH); sub(/^decision_kind[[:space:]]*:[[:space:]]*/,"",rk2); sub(/[[:space:]]+$/,"",rk2)
            if(!(rk2 in okkind)) prob("[RESOLUTION-ENUM] " tfile "  resolution decision_kind " q(rk2) " invalid → use " rkinds " (truth.fm.resolution.decision_kind)") }
          if(match(rv,/decided_by[[:space:]]*:[[:space:]]*[^,}]+/)){ rb2=substr(rv,RSTART,RLENGTH); sub(/^decided_by[[:space:]]*:[[:space:]]*/,"",rb2); sub(/[[:space:]]+$/,"",rb2)
            if(!(rb2 in okby)) prob("[RESOLUTION-ENUM] " tfile "  resolution decided_by " q(rb2) " invalid → use " rby " (truth.fm.resolution.decided_by)") }
          else prob("[RESOLUTION-NO-DECIDER] " tfile "  resolution has no " q("decided_by") " → the provenance of a DECISION is the second membrane; without it the mine cannot say whether a human ruled or the machine picked")
        }
        if(v=="retracted" && tresolution!="")
          prob("[TRUTH-RETRACTED-RULE] " tfile "  status " q("retracted") " must not carry a resolution — it lost no conflict; record the withdrawal in truths/changelog.md as " q("removed:"))
        if(v=="retracted"){
          retracted[tid]=1; tidz=tid; sub(/^t0*/,"t",tidz); if(tidz!="t") retracted[tidz]=1
          # Without this, `retracted` would be the one unusable status with no mechanical obligation —
          # a cheap way to disappear an inconvenient truth. The `removed:` line keeps it answerable.
          tidn=tid; sub(/^t0*/,"t",tidn); if(tidn=="t") tidn=tid
          if(!(tidn in removedlog))
            prob("[TRUTH-RETRACTED-RULE] " tfile "  status " q("retracted") " but truths/changelog.md has no " q("removed: " tid) " line → a withdrawal with no recorded reason is indistinguishable from a quiet deletion")
        }
        # Normalise zero-padding and remember the status, or `conflict_with: [t5]` never matches
        # retracted `t005` and a resolved truth is told to re-open a conflict it does not have.
        statusof[tid]=v
        tidn3=tid; sub(/^t0*/,"t",tidn3); if(tidn3=="t") tidn3=tid
        existsn[tidn3]=1; existsn[tid]=1
        tidn2=tid; sub(/^t0*/,"t",tidn2); if(tidn2=="t") tidn2=tid; norm2raw[tidn2]=tid
        if(tconflict!=""){ nn=split(tconflict,ta,/[][, ]+/)
          for(ii=1;ii<=nn;ii++){ if(ta[ii]=="") continue
            cwn=ta[ii]; sub(/^t0*/,"t",cwn); if(cwn=="t") cwn=ta[ii]
            cwof[tid]=cwof[tid] " " cwn } }
        if(v=="conflict" && tconflict=="") prob("[CONFLICT-RECIPROCITY] " tfile "  status is " q("conflict") " but no conflict_with field")
        if(v=="discarded" && tresolution=="") prob("[DISCARDED-RULE] " tfile "  status is " q("discarded") " but no resolution field (a discard must record its decision)")
        # status = validity axis, resolution = history. Guard the two mismatches:
        if(tresolution!=""){
          w2=""; ty=""
          if(match(tresolution,/winner[[:space:]]*:[[:space:]]*(\[[^]]*\]|[^,}]+)/)) w2=substr(tresolution,RSTART,RLENGTH)
          if(match(tresolution,/type[[:space:]]*:[[:space:]]*[a-z]+/)){ ty=substr(tresolution,RSTART,RLENGTH); sub(/type[[:space:]]*:[[:space:]]*/,"",ty) }
          # Match the padded id AND the unpadded one, or `winner: [t5]` in t005.md reads as "somebody
          # else won" and validate tells the user to discard the WINNER — which takes their chosen
          # value out of the mine.
          selfwin = (w2!="" && (match(w2, "(^|[^0-9A-Za-z])" tid "([^0-9]|$)") || match(w2, "(^|[^0-9A-Za-z])" tidn3 "([^0-9]|$)")))
          if(v=="discarded" && selfwin)
            prob("[DISCARDED-SELF-WIN] " tfile "  discarded but resolution.winner is itself → it WON its conflict; set status " q("ok"))
          if(v=="ok" && w2!="" && !selfwin && ty!="attribute")
            prob("[OK-BUT-LOST] " tfile "  ok but its resolution says it lost (winner elsewhere) → set status " q("discarded"))
        }
        if(tprov!="" && !(tprov in okprov))
          prob("[PROV-ENUM] " tfile "  provenance " q(tprov) " invalid → use " tprenum " (truth.fm.enum.provenance)")
        if(tprov=="derived" && !hasderivedfrom)
          prob("[PROV-DERIVED-REFS] " tfile "  provenance is " q("derived") " but no derived_from field (derivations must show their chain)")
        # `origin: research` stops laundering at the material; without this it resumes one level down.
        # Nobody stated a value the machine fetched, and `stated` is the default — so silence lands there.
        if(hassource && (tsrc in research) && (tprov=="" || tprov=="stated"))
          prob("[TRUTH-SOURCE-DANGLING] " tfile "  source " q(tsrc) " is " q("origin: research") " (machine-fetched) but provenance is " q("stated") " → nobody stated it; use " q("adopted") " (user accepted the fetched value) or " q("derived") " (computed from it)")
        if(hassource && (tsrc in ret) && (v=="ok" || v=="conflict"))
          prob("[TRUTH-SOURCE-DANGLING] " tfile "  source " q(tsrc) " is retracted but status is " q(v) " → set unsupported (map retraction propagation)")
        if(tresolution!="" && match(tresolution,/winner[[:space:]]*:[[:space:]]*(\[[^]]*\]|[^,}]+)/)){
          wv=substr(tresolution,RSTART,RLENGTH); w3=wv
          while(match(wv,/m[0-9]+/)){
            wm=substr(wv,RSTART,RLENGTH); wv=substr(wv,RSTART+RLENGTH)
            if(wm in ret) prob("[WINNER-RETRACTED] " tfile "  resolution winner references retracted " wm " → basis gone; re-open the conflict (map)")
          }
          # A loser pointing at a retracted winner sends every consumer following the successor
          # straight to a tombstone — the second escape route (resolve, then retract the winner).
          while(match(w3,/t[0-9]+/)){
            wm=substr(w3,RSTART,RLENGTH); w3=substr(w3,RSTART+RLENGTH)
            wmn=wm; sub(/^t0*/,"t",wmn); if(wmn=="t") wmn=wm
            if(wmn!=tidn3) winnerof[wmn]=winnerof[wmn] " " tid
          }
        }
        # Dangling-reference check for every id-bearing list field. resolution.winner rides along as
        # the fifth: `pull` sends every reader of a discarded truth to the winner, so a typo there
        # pointed the protocol at a nonexistent truth silently. Only the winner CLAUSE is scanned —
        # `reason:` is free prose that may name ids it only talks about.
        for(ff=1; ff<=5; ff++){
          fv = (ff==1)?tconflict : (ff==2)?tsuperseded : (ff==3)?tderivedfrom : (ff==4)?tcorrob : w2
          fn = (ff==1)?"conflict_with" : (ff==2)?"superseded" : (ff==3)?"derived_from" : (ff==4)?"corroborated_by" : "resolution.winner"
          if(fv=="") continue
          fw=fv
          while(match(fw,/[tm][0-9]+/)){
            rid=substr(fw,RSTART,RLENGTH); fw=substr(fw,RSTART+RLENGTH)
            ridn=rid; sub(/^t0*/,"t",ridn); sub(/^m0*/,"m",ridn)
            reflist[tid "" fn "" rid]=ridn
          }
        }
        # Only LIVE truths cover a required tag: a tombstone never had standing, and the value of a
        # discarded loser lives on in its winner. Otherwise retracting the last real extraction of a
        # mandatory topic would keep the mine green about it.
        if(v!="retracted" && v!="discarded"){
          tg=ttags; gsub(/[]["]/,"",tg); nn=split(tg,ta,",")
          for(ii=1;ii<=nn;ii++){ gsub(/^[[:space:]]+|[[:space:]]+$/,"",ta[ii]); if(ta[ii]!="") seentag[ta[ii]]=1 }
        }
      }
      BEGIN { nreq=split(ENVIRON["WD_REQTAGS"], rt, "\n")
              nm=split(treq,_r," ");    for(i=1;i<=nm;i++) if(_r[i]!="") reqkey[_r[i]]=1
              nm=split(tstenum,_s," ");  for(i=1;i<=nm;i++) if(_s[i]!="") okstatus[_s[i]]=1
              nm=split(tprenum,_p," ");  for(i=1;i<=nm;i++) if(_p[i]!="") okprov[_p[i]]=1
              nm=split(rtypes,_t," ");   for(i=1;i<=nm;i++) if(_t[i]!="") oktype[_t[i]]=1
              nm=split(rkinds,_k," ");   for(i=1;i<=nm;i++) if(_k[i]!="") okkind[_k[i]]=1
              nm=split(rby,_y," ");      for(i=1;i<=nm;i++) if(_y[i]!="") okby[_y[i]]=1
              nm=split(matids,_a," "); for(i=1;i<=nm;i++) if(_a[i]!=""){ mat[_a[i]]=1; existsn[_a[i]]=1;
                 _mn=_a[i]; sub(/^m0*/,"m",_mn); if(_mn!="m"){ existsn[_mn]=1; matn[_mn]=_a[i] } }
              nm=split(retids,_b," "); for(i=1;i<=nm;i++) if(_b[i]!="") ret[_b[i]]=1
              nm=split(remids,_c," "); for(i=1;i<=nm;i++) if(_c[i]!="") removedlog[_c[i]]=1
              nm=split(resids,_d," "); for(i=1;i<=nm;i++) if(_d[i]!="") research[_d[i]]=1 }
      FNR==1 {
        infm = ($0 ~ /^---[[:space:]]*$/) ? 1 : 0
        n=split(FILENAME,pp,"/")
        if (FILENAME ~ /converted\.md$/) { ftype="m"; mid=pp[n-1]; if(!(mid in body)) body[mid]="" }
        else {
          ftype="t"; ntruthfile++; tfile=FILENAME; fn=pp[n]; sub(/\.md$/,"",fn); tid=fn
          tidfield=""; tsrc=""; ttags=""; tstatus=""; tconflict=""; tresolution=""; tprov=""
          hasid=0; hasclaim=0; hassource=0; hastags=0; hasstatus=0; gotline=0; hasderivedfrom=0
          tsuperseded=""; tderivedfrom=""; tcorrob=""
        }
        next
      }
      infm && $0 ~ /^---[[:space:]]*$/ { infm=0; if(ftype=="t") tf_done(); else mfmok[mid]=1; next }
      infm {
        # Count every frontmatter key, both file kinds. A key written twice is read three ways —
        # fm() takes the first, this awk and reindex the last, census counts both — so the field
        # yields three answers and nothing says a word.
        # A list value whose bracket never closes reads as empty or as the rest of the line depending
        # on the reader, and retag cannot rewrite it. Named here so the user has a repair path.
        if($0 ~ /^[a-z_]+[[:space:]]*:[[:space:]]*\[/ && $0 !~ /\]/)
          prob("[FM-DUPLICATE-KEY] " FILENAME "  frontmatter " q(substr($0,1,index($0,":")-1)) " opens a list with '[' that never closes on this line — readers disagree about where the value ends, and 'retag' cannot rewrite it. Close the bracket")
        if($0 ~ /^[a-z_]+[[:space:]]*:/){ kk=$0; sub(/[[:space:]]*:.*$/,"",kk); kcount[FILENAME,kk]++; kval[FILENAME,kk]=val() }
        # Every field pattern below is `^key[[:space:]]*:` — the SAME shape the key census one line
        # up uses, and the same shape fm() uses. They used to read `^key:[[:space:]]`, which demands
        # no space BEFORE the colon and one AFTER it, so two spellings YAML calls legal (`source :
        # m001`, `source:m001`) matched the census and fm() while missing every reader here. On
        # `source` that was silent and total: the seal is guarded by `tsrc!=""`, so it ran zero
        # times, a fabricated body went in as `status: ok`, and the verdict was a tick — while
        # `fm`/`impact` read the same file as `m001` and reindex wrote `[]` into index.md. The other
        # keys failed loudly (an unread `status` reads as an invalid empty enum), which is why only
        # this one hid. One spelling rule for one concept, in all five readers of this file.
        if(ftype=="t"){
          if($0 ~ /^id[[:space:]]*:/)                 { tidfield=val(); hasid=1 }
          else if($0 ~ /^claim[[:space:]]*:/)         { hasclaim=1 }
          # A source spelled leniently (`m5` for folder `m005`) resolves to the folder it names.
          # FORMATS pins the FOLDER spelling and promises references stay lenient; this was the one
          # reference judged by raw string against folder names, so the documented migration
          # (canonicalise the folders, leave references alone) failed every truth in the mine —
          # and while it failed, the seal did not run.
          else if($0 ~ /^source[[:space:]]*:/)        { tsrc=val(); hassource=1
            if(tsrc!="" && !(tsrc in mat)){ _sn=tsrc; sub(/^m0*/,"m",_sn); if(_sn in matn) tsrc=matn[_sn] } }
          else if($0 ~ /^tags[[:space:]]*:/)          { ttags=val(); hastags=1 }
          else if($0 ~ /^status[[:space:]]*:/)        { tstatus=val(); hasstatus=1 }
          else if($0 ~ /^conflict_with[[:space:]]*:/) { tconflict=val() }
          else if($0 ~ /^resolution[[:space:]]*:/)    { tresolution=val() }
          else if($0 ~ /^provenance[[:space:]]*:/)    { tprov=val() }
          else if($0 ~ /^derived_from[[:space:]]*:/)  { hasderivedfrom=1; tderivedfrom=val() }
          else if($0 ~ /^superseded[[:space:]]*:/)    { tsuperseded=val() }
          else if($0 ~ /^corroborated_by[[:space:]]*:/) { tcorrob=val() }
        }
        next
      }
      ftype=="m" { body[mid]=body[mid] $0 "\n"; next }
      # The body as a BLOCK, blank lines and all, from its first non-blank line on. The seal below is
      # per line, and per line is not enough: two lines that are each verbatim but sit far apart in
      # the source are rendered by markdown as one soft-wrapped sentence the source never contained.
      # No ill will is needed for this — the ordinary version is a quote that drops the qualifying
      # middle line.
      ftype=="t" { if(bstarted[tid] || $0 ~ /[^[:space:]]/){ bstarted[tid]=1; bblk[tid]=bblk[tid] $0 "\n" } }
      # EVERY body line, not just the first — FORMATS encourages multi-line full-text artifacts
      # (lyrics, clauses, code), so sealing only line 1 left the rest free. No length gate either:
      # awk length() counts characters under UTF-8 and bytes under C, so one mine got two verdicts.
      # Replaced by a TOKEN count (runs of non-space, locale-invariant), judged over the whole body
      # in END — a verbatim table quote legitimately contains a one-token line like |---|---|.
      ftype=="t" && $0 ~ /[^[:space:]]/ {
        nbody[tid]++
        _bl=$0; gsub(/^[[:space:]]+|[[:space:]]+$/,"",_bl)
        ntok[tid]+=split(_bl,_bw,/[[:space:]]+/)
        if(!(tid in bfirst)) bfirst[tid]=_bl
        # `tsrc in mfmok` — the source material actually PARSED. An unclosed converted.md yields empty
        # body[], which would flag every truth from it as a broken seal when the material was just
        # unread; these fall to NOT checked instead.
        if(tsrc!="" && (tsrc in body) && (tsrc in mfmok)){
          sealsrc[tid]=tsrc; sealfile[tid]=tfile; sealstat[tid]=tstatus
          if(index(body[tsrc],$0)==0){
            sealbroken[tid]=1
            if(tstatus!="retracted" && !(tid in unsealed)){
              unsealed[tid]=1
              prob("[SEAL-QUOTE-MISSING] " tfile "  quote not found in " mroot "/" tsrc "/converted.md (laundering risk)")
            }
          } else stillthere[tid]=1
        }
      }
      END {
        for(i=1;i<=nreq;i++) if(rt[i]!="" && !(rt[i] in seentag)) prob("[REQTAG-EMPTY] required_tag " q(rt[i]) " has no live truths — retracted and discarded truths do not cover a topic (a tombstone is an extraction that never had standing); extract it from a material, queue the question (the ask loop turns the answer into a user-answer material), or remove the tag from project.md required_tags — removing it switches the completeness warranty off for that topic")
        for(kx in kcount) if(kcount[kx]>1){
          split(kx,kk2,SUBSEP)
          prob("[FM-DUPLICATE-KEY] " kk2[1] "  frontmatter key " q(kk2[2]) " appears " kcount[kx] " times → fm reads the FIRST, validate and reindex read the LAST, and census counts BOTH, so three commands report three different values for the same field. Keep one")
        }
        # The tombstone withdrawal reason, judged after the WHOLE body is read (deciding on the first
        # matching line made the verdict depend on line order). One absent line supports "never had
        # standing"; the file fails only when EVERY line is still verbatim there.
        for(t in sealstat)
          if(sealstat[t]=="retracted" && (t in stillthere) && !(t in sealbroken))
            prob("[SEAL-RETRACTED] " sealfile[t] "  status " q("retracted") " but its quote IS still verbatim in " mroot "/" sealsrc[t] "/converted.md → the withdrawal reason (never had standing) is unsupported. If the fact is real and only " q("source") " was wrong, repoint it (map); if it lost a conflict, use " q("discarded") " with a resolution")
        # Retracting one side of an open conflict strands the other: it stays `conflict`, READ.md
        # tells consumers "use NEITHER side", and no resolution was recorded — the machinery bypassed.
        for(k in reflist){
          split(k, kp, "")
          if(!(reflist[k] in existsn))
            prob("[TRUTH-REF-DANGLING] truths/" kp[1] ".md  " kp[2] " references " q(kp[3]) " — no such truth or material. A dangling id here is silent: the checks that depend on it (retracted counterpart, reciprocity, derivation chain) simply never fire")
        }
        for(w4 in winnerof)
          if((w4 in retracted) || ((w4 in norm2raw) && (norm2raw[w4] in retracted)))
            prob("[WINNER-RETRACTED] truths/" w4 ".md  is retracted but is named the WINNER by" winnerof[w4] " → those losers point their successor at a tombstone, and a consumer following the protocol is told the fact is not in the mine. Re-open the conflict or make the surviving value a live truth")
        # Compare NORMALISED against NORMALISED, report the RAW file id — a mixed comparison fired the
        # once-per-pair guard both ways below 100 and named a nonexistent file. Built first in its own
        # pass: a normalised conflict index, so reciprocity reads a complete table, not a half-built one.
        for(x in cwof){ xz=x; sub(/^t0*/,"t",xz); if(xz=="t") xz=x; cwofn[xz]=cwof[x]; rawof[xz]=x }
        for(x in cwof){
          xn=x; sub(/^t0*/,"t",xn); if(xn=="t") xn=x
          nr2=split(cwof[x],cw2," ")
          for(i=1;i<=nr2;i++){
            if(cw2[i]=="") continue
            disp = (cw2[i] in norm2raw) ? norm2raw[cw2[i]] : cw2[i]
            # RECIPROCITY of an open conflict: one-sided `conflict_with` leaves `pull` handing the
            # silent side out as usable, since READ.md rule 2 cannot apply. Skipped when the other
            # side is a tombstone (the retracted-counterpart check above owns that).
            if(statusof[x]=="conflict" && !(cw2[i] in retracted) && (cw2[i] in existsn)){
              if(!(cw2[i] in cwofn) || index(" " cwofn[cw2[i]] " ", " " xn " ")==0)
                prob("[CONFLICT-RECIPROCITY] truths/" x ".md  names " disp " in conflict_with but " disp " does not name " x " back → a one-sided conflict cannot be applied by READ.md rule 2, so pull reports the silent side as usable. Fix BOTH files in one edit: set conflict_with on each naming the other, AND set both status " q("conflict") " — doing only the first produces the next error one step later")
              else if((cw2[i] in rawof) && statusof[rawof[cw2[i]]]!="conflict" && statusof[rawof[cw2[i]]]!="")
                prob("[CONFLICT-RECIPROCITY] truths/" disp ".md  is in an open conflict with " x " but its own status is " q(statusof[rawof[cw2[i]]]) " → both parties to an unresolved conflict must be " q("conflict") ", or the conflict must be resolved on both")
            }
            if((cw2[i] in retracted) && !(x in retracted) && statusof[x]=="conflict")
              prob("[CONFLICT-STALE] truths/" x ".md  is still " q("conflict") " against " disp ", which was retracted → the other side was withdrawn without resolving the conflict; re-open or resolve " x)
            # Retracting BOTH sides was the loophole: an open conflict vanished for two changelog
            # lines with no user ruling. The machine never disposes of a conflict on its own.
            else if((cw2[i] in retracted) && (x in retracted) && xn < cw2[i])
              prob("[CONFLICT-BOTH-RETRACTED] truths/" x ".md and " disp " were BOTH retracted while in open conflict → a conflict may not be disposed of by withdrawing both sides; the machine never resolves a conflict on its own. Record the user ruling (resolution / adjudication) or re-open one side")
          }
        }
        # Accounting, not a check: reporting sealed-vs-present makes the "silent zero" leaks (empty
        # source, no checkable body line, unclosed frontmatter — all a tick) visible. A body with no
        # non-blank line is unchecked, not clean. Tombstones are exempt (a retracted truth may be a stub).
        for(_bt in allstat)
          if(allstat[_bt]!="retracted" && nbody[_bt]+0==0)
            prob("[TRUTH-BODY-EMPTY] " allfile[_bt] "  body is empty — the verbatim quote is what the seal checks, so a truth with no body line is unchecked rather than checked-and-clean")
        # One token is not a quote: a substring that short is in almost any material, so the seal
        # passes on nothing while the count reads "sealed". KNOWN LIMIT: a two-token fragment still
        # gets through — the floor is the lowest that means anything, not a full guard.
        # Each line verbatim but the BLOCK not: two lines pulled from opposite ends of a source render
        # as one passage it never had. Only for truths whose every line already passed the per-line seal.
        for(_sp in sealsrc){
          if(allstat[_sp]=="retracted" || (_sp in sealbroken) || nbody[_sp]+0<2) continue
          _blk=wsnorm(bblk[_sp]); if(_blk=="") continue
          if(!(sealsrc[_sp] in bodyws)) bodyws[sealsrc[_sp]]=wsnorm(body[sealsrc[_sp]])
          if(index(bodyws[sealsrc[_sp]], _blk)==0)
            prob("[SEAL-SPLIT-BLOCK] " sealfile[_sp] "  every body line is verbatim in " mroot "/" sealsrc[_sp] "/converted.md but they are NOT adjacent in it — quoting lines that sit apart splices them into one passage the source never had (markdown renders the block as a single paragraph). Quote one continuous passage, or split this into one truth per passage")
        }
        for(_fr in allstat)
          if(allstat[_fr]!="retracted" && nbody[_fr]+0>0 && ntok[_fr]+0<2)
            prob("[TRUTH-BODY-FRAGMENT] " allfile[_fr] "  body is a single fragment (" q(bfirst[_fr]) ") — the seal is a substring test, and a fragment that short is in almost any material, so finding it verbatim proves nothing about the claim. Quote the whole line (or table row) the fact sits in")
        # `sealed` must mean the seal PASSED, not that it ran (sealsrc is set before index() decides),
        # or a quote confirmed ABSENT counts as sealed — and the confirmation screen reads this number
        # as "N/N verbatim confirmed". Four outcomes: passed · FAILED · tombstone · never checked.
        # Tombstones are exempt: a retracted quote is MEANT to be absent, so it is neither pass nor fail.
        nsealed=0; nsealfail=0; ntomb=0
        for(_tb in allstat) if(allstat[_tb]=="retracted") ntomb++
        for(_st in sealsrc){
          if(allstat[_st]=="retracted") continue
          if(_st in sealbroken) nsealfail++; else nsealed++
        }
        print "QCOUNTS " ntruthfile+0 " " nsealed " " nsealfail+0 " " ntomb+0
        print "QFAILS " probs+0
      }
    ' "${qfiles[@]}")

    qn=$(printf '%s\n' "$qout" | tail -1); qn=${qn#QFAILS }
    local qc; qc=$(printf '%s\n' "$qout" | grep '^QCOUNTS ' | tail -1)
    if [ -n "$qc" ]; then set -- $qc; N_TRUTH=${2:-0}; N_SEALED=${3:-0}; N_SEALFAIL=${4:-0}; N_TOMB=${5:-0}; fi
    # The FILE count comes from disk, not the awk: awk skips a zero-byte file entirely, so it would
    # vanish from the denominator instead of showing up as unchecked. Same expression census uses,
    # so the two commands cannot disagree about how many truth files exist.
    N_TRUTH=$(ls "$TRUTHS"/t[0-9]*.md 2>/dev/null | grep -c . || true); N_TRUTH=${N_TRUTH:-0}
    if [ "${qn:-0}" -gt 0 ]; then
      # Routed through prob so JSON mode collects them and codes ride the [CODE] prefix.
      emit_probs < <(printf '%s\n' "$qout" | grep -v '^QCOUNTS ' | sed '$d' | sed 's/^  //')
    fi

    # A truth file whose line 1 is not '---' is invisible to every check above (the parser never
    # opens), and can never gain an index entry — which made validate loop "run reindex" forever.
    # An UNCLOSED frontmatter is the same leak: tf_done() fires on the CLOSING '---', so without one
    # every check runs zero times. Both are named here rather than blamed on the index.
    # ONE awk answers "canonical name? frontmatter closed?" for every truth file (v0.3.4 fold):
    # this loop used to spawn basename + canon_id + a per-file awk for each truth — three
    # processes × 268 truths was the single largest block of validate's wall time on a real mine.
    local tf nofm="" tb tc tfstate_
    local -a tffiles_=()
    for tf in "$TRUTHS"/t[0-9]*.md; do [ -f "$tf" ] && tffiles_+=("$tf"); done
    if [ "${#tffiles_[@]}" -gt 0 ]; then
      while IFS=$'\t' read -r tb tfstate_; do
        [ -n "$tb" ] || continue
        # Canonical filename, same rule as material folders: without it `t5.md` and `t005.md` sit
        # side by side and every id-keyed table above collapses them into one entry.
        canon_id "$tb" >/dev/null || true; tc=$REPLY
        [ -n "$tc" ] && [ "$tb" != "$tc" ] &&
          prob TRUTH-ID-NONCANON "$TRUTHS/$tb.md  filename is not the canonical id spelling — rename it to '$tc.md' and set 'id: $tc' (ids are zero-padded to at least three digits). Two spellings of one number resolve to the same id, so the reciprocity, winner and retracted tables would collapse both files into one entry"
        case "$tfstate_" in
          closed) ;;
          unclosed)
            nofm="$nofm $tb"
            prob TRUTH-FM-UNCLOSED "$TRUTHS/$tb.md  frontmatter is never closed (a second '---' is missing) — the parser stays inside it to EOF, so every check on this file runs zero times and its body is never sealed" ;;
          *)
            nofm="$nofm $tb"
            prob TRUTH-NO-FM "$TRUTHS/$tb.md  no frontmatter (line 1 must be '---') — this file is not read as a truth at all, so every check on it silently passes and no index entry can ever be generated for it" ;;
        esac
      done < <(awk '
        function emit(  n, p, b) { if (fn == "") return
          n = split(fn, p, /[\/\\]/); b = p[n]; sub(/\.md$/, "", b)
          print b "\t" (closed ? "closed" : (opened ? "unclosed" : "nofm")) }
        FNR==1 { emit(); fn=FILENAME; opened=($0 ~ /^---[[:space:]]*$/); closed=0; infm=opened; next }
        infm && /^---[[:space:]]*$/ { closed=1; infm=0 }
        END { emit() }' "${tffiles_[@]}")
    fi
  fi

  # --- the verification sidecar is fail-closed (v0.3.1): every row fully parsed, verdict from
  # --- the closed enum. A typo'd 'verifed' once fell through the classifier into a digest
  # --- compare and counted as digest-bound verified — the exact substring-trap class the
  # --- markdown ledger already guards against, missed one door over.
  local lfv_ lline_ lid_ ldg_ lvd_ lrd_ lst_ ldt_ lex_
  lfv_="$TRUTHS/$(ledger_file)"
  if [ -f "$lfv_" ]; then
    while IFS= read -r lline_; do
      case "$lline_" in ''|'#'*) continue ;; esac
      IFS=$'\t' read -r lid_ ldg_ lvd_ lrd_ lst_ ldt_ lex_ <<< "$lline_"
      if [ -z "${lvd_:-}" ]; then
        prob LEDGER-MALFORMED "truths/$(ledger_file)  row has fewer than three tab-separated columns: '$lline_' — id·sha256·verdict is the minimum; an unparseable row covers nothing and blocks"
        continue
      fi
      canon_id "$lid_" >/dev/null 2>&1 || prob LEDGER-MALFORMED "truths/$(ledger_file)  row id '$lid_' is not a material/truth id"
      case "$lvd_" in verified|failed|legacy-unbound) ;; *)
        prob LEDGER-VERDICT "truths/$(ledger_file)  row for '$lid_' carries unknown verdict '$lvd_' — the enum is verified|failed|legacy-unbound and an unknown word must never count as any of them" ;;
      esac
      # The row FORMAT is fail-closed too (v0.3.2): attest writes exactly six columns, so any
      # deviation is a hand edit — and a garbage digest or date wears the shape of evidence
      # while binding nothing.
      if [ -z "${ldt_:-}" ]; then
        prob LEDGER-MALFORMED "truths/$(ledger_file)  row for '$lid_' has fewer than six tab-separated columns — id·sha256·verdict·round·standard·date; attest writes all six"
        continue
      fi
      [ -n "${lex_:-}" ] && prob LEDGER-MALFORMED "truths/$(ledger_file)  row for '$lid_' has more than six tab-separated columns"
      case "$ldg_" in
        -) ;;
        *) [[ "$ldg_" =~ ^[0-9a-f]{64}$ ]] \
             || prob LEDGER-MALFORMED "truths/$(ledger_file)  row for '$lid_' digest column '$ldg_' is neither a 64-hex sha256 nor '-'" ;;
      esac
      case "$lrd_" in
        -) ;;
        ''|*[!0-9]*) prob LEDGER-MALFORMED "truths/$(ledger_file)  row for '$lid_' round column '$lrd_' must be a positive integer or '-'" ;;
      esac
      [ -n "${lst_:-}" ] || prob LEDGER-MALFORMED "truths/$(ledger_file)  row for '$lid_' standard column is empty — attest records the standard met; migration records the origin token"
      is_date "$ldt_" || prob LEDGER-MALFORMED "truths/$(ledger_file)  row for '$lid_' date column '$ldt_' is not a date (YYYY-MM-DD, zero-padded, real month and day)"
    done < "$lfv_"
  fi

  # --- ledgers ABOUT the truths, checked whether or not any truth file exists ---
  # Moved OUT of the truth-file guard: deleting the last truth file must not switch these off while
  # index.md and coverage.md still name the deleted truth. "No truths" is the strongest thing they
  # have to say. The big awk stays guarded (nothing to seal); only these ledger cross-checks moved.
  if [ -d "$TRUTHS" ]; then
    # With zero truth files a declared required_tag is unmet by definition. The awk's own version
    # of this check lives in its END block and cannot run when the awk does not.
    if ! ls "$TRUTHS"/t[0-9]*.md >/dev/null 2>&1; then
      while IFS= read -r rq; do
        [ -n "$rq" ] && prob REQTAG-EMPTY "required_tag '$rq' has no live truths — the mine holds no truth files at all; extract it from a material, queue the question (the ask loop turns the answer into a user-answer material), or remove the tag from project.md required_tags — removing it switches the completeness warranty off for that topic"
      done <<EOF
$reqtags
EOF
    fi
    # generated index files must exist if truths exist — and index must be in sync (ids both ways)
    [ -f "$TRUTHS/index.md" ] || prob IDX-MISSING "truths/index.md missing (run 'weavedoc reindex')"
    [ -f "$TRUTHS/tree.md" ]  || prob IDX-MISSING "truths/tree.md missing (run 'weavedoc reindex')"
    if [ -f "$TRUTHS/index.md" ]; then
      # Set difference in bash maps (v0.3.4): the ls|sed + grep|sed + comm×2 pipeline was ~10
      # spawns; the file population reuses the array the frontmatter batch already collected.
      # Emission stays LC_ALL=C sorted so the problem list is byte-stable across the refactor.
      local -A fseen_=() idxseen_=()
      local sid iline_
      for tf in "${tffiles_[@]}"; do sid=${tf##*/}; sid=${sid%.md}; fseen_[$sid]=1; done
      while IFS= read -r iline_; do
        case "$iline_" in '- t'*) sid=${iline_#- }; sid=${sid%%[!t0-9]*}
          case "$sid" in t[0-9]*) idxseen_[$sid]=1 ;; esac ;; esac
      done < "$TRUTHS/index.md"
      for sid in $(printf '%s\n' "${!fseen_[@]}" | LC_ALL=C sort); do
        [ -n "${idxseen_[$sid]+x}" ] && continue
        # Not an index problem when the file has no frontmatter — reindex cannot fix that, and telling
        # the user to run it again is the loop itself.
        case " $nofm " in *" $sid "*) continue ;; esac
        prob IDX-SYNC "truths/index.md  no entry for $sid (run 'weavedoc reindex')"
      done
      for sid in $(printf '%s\n' "${!idxseen_[@]}" | LC_ALL=C sort); do
        [ -n "${fseen_[$sid]+x}" ] || prob IDX-SYNC "truths/index.md  entry '$sid' has no truth file (run 'weavedoc reindex')"
      done
    fi

    # --- coverage manifest (soft: only materials WITH a '## m<id>' section are cross-checked) ---
    # truths/coverage.md is map-written (element → truth ids, skips with reasons — T2's audit surface).
    # Floor: every section resolves to a material, every mentioned id exists, every truth from a
    # *sectioned* material appears in it. Materials with no section are legal (legacy).
    if [ -f "$TRUTHS/coverage.md" ]; then
      local tsrcpairs="" cout cn
      # The glob is handed to awk only when it matches: an unexpanded pattern reached awk as a literal
      # filename and died mid-run — the exact state this cross-check must survive.
      if ls "$TRUTHS"/t[0-9]*.md >/dev/null 2>&1; then
      tsrcpairs=$(awk '
        FNR==1 { n=split(FILENAME,pp,"/"); fn=pp[n]; sub(/\.md$/,"",fn); tid=fn; infm=($0 ~ /^---[[:space:]]*$/); next }
        infm && /^---[[:space:]]*$/ { infm=0; nextfile }
        infm && /^source[[:space:]]*:/ { s=$0; sub(/^source[[:space:]]*:[[:space:]]*/,"",s); if(s !~ /^"/) sub(/[[:space:]]+#.*$/,"",s); sub(/[[:space:]]*$/,"",s); sub(/^"/,"",s); sub(/"$/,"",s);  printf "%s:%s ", tid, s; nextfile }
      ' "$TRUTHS"/t[0-9]*.md)
      fi
      cout=$(awk -v matids="$matlist" -v pairs="$tsrcpairs" -v Q="'" '
        function q(s){ return Q s Q }
        function prob(m){ print "  " m; probs++ }
        # References stay lenient (FORMATS pins the FOLDER spelling only), so every id used as a KEY is
        # normalised: `source: m5`, `## m005` and `t1` must land on the same entry as their canonical forms.
        function norm(s){ sub(/^m0*/,"m",s); sub(/^t0*/,"t",s); return (s=="m"||s=="t") ? "" : s }
        BEGIN {
          nm=split(matids,a," "); for(i=1;i<=nm;i++) if(a[i]!=""){ mat[a[i]]=1; if(norm(a[i])!="") mat[norm(a[i])]=1 }
          np=split(pairs,b," ")
          for(i=1;i<=np;i++){ if(b[i]=="") continue; split(b[i],c,":"); tsrc[c[1]]=c[2]; if(norm(c[1])!="") tid2file[norm(c[1])]=c[1] }
          sec=""
        }
        /^##[ 	]+m[0-9]+([[:space:]]|$)/ {
          sec=$2
          if(!(sec in mat)) prob("[COVERAGE-SECTION] truths/coverage.md  " q("## " sec) " → no material folder")
          hassec[norm(sec)]=sec; next
        }
        /^##[ 	]+legacy[[:space:]]*$/ { sec=""; inleg=1; next }
        /^##[ 	]/ { sec=""; inleg=0; next }
        # `## legacy` holds user rulings in free prose, not mappings. Ids named in a ruling are talked
        # about (often withdrawn ones), so the existence check there would fail validate for a deletion.
        inleg {
          if(match($0,/^[[:space:]]*-[[:space:]]*(m[0-9]+)/)){
            lid=substr($0,RSTART,RLENGTH); sub(/^[[:space:]]*-[[:space:]]*/,"",lid)
            legseen[lid]=1
            # An exemption is a USER ruling, and one line of machine-written prose was enough to
            # shrink the coverage denominator AND trip the T2 legacy escape — one unattributed line
            # switching off a metric and a cold lens at once. questions.md already demands a
            # quotable utterance for `answered`; this is the same bar.
            # Shape AND value, and the same shape is_date() demands elsewhere. This was the only place
            # in the tool that looked at a date at all, and it looked at the shape only: 2026-99-99
            # counted as a recorded ruling while 2026-7-3 was reported as having no date.
            rdok=0
            if(match($0, /ruled:[[:space:]]*[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/)){
              rd=substr($0,RSTART,RLENGTH); sub(/ruled:[[:space:]]*/,"",rd)
              split(rd,_rp,"-")
              if(_rp[2]+0>=1 && _rp[2]+0<=12 && _rp[3]+0>=1 && _rp[3]+0<=31) rdok=1
            }
            if(!rdok || $0 !~ /"[^"]+"/)
              prob("[COVERAGE-LEGACY] truths/coverage.md  " q("## legacy") " exempts " q(lid) " without a recorded ruling → add ruled: YYYY-MM-DD plus the quoted user utterance on the same line; the machine does not exempt itself")
          }
          next
        }
        {
          line=$0
          while(match(line,/t[0-9]+/)){
            id=substr(line,RSTART,RLENGTH); line=substr(line,RSTART+RLENGTH)
            if(!(id in tsrc) && !(norm(id) in tid2file)) prob("[COVERAGE-DANGLING] truths/coverage.md  mentions " q(id) " — no such truth file")
            else if(sec!="") mention[norm(sec) "," (norm(id)!="" ? norm(id) : id)]=1
          }
        }
        END {
          # Checked here, not inline: `## legacy` may sit above the `## m<id>` sections, and
          # hassec[] is only complete once the whole file has been read.
          for(l in legseen){
            if(!(l in mat)) prob("[COVERAGE-LEGACY] truths/coverage.md  " q("## legacy") " exempts " q(l) " — no such material")
            else if(norm(l) in hassec) prob("[COVERAGE-LEGACY] truths/coverage.md  " q("## legacy") " exempts " q(l) " but it has its own " q("## " hassec[norm(l)]) " section — it is covered, not exempt (that drops the denominator while the numerator stays, which can push the ratio above 1)")
          }
          for(t in tsrc){ s=norm(tsrc[t])
            if((s in hassec) && !((s "," norm(t)) in mention))
              prob("[COVERAGE-SECTION] truths/coverage.md  " q("## " hassec[s]) " missing " q(t) " — extracted from " tsrc[t] " but absent from its coverage section (update at map)")
          }
          print "CFAILS " probs+0
        }
      ' <(nocomment < "$TRUTHS/coverage.md"))
      cn=$(printf '%s\n' "$cout" | tail -1); cn=${cn#CFAILS }
      if [ "${cn:-0}" -gt 0 ]; then
        emit_probs < <(printf '%s\n' "$cout" | sed '$d' | sed 's/^  //')
      fi
    fi
  fi

  # --- each document ---
  while IFS= read -r d; do
    p="$DOCUMENTS/$d/plan.md"
    if [ -f "$p" ]; then
      pipes "${SCH[plan.fm.required]}" >/dev/null
      for k in $REPLY; do
        req_value "$p" "$k" || true
      done
      fmv "$p" status; v=$REPLY
      in_list "$v" "${SCH[plan.fm.enum.status]}" || prob PLAN-ENUM "$p  status '$v' invalid"
      fmv "$p" doc_id; v=$REPLY
      [ "$v" = "$d" ] || prob PLAN-DOCID "$p  doc_id '$v' != folder '$d'"
      fmv "$p" continues; listfield "$REPLY" >/dev/null
      for c in $REPLY; do
        [ -d "$DOCUMENTS/$c" ] || prob PLAN-CONTINUES-DANGLING "$p  continues '$c' → no such document"
      done
      # cited_truths is the lookup key for Trigger A propagation: when a truth changes, this list is
      # what says which documents must go stale. A dangling id there is silent in the worst way —
      # the document is simply never matched, so it stays green forever while its ground moved.
      fmv "$p" cited_truths; listfield "$REPLY" >/dev/null
      for c in $REPLY; do
        case "$c" in t[0-9]*) tfile_for "$c" >/dev/null || prob PLAN-CITED-DANGLING "$p  cited_truths '$c' → no such truth. Trigger A matches documents by this list, so a dangling id exempts this document from staleness detection" ;;
          *) prob PLAN-CITED-NOT-ID "$p  cited_truths '$c' is not a truth id (expected tNNN)" ;; esac
      done
      # audience: external requires publication labels (WD-CFG-001) — an external document ships
      # with its labels or not at all.
      fmv "$p" audience; v=$REPLY
      if [ -n "$v" ]; then
        in_list "$v" "${SCH[plan.fm.enum.audience]}" || prob PLAN-AUDIENCE "$p  audience '$v' invalid → ${SCH[plan.fm.enum.audience]}"
        if [ "$v" = "external" ]; then
          fmv "$p" publication_labels
          { [ -n "$REPLY" ] && ! is_placeholder "$REPLY"; } \
            || prob PLAN-LABELS "$p  audience 'external' but publication_labels is missing or an untouched placeholder — an external document ships with its labels or not at all"
        fi
      fi
    else
      prob PLAN-MISSING "$DOCUMENTS/$d/  no plan.md"
    fi
    # Three ways to BLIND the gate's reader, checked here because this decides whether a doc may ship:
    #   1. a second copy of the heading — only the FIRST section is read;
    #   2. an unterminated `<!--` — nocomment blanks it to EOF, deleting every violation below;
    #   3. a prose `-->` (`초안 2장 --> 3장`) closing a forgotten `<!--` — the file still ends outside a
    #      comment, so the balance check (2) stays silent while the section between them vanished.
    if [ -f "$DOCUMENTS/$d/review.md" ]; then
      # Counted at ANY heading level. The spec never fixed the level for this section, so a copy
      # one level down is a second copy just the same, and only the first is ever read.
      dup_section "$DOCUMENTS/$d/review.md" "Fidelity violations" 0 >/dev/null
      [ "$REPLY" -gt 1 ] &&
        prob REVIEW-DUP-HEADING "$d review.md has more than one 'Fidelity violations' heading (at any level) — only the first is read, so violations under the others would ship unseen. Merge them"
      comment_balanced "$DOCUMENTS/$d/review.md" ||
        prob REVIEW-UNTERMINATED-COMMENT "$d review.md ends inside an unterminated '<!--' — everything after it is blanked out before any check reads it, so open violations below would ship unseen. Close the comment"
      # Archiving a closed round in a comment stays legal, so the test is whether a section the file
      # ITSELF declares survives the strip — present raw but gone afterwards = a lost section.
      while IFS= read -r r; do
        [ -n "$r" ] || continue
        dup_section "$DOCUMENTS/$d/review.md" "$r" 0 raw >/dev/null
        [ "$REPLY" -gt 0 ] || continue
        dup_section "$DOCUMENTS/$d/review.md" "$r" 0 >/dev/null
        [ "$REPLY" -eq 0 ] &&
          prob REVIEW-LOST-SECTION "$d review.md has a '$r' heading that is gone once comments are stripped — a '-->' in ordinary prose closes an earlier '<!--', and everything between them (headings and open violations alike) is blanked before any check reads it. Close the comment where it was meant to end"
      done < <(pipes "${SCH[review.sections]}")
      # THE ZONE RULE (ruled 2026-08-01, replacing the shape census). A violation kind in brackets
      # may live in exactly one place — inside the 'Fidelity violations' section; anywhere else,
      # whatever the line looks like, it is named and blocked. The census died because recognising
      # "entry-shaped lines" outside the section chases markdown's unbounded surface forms (bullets,
      # blockquotes, NBSP, checkboxes each slipped it, three rounds running). This inverts the burden:
      # the DETECTION TARGET is the three kind tokens (schema-owned, finite), and shape stops mattering.
      # The boundary comes from fid_mark — the same walk fid_body reads — so inside/outside are
      # complements of one judge. Comparison is NORMALISED: each bracket interior is folded to
      # lowercase alphanumerics, so every spelling variant of the three tokens converges on one rule
      # (not a list — after folding the space IS the three tokens). VOCABULARY BOUNDARY, also ruled:
      # a bracketed word outside that vocabulary (`[모순]`) is prose wearing brackets; the machine does
      # not chase human wording, and inside the zone such lines still fail closed via is_noise.
      local vkinds vklist vkfold vline vslot vfold vhit vk vcnt vtag vrest kindscan
      # Three constants derived from one schema value — eleven forks' worth of pipes, recomputed
      # for every document. Pure parameter expansion now: same three shapes, no processes.
      vkinds=${SCH[review.enum.kind]}
      vklist=${vkinds//|/ }
      vkfold=""; for vk in $vklist; do vk=${vk,,}; vkfold+="${vk//[!a-z0-9]/} "; done
      kindscan='
        BEGIN{ n=split(kf, K, " ") }
        { line=$0; hit=0; s=line
          while ((i = index(s, "[")) > 0) {
            r = substr(s, i+1); j = index(r, "]")
            f = (j>0 ? substr(r,1,j-1) : r)
            f = tolower(f); gsub(/[^a-z0-9]/, "", f)
            for (k=1;k<=n;k++) if (K[k]!="" && index(f, K[k])>0) hit=1
            s = (j>0 ? substr(r, j+1) : "") }
          if (mode=="p") { if (hit) print line } else if (hit) found=1 }
        END{ if (mode!="p") exit found?0:1 }'
      if [ -n "$vkfold" ]; then
        while IFS= read -r vline; do
          vline=${vline#O$'\t'}
          prob REVIEW-KIND-OUTSIDE "$d review.md: a violation kind in brackets sits outside the 'Fidelity violations' section: '$vline' — the gate acts only inside that section, so however this line renders, the gate cannot act on it. An open violation belongs under the 'Fidelity violations' heading; a record or mention ABOUT a violation writes its kind without brackets (e.g. 'fixed: contradiction — …'); archived history belongs in an HTML comment with its closing '-->' on its own line"
        done < <(fid_mark "$DOCUMENTS/$d/review.md" | grep -E '^O' | LC_ALL=C awk -v kf="$vkfold" -v mode=p "$kindscan" || true)
        # A line that TRIED to be a violation entry but failed is told to fix itself, not binned as
        # prose. is_noise is still the sole judge of what an entry IS; this loop looks only at lines
        # it calls noise and asks whether the bracket slot holds a real kind. If so, two silent
        # failure shapes get named: (1) `#`-prefixed — is_noise drops it as a heading, but markdown
        # renders it as body, so the reader sees a numbered list the gate reads as empty; (2) a
        # NEAR-MISS kind (`- [<Contradiction>]`, two kinds in one slot) that the exact-enum match drops
        # into the template rule. Scoped INSIDE the zone (I lines) — outside, the zone rule owns it.
        # KNOWN LIMIT: a slot with no kind substring at all (`- [<contradicton>]`) still reads as a
        # template; this asks for evidence a kind was attempted, and a word-destroying typo leaves none.
        while IFS= read -r vline; do
          is_noise "$vline" || continue   # a real entry is the gate's jurisdiction, not this check's
          vslot=$(printf '%s' "$vline" | sed -E 's/^[^[]*\[([^]]*)\].*$/\1/; s/^[<{]//; s/[>}]$//; s/^[[:space:]]+//; s/[[:space:]]+$//')
          [ -n "$vslot" ] || continue
          vfold=$(printf '%s' "$vslot" | tr '[:upper:]' '[:lower:]')
          vhit=""
          for vk in $vklist; do case "$vfold" in *"$vk"*) vhit=1 ;; esac; done
          [ -n "$vhit" ] || continue
          case "$vline" in
            "#"*) prob REVIEW-KIND-SHAPE "$d review.md: '$vline' starts with '#', so the gate reads it as a heading and drops it — a numbered entry is invisible to the check even though markdown renders it as body text. Start the entry with '- ' instead" ;;
            # A `-->`-opened line lands here with an EXACT kind — the problem is the arrow, not the
            # kind: the gate reads it as a comment closer, so the entry after it is invisible.
            "-->"*) prob REVIEW-KIND-SHAPE "$d review.md: '$vline' starts with '-->', so the gate reads it as a comment closer and drops the whole line — the entry after the arrow is invisible however correct its kind is. Remove the stray arrow, or if it closes a real comment above, put it on its own line and start the entry on the next" ;;
            *) prob REVIEW-KIND-UNKNOWN "$d review.md: '[$vslot]' is not an exact violation kind — the gate acts only on an exact one of $vkinds (lowercase, no extra spaces, ONE kind per entry). Written like this the line reads as an untouched template and is silently ignored; fix the kind" ;;
          esac
        done < <(fid_mark "$DOCUMENTS/$d/review.md" | sed -n 's/^I	//p' | grep -F '[' || true)
        # A comment that swallows kind-bearing entries and is closed by a MID-LINE arrow is named.
        # The accident: someone opens `<!--`, forgets to close it, and a prose arrow (`초안 --> 검토`)
        # closes it — no heading swallowed (survival check silent), file ends outside a comment
        # (comment_balanced silent), and regular entries vanish. The tell is the CLOSER's shape: a
        # deliberate archive ends its line with `-->`, an accidental closer has prose after the arrow.
        # So the legal form is explicit — an archive holding entries puts its `-->` at end of line.
        # JURISDICTION (ruled 2026-07-31): bounded to swallowed content that BEARS A KIND — a comment
        # swallowing only prose stays silent (a lost memo breaks no warranty), and the same kind-in-
        # brackets regex feeds both this tripwire and the zone rule so they cannot drift.
        # KNOWN LIMIT: a prose line that happens to END with `-->` still swallows silently.
        vcnt=0
        while IFS= read -r vline; do
          vtag=${vline%%$'\t'*}; vrest=${vline#*$'\t'}
          case "$vtag" in
            I) case "$vrest" in *"["*)
                 printf '%s\n' "$vrest" | LC_ALL=C awk -v kf="$vkfold" -v mode=t "$kindscan" && vcnt=$((vcnt+1)) ;;
               esac ;;
            C) [ -n "$vrest" ] && [ "$vcnt" -gt 0 ] &&
                 prob REVIEW-COMMENT-SWALLOWS "$d review.md: a comment swallows $vcnt violation-shaped entr(ies) and its closing '-->' is followed by '$vrest' on the same line — if that arrow is prose that accidentally closed a forgotten '<!--', close the comment where it was meant to end; if the archive is deliberate, put the closing '-->' on its own line"
               vcnt=0 ;;
          esac
        done < <(awk '
          { line=$0
            while (1) {
              if (inc) {
                i=index(line,"-->")
                if (i==0) { print "I\t" line; line=""; break }
                # The closing line is interior UP TO its arrow, or an entry on the closer line itself
                # (`- [contradiction] … --> 산문`) is swallowed with vcnt still 0.
                if (i>1) print "I\t" substr(line,1,i-1)
                sfx=substr(line,i+3); gsub(/^[[:space:]]+|[[:space:]]+$/,"",sfx)
                print "C\t" sfx
                inc=0; line=substr(line,i+3); continue
              }
              i=index(line,"<!--"); if (i==0) break
              rest=substr(line,i+4); j=index(rest,"-->")
              if (j==0) { print "I\t" rest; inc=1; break }
              line=substr(line,1,i-1) substr(rest,j+3)
            }
          }' "$DOCUMENTS/$d/review.md")
      fi
    fi
    # gate-clean invariant: a consecrated output ⟹ review.md's 'Fidelity violations' is empty.
    # Three ways this was skipped rather than enforced, each of them a way to ship ungated:
    #   1. `final/` — FORMATS makes the multi-file directory a first-class output form, but the
    #      gate only ever looked for `final.md`, so multi-file documents were never gated at all.
    #   2. No review.md — the condition required BOTH files, so deleting the review file (or never
    #      writing one) turned the invariant off instead of failing it. Absence of the gate's own
    #      record is the strongest possible signal that the gate did not run.
    #   3. Heading level — read through fid_body, which takes either level, for the same reason
    #      hq_body does: the section is documented without a level and both are in use.
    N_DOC=$((N_DOC+1))
    local consecrated=""
    [ -f "$DOCUMENTS/$d/final.md" ] && consecrated="final.md"
    [ -d "$DOCUMENTS/$d/final" ]    && consecrated="final/"
    if [ -f "$DOCUMENTS/$d/final.md" ] && [ -d "$DOCUMENTS/$d/final" ]; then
      # Two finals, one digest check: whichever the resolver skipped could carry unreviewed
      # bytes. Ambiguity is not a shape the gate reads around — it blocks.
      prob GATE-DUAL-FINAL "$d has both final.md and final/ — only one can be the consecrated output and only one was digest-checked; remove the one that is not the reviewed artifact"
    fi
    # In-flight consecration artifacts are mine-level red flags (v0.3.2): the marker means the
    # final slot may hold an unvalidated candidate, the backup means the only original sits
    # aside. Traps cannot run on a hard kill — the on-disk artifact is the detector. The one
    # legal exemption is consecrate's own in-process validate for exactly this doc, passed as a
    # function argument (a variable channel was environment-injectable — v0.3.3).
    if [ "$consec_ok_" != "$d" ]; then
      [ -e "$DOCUMENTS/$d/.consecrate.inflight" ] && prob CONSEC-INTERRUPTED "$d has .consecrate.inflight — a consecration is running or died here (a hard kill leaves no other trace); if nothing is running, byte-compare final against the reviewed draft BEFORE deciding: identical → it is the staged candidate (safe to remove); different → it is your original (keep it; the crash came before the swap); absent with .final.bak present → restore the backup. Then delete the marker and re-run consecrate"
      [ -e "$DOCUMENTS/$d/.final.bak" ] && prob CONSEC-INTERRUPTED "$d has .final.bak — an interrupted consecration left the only original here; restore it over final (or remove it if the current final is known good), then re-run consecrate"
    fi
    if [ -n "$consecrated" ]; then
      N_CONSEC=$((N_CONSEC+1))
      if [ ! -f "$DOCUMENTS/$d/review.md" ]; then
        prob GATE-NO-REVIEW "$d has $consecrated but no review.md — the fidelity gate has no record of ever running on it. Run review before consecrating"
      elif dup_section "$DOCUMENTS/$d/review.md" "Fidelity violations" 0 >/dev/null; [ "$REPLY" -eq 0 ]; then
        #   4. A heading the reader cannot find. `fid_body` returns nothing both when the section is
        #      EMPTY (good) and when the title does not match — the gate read the second as the first.
        #      A suffix, trailing colon, numbering prefix, NBSP, or indent each did it. Absence of a
        #      readable heading is now the same failure as absence of the file: silence, not a pass.
        prob GATE-NO-HEADING "$d has $consecrated but no 'Fidelity violations' heading the gate can read in review.md — the section title must match exactly (any heading level, no suffix, no numbering, no trailing space). A title the reader cannot find is silence, not a pass"
      else
        N_GATED=$((N_GATED+1))
        # The FIRST counted entry is named in the message, or a line the writer did not think of as
        # an entry blocks the document with no thread back to the line that did it.
        while IFS= read -r line; do
          is_noise "$line" && continue
          prob GATE-OPEN "$d has $consecrated but review.md 'Fidelity violations' is non-empty → consecrated through an open gate. First entry the gate sees: '$line'. Repair each violation by its kind (refine), re-run review until the section is empty — or remove $consecrated until the gate is clean; a violation is never edited away in review.md itself"
          break
        done < <(fid_body "$DOCUMENTS/$d/review.md")
      fi
      # v2 review binding (WD-COR-002): a sealed review pins bytes + context. Presence of the
      # field activates enforcement; absence is legacy-unbound — counted, shown, never blocking
      # until schema v2 (migration train).
    fi
    # Hoisted out of the consecrated guard (v0.3.3): structural seal invariants hold for ANY
    # review — a draft-stage partial tuple or marker-next-to-seal is the same tamper shape one
    # consecration earlier. Byte/context ENFORCEMENT and the seal counts stay next to a
    # consecrated output, where the gate's verdict actually ships (a draft edited between
    # rounds under an old seal is the normal refine loop, not a violation).
    if [ -f "$DOCUMENTS/$d/review.md" ]; then
        # The seal is a TUPLE (v0.3.2): reviewed_kind + reviewed_digest + review_context_digest,
        # all or none. Any strict subset is a partial seal — each missing field disables exactly
        # one check while the others keep the green light credible — and reads as tampering on a
        # schema-2 mine. The migration marker is read HERE too: a marker NEXT TO a seal is a
        # parked demotion (seal-review removes the marker, so coexistence never occurs honestly).
        local rk_ rdg_ rcx_ mkr_ findg_
        fmv "$DOCUMENTS/$d/review.md" reviewed_kind;          rk_=$REPLY
        fmv "$DOCUMENTS/$d/review.md" reviewed_digest;        rdg_=${REPLY#sha256:}
        fmv "$DOCUMENTS/$d/review.md" review_context_digest;  rcx_=${REPLY#sha256:}
        fmv "$DOCUMENTS/$d/review.md" review_legacy;          mkr_=$REPLY
        if [ -n "$rdg_" ]; then
          if [ -n "$consecrated" ]; then
            N_RSEAL=$((N_RSEAL+1))
            findg_=$(artifact_digest "$(doc_final_path "$d")")
            [ "$findg_" = "$rdg_" ] || prob GATE-FINAL-DIGEST "$d $consecrated is not the bytes the clean review reviewed (reviewed_digest mismatch) — something changed after the seal; re-review, then re-consecrate. Nobody reviewed the bytes that are about to ship"
          fi
          if [ -z "$rcx_" ]; then
            [ "${SCHEMA_V1:-0}" = "1" ] || prob GATE-UNSEALED "$d review carries reviewed_digest but no review_context_digest — a partial seal on a schema-2 mine reads as tampering, not history; re-run seal-review after a clean round"
          elif [ -n "$consecrated" ] && [ "$(context_digest "$d")" != "$rcx_" ]; then
            prob GATE-CONTEXT-CHANGED "$d review context changed after the seal (a cited truth, its source material, config or schema moved) — the clean review no longer describes this mine; re-review"
          fi
          if [ -z "$rk_" ]; then
            [ "${SCHEMA_V1:-0}" = "1" ] || prob GATE-UNSEALED "$d review carries reviewed_digest but no reviewed_kind — the seal is a tuple (kind + digest + context, all or none) and a missing member reads as tampering on a schema-2 mine; re-run seal-review after a clean round"
          elif ! in_list "$rk_" "${SCH[review.enum.reviewed_kind]}"; then
            [ "${SCHEMA_V1:-0}" = "1" ] || prob GATE-UNSEALED "$d review reviewed_kind '$rk_' is not draft|final — a seal validate cannot interpret certifies nothing; re-run seal-review after a clean round"
          fi
          [ -n "$mkr_" ] && prob GATE-SEAL-MARKER "$d review carries BOTH a seal and the migration marker review_legacy — the marker means 'v1 history, digest-less by definition' and a sealed review is neither; seal-review removes the marker when a real round seals, so coexistence is a hand-added marker parked to demote this review to legacy once the seal is stripped. Remove review_legacy (the seal is the binding record)"
        elif [ -n "$rk_" ] || [ -n "$rcx_" ]; then
          # Seal fields WITHOUT the digest: the other half of the partial-tuple hole. On v1 the
          # dual-reader tolerance holds (counted legacy); on v2 stray members block — and the
          # marker does not rescue them, or a partial seal plus a marker would demote to legacy.
          if [ "${SCHEMA_V1:-0}" = "1" ]; then
            [ -n "$consecrated" ] && N_RLEGACY=$((N_RLEGACY+1))
          else
            prob GATE-UNSEALED "$d review carries seal field(s) without reviewed_digest — a partial seal on a schema-2 mine reads as tampering, not history; re-run seal-review after a clean round (the seal is a tuple: kind + digest + context, all or none)"
          fi
        elif [ -z "$consecrated" ]; then
          # No seal fields, no final: an unsealed draft-stage review is the normal mid-flow
          # state — nothing to count, nothing to block.
          :
        elif [ "${SCHEMA_V1:-0}" = "1" ] || [ -n "$mkr_" ]; then
          # Two legitimate digest-less states: a v1 mine (dual-reader), and a v2 mine whose
          # review carries the migration's audit marker (`review_legacy: <date>` — upgrade wrote
          # it, naming this review as v1 history). Tamper strips seals but leaves no marker.
          N_RLEGACY=$((N_RLEGACY+1))
        else
          # THE review-seal bypass (v0.3.1): on a v2 mine an unsealed review next to a final is
          # not legacy — v1 is the only legacy there is, and this mine declares version: 2. The
          # review skill seals after every round, so absence here is tamper or hand-writing.
          prob GATE-UNSEALED "$d $consecrated stands next to an UNSEALED review on a schema-2 mine — run seal-review after the clean round; deleting the seal fields must never reopen the gate (a genuine v1 mine reads as legacy-unbound instead)"
        fi
    fi
  done < <(doc_ids)

  # --- completeness warranty wiring (WD-COR-004) ---
  # `fidelity.completeness: required` turns the OPEN gap register into a gate input. The default
  # (off) keeps fill-or-accept non-blocking. required + a consecrated output + (no register at
  # all | open entries) = fail — a warranty nobody ran is not a warranty, same rule as the gate's
  # own record. Accepted entries are decisions and never block.
  cfg_load
  local gopen_ gacc_
  if [ "$N_CONSEC" -gt 0 ] && [ "${CFGFLAT[completeness]-}" = "required" ]; then
    if [ ! -f "$ROOT/gaps.md" ]; then
      prob COMP-NO-REGISTER "completeness is 'required' and a consecrated output exists, but there is no gaps.md — the completeness register never ran. Run the weavedoc-gaps skill (fill-or-accept) before consecrating, or set fidelity.completeness: off to drop the warranty"
    elif ! comment_balanced "$ROOT/gaps.md"; then
      # The same rule review.md has: an unclosed '<!--' blanks everything after it BEFORE any
      # reader sees a line, so gaps hidden behind it would vanish into a clean register.
      prob COMP-MALFORMED "completeness is 'required' but gaps.md ends inside an unterminated '<!--' — everything after it is invisible to the counter, so gaps behind it would read as zero; close the comment"
    elif dup_section "$ROOT/gaps.md" "Open" 0 >/dev/null; gopen_=$REPLY
         dup_section "$ROOT/gaps.md" "Accepted" 0 >/dev/null; gacc_=$REPLY
         [ "$gopen_" -eq 0 ]; then
      # A register with no readable Open section is a register that never ran, wearing a
      # filename — an empty or heading-less gaps.md must not read as "zero open gaps".
      prob COMP-MALFORMED "completeness is 'required' but gaps.md has no readable '# Open' section — the register format is '# Open' / '# Accepted' (weavedoc-gaps writes it); a file without them proves nothing and blocks like a missing one"
    elif [ "$gacc_" -eq 0 ]; then
      # Two sections, both required: a one-section file is not the register the gaps skill
      # writes, and fill-or-accept has nowhere legal to record an acceptance.
      prob COMP-MALFORMED "completeness is 'required' but gaps.md has no readable '# Accepted' section — the register format is '# Open' / '# Accepted' (weavedoc-gaps writes both); a one-section file blocks like a malformed register"
    elif [ "$gopen_" -gt 1 ] || [ "$gacc_" -gt 1 ]; then
      # A duplicated register section splits the ledger: a single-section counter reads only the
      # first copy, so entries under the second were invisible — an empty first Open next to a
      # populated second one read as "zero open gaps" (v0.3.2 finding).
      prob COMP-MALFORMED "completeness is 'required' but gaps.md repeats a register section heading — exactly one '# Open' and one '# Accepted'; entries under a duplicated section are invisible to a single-section reader, so the copy blocks like a missing register"
    else
      # STATE-BASED entry scan (v0.3.3): a continuation is legal only AFTER a bullet — an
      # indented line with no open entry above is prose the counter cannot see, not a
      # continuation of nothing. And the placeholder filter judges the REMAINDER (the same
      # ruling review entries follow): a real gap that kept placeholder brackets in its kind
      # slot is an ENTRY; only a line that is placeholders throughout stays template noise.
      local nopen_=0 badline_="" inb_=0 gl_ grest_ grem_ gnoise_
      while IFS= read -r gl_; do
        gl_=${gl_%$'\r'}
        case "$gl_" in
          *[!' '$'\t']*) ;;
          *) inb_=0; continue ;;
        esac
        grest_=${gl_#"${gl_%%[!' '$'\t']*}"}
        case "$grest_" in
          '- '*)
            inb_=1
            gnoise_=0
            case "$grest_" in
              '- [<'*|'- [{'*)
                grem_=${grest_#*]}
                grem_=$(printf '%s' "$grem_" | sed -E 's/\{[^{}]*\}//g; s/<[^<>]*>//g; s/[][(){}<>—:·,.-]+//g; s/[ \t]+//g')
                [ -z "$grem_" ] && gnoise_=1 ;;
            esac
            [ "$gnoise_" = 1 ] || nopen_=$((nopen_+1))
            ;;
          *)
            if [ "$grest_" = "$gl_" ] || [ "$inb_" != 1 ]; then badline_="$gl_"; break; fi
            ;;
        esac
      done < <(nocomment < "$ROOT/gaps.md" | section_all - "Open")
      if [ -n "$badline_" ]; then
        prob COMP-MALFORMED "completeness is 'required' but gaps.md '# Open' holds a line the register grammar cannot read: '$badline_' — entries are '- [<kind>] …' bullets; an indented line is a continuation ONLY under a bullet, and prose anywhere is a gap no counter sees, so it blocks like a malformed register"
      else
        [ "${nopen_:-0}" -gt 0 ] && prob COMP-OPEN-GAPS "completeness is 'required' but gaps.md holds ${nopen_} open gap(s) next to a consecrated output — fill each (question → user-answer material → map) or move it to Accepted with a reason; under 'required' an open gap is a violation, not a note"
      fi
    fi
  fi

  # --- truths/verify.md frontmatter + sections ---
  # verify.md is the one artifact a whole round of work rests on, so its frontmatter is checked here,
  # not left to prose: `status: pass` (not a valid value) reads as "verified" while no check agreed.
  # The SECTIONS are checked too (a repair — `verify.sections` was read only by the removed audit
  # lane, leaving it declared and enforced nowhere). `## Verified units` carries per-unit honesty;
  # without it a global `passed` silently covers units born after it. Either heading level, read
  # through `nocomment` (a section living only in a comment satisfies a raw grep but is unreadable).
  # ABSENCE is not blocked, unlike catalog.md: `verify` is on-demand, so a never-verified mine has
  # no verify.md legitimately. status reports the absence (§ cmd_status).
  if [ -f "$TRUTHS/verify.md" ]; then
    pipes "${SCH[verify.fm.required]}" >/dev/null
    for k in $REPLY; do
      fmv "$TRUTHS/verify.md" "$k"; v=$REPLY
      [ -n "$v" ] || { prob FM-MISSING "truths/verify.md  frontmatter '$k' missing"; continue; }
      case "$k" in verified_at) is_date "$v" || prob DATE-INVALID "truths/verify.md  verified_at '$v' is not a date (YYYY-MM-DD, zero-padded, real month and day) — a field the format calls a date and nobody reads as one is a field that can say anything" ;; esac
    done
    fmv "$TRUTHS/verify.md" status; v=$REPLY
    [ -z "$v" ] || in_list "$v" "${SCH[verify.fm.enum.status]}" || prob VERIFY-ENUM "truths/verify.md  status '$v' invalid → use ${SCH[verify.fm.enum.status]}"
    # Sections counted from the cached comment-stripped view (v0.3.4): the nocomment|grep pair
    # here was two spawns per required section. Same reader (count_headings), same levels (1|2).
    # Line-wise iteration, NOT `for k in $REPLY`: section names hold spaces ("Verified units"),
    # and word-splitting broke each into per-word ghost sections (v0.3.4 self-caught).
    local vbody_ vc1_ vc2_
    file_stripped "$TRUTHS/verify.md"; vbody_=$REPLY
    pipes "${SCH[verify.sections]}" >/dev/null
    while IFS= read -r k; do
      [ -n "$k" ] || continue
      count_headings "$vbody_" "$k" 1; vc1_=$REPLY
      count_headings "$vbody_" "$k" 2; vc2_=$REPLY
      [ $((vc1_ + vc2_)) -gt 0 ] ||
        prob VERIFY-SECTION "truths/verify.md  required section '$k' missing (verify.sections)"
    done <<< "$REPLY"
  fi

  # --- Human queue ownership tags (truths/verify.md AND documents/*/review.md) ---
  # Both verify.md and review.md carry a Human queue; checking only verify.md let a semantic
  # dismissal parked on the document side vanish from validate, status and audit alike.
  while IFS= read -r hqf; do check_hq_tags "$hqf"; done < <(hq_files)

  # --- config enums ---
  v=${CFGFLAT[completeness]-}; [ -z "$v" ] || in_list "$v" "${SCH[config.enum.completeness]}" || prob CFG-ENUM "config fidelity.completeness '$v' invalid"
  v=${CFGFLAT[detection]-};    [ -z "$v" ] || in_list "$v" "${SCH[config.enum.detection]}" || prob CFG-ENUM "config conflicts.detection '$v' invalid"
  v=${CFGFLAT[attribution]-};  [ -z "$v" ] || in_list "$v" "${SCH[config.enum.attribution]}" || prob CFG-ENUM "config conflicts.attribution '$v' invalid"

  # --- schema version negotiation (WD-MIG-002) + full config contract (WD-CFG-001) ---
  # Direct cache reads (v0.3.4): every knob below was a $(cfg2 …) subshell — 14 of them, the
  # single hottest block left in validate's tail after the loop folds. CFG is loaded (cfg_load
  # ran at the top) and section walls are the array keys themselves.
  local pv cv sv sect ck
  sv=${SCH[schema.version]:-2}
  fmv "$PROJECT" version; pv=$REPLY; cv=${CFGFLAT[version]-}
  case "$pv" in
    ''|*[!0-9]*) prob VER-NOT-INT "project.md version '$pv' is not an integer — the schema version field is the negotiation handle" ;;
    *) [ "$pv" -gt "$sv" ] && prob VER-FUTURE "project.md declares schema version $pv, newer than this runtime supports (≤$sv) — upgrade the runtime bundle, never guess at a future format" ;;
  esac
  case "$cv" in ''|*[!0-9]*) prob VER-NOT-INT "config version '$cv' is not an integer" ;; esac
  if [ -n "$pv" ] && [ -n "$cv" ] && [ "$pv" != "$cv" ]; then
    prob VER-DISAGREE "project.md version ($pv) and config.yaml version ($cv) disagree — two records of one fact must agree; upgrade stamps both"
  fi
  # (flag already computed at the top of cmd_validate — see pv0/cv0)
  for sect in verify review; do
    v=${CFG[$sect.strength]-}
    [ -z "$v" ] || in_list "$v" "${SCH[config.strength.range]}" \
      || prob CFG-RANGE "config $sect.strength '$v' invalid → one of ${SCH[config.strength.range]}"
    v=${CFG[$sect.max_rounds]-}
    case "$v" in "") ;; 0|*[!0-9]*) prob CFG-RANGE "config $sect.max_rounds '$v' must be a positive integer — 'exceeded → escalate' needs a ceiling that can be exceeded" ;; esac
    v=${CFG[$sect.scale]-}
    [ -z "$v" ] || in_list "$v" "${SCH[config.enum.scale]}" \
      || prob CFG-ENUM "config $sect.scale '$v' invalid → ${SCH[config.enum.scale]}"
    pipes "${SCH[config.repeat.scales]}" >/dev/null
    for ck in $REPLY; do
      v=${CFG[$sect.$ck]-}
      case "$v" in "") ;; *[!0-9]*) prob CFG-RANGE "config $sect.repeat.$ck '$v' must be a non-negative integer (clean rounds in a row)" ;; esac
    done
  done
  # Unknown top-level keys: a NAMED warning, never a failure — extension vs typo is not
  # machine-decidable, but silence would let a typo'd knob read as configured.
  while IFS= read -r ck; do
    in_list "$ck" "${SCH[config.toplevel]}" \
      || warn CFG-UNKNOWN-KEY "unknown config key '$ck' in .weavedoc/config.yaml — known top-level keys: ${SCH[config.toplevel]}"
  done < <(awk '/^[A-Za-z_][A-Za-z0-9_]*:/ { s=$0; sub(/:.*/, "", s); print s }' "$CONFIG" 2>/dev/null)

  # Printed on both outcomes and before the verdict, so the verdict is never read without it.
  local sealpart gatenote="" N_UNCHK
  # The "NOT checked" marker fires on never-checked only, not on anything short of the file count —
  # a legitimate tombstone stub must not raise it on a clean mine.
  N_UNCHK=$(( N_TRUTH - N_TOMB - N_SEALED - N_SEALFAIL )); [ "$N_UNCHK" -lt 0 ] && N_UNCHK=0
  sealpart="$N_SEALED sealed"
  [ "$N_SEALFAIL" -gt 0 ] && sealpart="$sealpart · $N_SEALFAIL seal FAILED"
  [ "$N_TOMB" -gt 0 ]     && sealpart="$sealpart · $N_TOMB tombstone"
  [ "$N_UNCHK" -gt 0 ]    && sealpart="$sealpart ← $N_UNCHK NOT checked"
  [ "$N_GATED" -lt "$N_CONSEC" ] && gatenote=" ← $((N_CONSEC - N_GATED)) NOT gate-checked"
  if [ "$WD_JSON" = 1 ]; then
    # The machine contract (WD-CLI-002): stdout carries ONLY the JSON object; codes are the
    # stable surface, messages are presentation; exit code semantics unchanged (0 pass · 1 fail).
    local jresult="pass"; [ "$PROBLEMS" -gt 0 ] && jresult="fail"
    printf '{"output_schema_version":1,"command":"validate","bundle":"%s","schema_version":%s,"result":"%s","problems":%s,' \
      "$(json_esc "$(cat "$ROOT/.weavedoc/VERSION" 2>/dev/null)")" "$(schema_ver)" "$jresult" "$PROBLEMS"
    printf '"examined":{"materials":%s,"truths":%s,"sealed":%s,"seal_failed":%s,"tombstones":%s,"not_checked":%s,"documents":%s,"consecrated":%s,"gate_checked":%s,"review_seals_bound":%s,"review_seals_legacy":%s},' \
      "$N_MAT" "$N_TRUTH" "$N_SEALED" "$N_SEALFAIL" "$N_TOMB" "$N_UNCHK" "$N_DOC" "$N_CONSEC" "$N_GATED" "$N_RSEAL" "$N_RLEGACY"
    printf '"schema_v1_mine":%s,"diagnostics":%s,"warnings":%s}\n' \
      "$([ "${SCHEMA_V1:-0}" = 1 ] && echo true || echo false)" "$(json_diag_array "$DIAGS")" "$(json_diag_array "$WARNS")"
    [ "$PROBLEMS" -eq 0 ] && return 0 || return 1
  fi
  echo "  examined: materials $N_MAT · truths $N_TRUTH ($sealpart) · documents $N_DOC ($N_CONSEC consecrated, $N_GATED gate-checked$gatenote)"
  # Review seals are counted out loud whenever anything is consecrated: a legacy (digest-less)
  # review next to a final is real history that binds no bytes — visible, never silently equal
  # to a sealed one.
  [ "$N_CONSEC" -gt 0 ] && echo "  review seals: $N_RSEAL digest-bound · $N_RLEGACY legacy-unbound"
  [ "${SCHEMA_V1:-0}" = "1" ] && echo "  schema: v1 mine — readable (dual-reader), current format is v$(schema_ver); run 'bash .weavedoc/bin/weavedoc upgrade --check' to see the migration"
  if [ "$PROBLEMS" -eq 0 ]; then echo "✓ validate: all checks passed"; return 0
  else echo "✗ validate: $PROBLEMS problem(s)"; return 1; fi
}

# ===================== impact =====================
cmd_impact() {
  local n="${1:-}" title
  [ -z "$n" ] && { echo "usage: weavedoc impact <material-id>"; return 2; }
  [ -d "$MATERIALS/$n" ] || { echo "no such material: $n"; return 2; }
  title=$(mtitle "$n")
  echo "impact of material $n ($title):"
  echo "  -- truths extracted from it --"
  # `source` and every id here are REFERENCES, resolved leniently (`m1` names folder m001) — judging
  # by raw string made `impact` report an empty blast radius right where a retraction needs it.
  local ncanon; ncanon=$(canon_id "$n") || ncanon=$n
  for f in "$TRUTHS"/t[0-9]*.md; do
    [ -f "$f" ] || continue
    local fsrc; fsrc=$(canon_id "$(fm "$f" source)") || fsrc=$(fm "$f" source)
    [ "$fsrc" = "$ncanon" ] && printf '  %s: %s [%s]\n' "$(fm "$f" id)" "$(fm "$f" claim)" "$(fm "$f" status)"
  done
  echo "  -- documents citing it (by id) --"
  grep -rlnE "\b$n\b" "$DOCUMENTS" 2>/dev/null | sed 's/^/  /' || true
  if [ -n "$title" ]; then
    echo "  -- documents mentioning its title --"
    grep -rlnF "$title" "$DOCUMENTS" 2>/dev/null | sed 's/^/  /' || true
  fi
  # Through the truths: an external-audience document carries neither the material id nor its title,
  # so the greps above come back empty exactly when a retraction needs the radius. The
  # id→truth→document chain always exists — plan.md's cited_truths is the propagation key.
  echo "  -- documents citing its truths (via plan.md cited_truths) --"
  local tid df hitdocs="" fsrc2 cid
  for f in "$TRUTHS"/t[0-9]*.md; do
    [ -f "$f" ] || continue
    fsrc2=$(canon_id "$(fm "$f" source)") || fsrc2=$(fm "$f" source)
    [ "$fsrc2" = "$ncanon" ] || continue
    tid=$(canon_id "$(basename "$f" .md)") || tid=$(basename "$f" .md)
    for df in "$DOCUMENTS"/*/plan.md; do
      [ -f "$df" ] || continue
      case " $hitdocs " in *" $df "*) continue ;; esac
      # cited_truths is lenient too — canonicalise each listed id before comparing, so `t1` in a
      # plan still matches t001.md instead of silently dropping the document from the radius.
      for cid in $(listfield "$(fm "$df" cited_truths)"); do
        cid=$(canon_id "$cid") || continue
        [ "$cid" = "$tid" ] || continue
        hitdocs="$hitdocs $df"; printf '  %s\n' "$df"; break
      done
    done
  done
  [ -n "$hitdocs" ] || echo "  (none)"
}

# ===================== status =====================
cmd_status() {
  local d st next nm
  while IFS= read -r d; do
    st=$(fm "$DOCUMENTS/$d/plan.md" status 2>/dev/null); [ -z "$st" ] && st="(no plan)"
    case "$st" in
      planned)   next="write" ;;
      drafting)  next="write (finish) → review" ;;
      reviewing) next="refine" ;;
      stale)     next="review (truths changed — re-verify)" ;;
      done)      next="—" ;;
      *)         next="plan" ;;
    esac
    # Both output forms, exactly as the gate reads them: reporting a multi-file document as still
    # "→ write" while `final/` sits there sends you back to a step you already finished.
    { [ -f "$DOCUMENTS/$d/final.md" ] || [ -d "$DOCUMENTS/$d/final" ]; } && [ "$st" != "stale" ] && next="— (final)"
    printf '%-18s %-11s → %s\n' "$d" "$st" "$next"
  done < <(doc_ids)
  # The same population validate's `examined:` line counts — converted.md files from disk, not
  # folders (the two once disagreed 2 vs 1). When the folder count differs, the gap is SHOWN.
  local nfold
  nm=$(ls "$MATERIALS"/*/converted.md 2>/dev/null | grep -c . || true); nm=${nm:-0}
  nfold=$(material_ids | grep -c . || true); nfold=${nfold:-0}
  if [ "$nfold" -ne "$nm" ]; then
    echo "materials: $nm ($((nfold-nm)) folder(s) without converted.md — validate names them)"
  else
    echo "materials: $nm"
  fi
  # verify.md's ABSENCE is legal (ruled 2026-08-01) — `verify` is an on-demand lane. But absence is
  # not nothing: without the file, cold-verification state and the Human-queue rule go unchecked, so
  # it is said here rather than left to silence.
  if [ ! -f "$TRUTHS/verify.md" ] && ls "$TRUTHS"/t[0-9]*.md >/dev/null 2>&1; then
    echo "verification: none yet (no truths/verify.md) — truths exist but no cold verification has been recorded; run 'weavedoc verify' when you want one"
  fi
  # Decisions parked on the user. Counted here because a completeness line that reports only
  # "열린 갭 0 · 열린 질문 0" reads as "nothing is waiting on you" while the queue holds eleven.
  if [ -n "$(hq_files)" ]; then
    local hq hq_open
    # Through hq_body, like validate: verify.md is `##`-sectioned and review.md `#`-, so reading only
    # one level under-reports the other.
    hq=$(while IFS= read -r hqf; do hq_body "$hqf"; done < <(hq_files))
    hq_open=$(printf '%s\n' "$hq" | countlines '^[[:space:]]*- \[open\]')
    # Every `- ` line in the section is an entry, tagged or not — the most common legacy shape
    # (`- R3 t217 — …`, no brackets) would otherwise be invisible.
    local hq_untag
    # An ENTRY starts at column 0; an indented `- ` is a sub-bullet OF an entry — counting every
    # `- ` line reported a tagged entry's own sub-bullets as untagged. `- (없음)` / `- (none)` is the
    # documented empty-queue idiom, not an entry.
    hq_untag=$(printf '%s\n' "$hq" | grep -vE '^- \[[<{]' 2>/dev/null | grep -E '^- ' 2>/dev/null | grep -vE '^- \((없음|none)\)' 2>/dev/null | grep -vcE '^- \[(open|ruled)\]' || true)
    if [ "${hq_open:-0}" -gt 0 ]; then
      # The three buckets must SUM to the total. A `- [open]` with no ownership tag lands in the total
      # but in no bucket, so the remainder is shown rather than hidden until validate rejects it.
      local hq_u hq_r hq_m hq_rest
      hq_u=$(printf '%s\n' "$hq" | countlines '^[[:space:]]*- \[open\][[:space:]]*\[user-only\]')
      hq_r=$(printf '%s\n' "$hq" | countlines '^[[:space:]]*- \[open\][[:space:]]*\[recommended\]')
      hq_m=$(printf '%s\n' "$hq" | countlines '^[[:space:]]*- \[open\][[:space:]]*\[machine\]')
      hq_rest=$(( hq_open - hq_u - hq_r - hq_m )); [ "$hq_rest" -lt 0 ] && hq_rest=0
      printf 'human queue: open %s — you decide %s · recommendation ready %s · machine can just do %s' \
        "$hq_open" "$hq_u" "$hq_r" "$hq_m"
      [ "$hq_rest" -gt 0 ] && printf ' · %s missing an ownership tag (validate rejects these)' "$hq_rest"
      printf '\n'
    elif [ "${hq_untag:-0}" -eq 0 ]; then
      echo "human queue: 0"
    fi
    # Reported UNCONDITIONALLY, not only when the tagged count is zero, or one tagged entry hides
    # every untagged one. "untagged" = no `[state]` tag at all (as FORMATS and check_hq_tags mean it);
    # an `[open]` with no ownership tag is a different population, reported by the split line above.
    [ "${hq_untag:-0}" -gt 0 ] && echo "human queue: $hq_untag entry(s) with no '[open]'/'[ruled]' state tag, not counted above — retag them '- [open|ruled] [user-only|recommended|machine] …'"
  fi
  # The warranty's edge is disclosed, not implied (WD-COR-004): with completeness off, omissions
  # are simply not checked, and a status that never says so lets "no gaps reported" read as
  # "no gaps exist".
  if [ "$(cfgval completeness)" != "required" ]; then
    echo "completeness: off — omissions are not checked (fidelity.completeness in .weavedoc/config.yaml; 'required' wires gaps.md into the gate)"
  fi
  return 0
}

# ===================== lang / locale =====================
cmd_lang() {
  local v
  v=$(grep -E '^[[:space:]]*language:' "$CONFIG" 2>/dev/null | head -1 \
      | sed -E 's/^[[:space:]]*language:[[:space:]]*//; s/[[:space:]]*#.*$//; s/[[:space:]]*$//')
  [ -n "$v" ] && echo "$v" || echo "(no config.language yet — run weavedoc init)"
}
cmd_locale() { # short OS language code (ko, en, ja…) or nothing (init then asks)
  local l="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
  l="${l%%.*}"; l="${l%%@*}"
  case "$l" in C|POSIX|"") l="" ;; esac
  if [ -z "$l" ]; then
    local reg
    for reg in /c/Windows/System32/reg.exe /cygdrive/c/Windows/System32/reg.exe "$(command -v reg.exe 2>/dev/null)"; do
      [ -n "$reg" ] && [ -x "$reg" ] || continue
      l=$(MSYS_NO_PATHCONV=1 "$reg" query "HKCU\\Control Panel\\International" /v LocaleName 2>/dev/null \
          | tr -d '\r' | awk '/LocaleName/{print $NF}')
      [ -n "$l" ] && break
    done
  fi
  [ -z "$l" ] && return 1
  echo "$l" | sed 's/[-_].*//' | tr 'A-Z' 'a-z'
}

# ===================== census (mine counts, cross-checked — never hand-count) =====================
# The authoritative mine statistics: truth files vs index entries, id numbering holes, status tally
# (live = ok+conflict+unsupported). Skills MUST report THESE numbers, never eye-counts.
# Only t<digits>.md are truths; index.md/tree.md/verify.md/changelog.md are never counted.
cmd_census() {
  local n_files n_index stat_out holes
  # "No truth files" is not "nothing to report": a mine whose truths were deleted while index.md
  # still lists them must not read as a fresh empty mine.
  if ! ls "$TRUTHS"/t[0-9]*.md >/dev/null 2>&1; then
    # Distinct ids, same rule as the main branch — the line-count defect fixed there had been
    # left in this sibling the same commit made reachable.
    local nidx0
    nidx0=$(grep -oE '^- t[0-9]+:' "$TRUTHS/index.md" 2>/dev/null | LC_ALL=C sort -u | grep -c . || true); nidx0=${nidx0:-0}
    if [ "$nidx0" -gt 0 ]; then
      echo "census: truth files 0 · index entries $nidx0"
      echo "  ✗ index entries with no truth file: $(grep -oE '^- t[0-9]+:' "$TRUTHS/index.md" 2>/dev/null | sed -E 's/^- (t[0-9]+):/\1/' | LC_ALL=C sort -u | tr '\n' ' ' | sed 's/ $//') — the truth files are gone while the index still lists them; run 'weavedoc validate' for the full picture"
    else
      echo "census: no truths yet"
    fi
    return 0
  fi
  n_files=$(ls "$TRUTHS"/t[0-9]*.md 2>/dev/null | grep -c .)
  # Distinct ids, matching the set cross-check below. Counting LINES while comparing `sort -u` sets
  # printed `index entries 2` for one duplicated line, with no ✗ to explain the disagreement.
  local n_index_lines
  n_index_lines=$(grep -cE '^- t[0-9]+:' "$TRUTHS/index.md" 2>/dev/null || true); n_index_lines=${n_index_lines:-0}
  n_index=$(grep -oE '^- t[0-9]+:' "$TRUTHS/index.md" 2>/dev/null | LC_ALL=C sort -u | grep -c . || true); n_index=${n_index:-0}
  stat_out=$(awk '
    function val(   s){ s=$0; sub(/^[^:]*:[[:space:]]*/,"",s); if(s !~ /^"/){ sub(/[[:space:]]+#.*$/,"",s); if(s ~ /^#/) s="" } sub(/[[:space:]]*$/,"",s); sub(/^"/,"",s); sub(/"$/,"",s); return s }
    FNR==1 { infm=($0 ~ /^---[[:space:]]*$/); next }
    infm && /^---[[:space:]]*$/ { infm=0; nextfile }
    infm && /^status[[:space:]]*:/ { st[val()]++ }
    END { printf "%d %d %d %d %d\n", st["ok"]+0, st["discarded"]+st["resolved"]+0, st["conflict"]+0, st["unsupported"]+0, st["retracted"]+0 }
  ' "$TRUTHS"/t[0-9]*.md)
  set -- $stat_out
  local n_ok=$1 n_res=$2 n_conf=$3 n_unsup=$4 n_retr=$5 n_live=$(( $1 + $3 + $4 ))
  holes=$(ls "$TRUTHS"/t[0-9]*.md 2>/dev/null | sed -E 's/.*[\/\\]t0*([0-9]+)\.md$/\1/' | sort -n | awk '
    # Holes BELOW the smallest surviving id too: ids allocate from t001 up, so a lowest file of t011
    # means t001-t010 are gone — yet only gaps BETWEEN surviving ids were reported.
    NR==1 { for(i=1;i<$1;i++) printf "t%03d ", i; p=$1; next } { for(i=p+1;i<$1;i++) printf "t%03d ", i; p=$1 }')
  # A hole the changelog explains (a `removed:` line) is settled — stop re-asking, or a permanent
  # nag teaches readers to skip the line the mine's honesty rests on. Collect every removed id once,
  # zero-padding normalised, ALL ids per line — one grep-per-hole took >2 minutes on ~990 holes.
  local remset="" h hn
  remset=" $(grep -oE '^[[:space:]]*-[[:space:]]*removed:.*' "$TRUTHS/changelog.md" 2>/dev/null \
            | grep -oE '(^|[^[:alnum:]])t[0-9]+([^[:alnum:]]|$)' | grep -oE 't[0-9]+' \
            | sed -E 's/^t0*([0-9]+)$/t\1/' | LC_ALL=C sort -u | tr '\n' ' ')"
  local unexplained="" explained=""
  for h in $holes; do
    hn=$(printf '%s' "$h" | sed -E 's/^t0*([0-9]+)$/t\1/')
    case "$remset" in *" $hn "*) explained="$explained $h" ;; *) unexplained="$unexplained $h" ;; esac
  done
  local n_cov=0 n_mats=0 n_legacy=0 n_legparsed=0
  if [ -f "$TRUTHS/coverage.md" ]; then
    # ONE POPULATION on both sides of the ratio: numerator and denominator both skip retracted
    # materials and both require a real material on disk, or the ratio goes above 1 (validate green,
    # cause false) or reads N/N while a live material holds no record. A section counts only when it
    # HOLDS a record (≥1 body line — a bare `## m002` heading is not a record). Section ids are
    # references, so `## m5` and `## m005` are ONE material: canon first, then dedup.
    local cid cidc covseen=""
    n_cov=0
    for cid in $(nocomment < "$TRUTHS/coverage.md" | awk '
                   /^##[ 	]+m[0-9]+([[:space:]]|$)/ { if(sec!="" && has) print sec; sec=$2; has=0; next }
                   /^##[ 	]/ { if(sec!="" && has) print sec; sec=""; next }
                   sec!="" && NF>0 { has=1 }
                   END { if(sec!="" && has) print sec }'); do
      cidc=$(canon_id "$cid") || cidc=$cid
      case " $covseen " in *" $cidc "*) continue ;; esac
      covseen="$covseen $cidc"
      [ -f "$MATERIALS/$cidc/converted.md" ] || continue
      [ "$(mstatus "$cidc")" = "retracted" ] && continue
      n_cov=$((n_cov+1))
    done
    # `## legacy` lists materials the user ruled exempt (mapped before coverage existed) — without it
    # the ratio can never reach N/N and a permanently-short metric stops being read. ONLY the id
    # leading each bullet counts (the ruling text is free prose that may mention other ids); the id is
    # canonicalised before `mstatus`; and an exemption naming a material not in the denominator (no
    # converted.md, or already-retracted) subtracts nothing, or the ratio goes to 1/0. `n_legparsed`
    # counts bullets that PARSED, `n_legacy` the ones that still subtract — one number cannot carry
    # both, since a skipped-retracted bullet and an all-malformed section both read 0.
    local lid lidc
    n_legacy=0; n_legparsed=0
    for lid in $(nocomment < "$TRUTHS/coverage.md" | section_all - "legacy" \
                 | sed -nE 's/^[[:space:]]*-[[:space:]]*(m[0-9]+)\b.*/\1/p' | LC_ALL=C sort -u); do
      n_legparsed=$((n_legparsed+1))
      lidc=$(canon_id "$lid") || lidc=$lid
      [ -f "$MATERIALS/$lidc/converted.md" ] || continue
      [ "$(mstatus "$lidc")" = "retracted" ] && continue
      n_legacy=$((n_legacy+1))
    done
  fi
  # Denominator = materials on DISK minus retracted (they are never re-mapped, so counting them keeps
  # the ratio short forever). From disk, not parsed frontmatter: incrementing only on a CLOSED
  # frontmatter silently dropped an unclosed/zero-byte material from the denominator. A file that
  # cannot parse stays a material (validate is loudly red about the parse itself).
  if ls "$MATERIALS"/*/converted.md >/dev/null 2>&1; then
    # ONE parser for "is it retracted", both sides of the ratio — the numerator asks mstatus, so this
    # side must too, or they disagree on a duplicate `status:` or an unclosed frontmatter.
    local n_conv n_retrm mf
    n_conv=$(ls "$MATERIALS"/*/converted.md 2>/dev/null | grep -c . || true); n_conv=${n_conv:-0}
    n_retrm=0
    for mf in "$MATERIALS"/*/converted.md; do
      [ -f "$mf" ] || continue
      [ "$(fm "$mf" status)" = "retracted" ] && n_retrm=$((n_retrm+1))
    done
    n_mats=$(( n_conv - n_retrm ))
  fi
  local n_denom=$(( n_mats - n_legacy )); [ "$n_denom" -lt 0 ] && n_denom=0
  # Always show the raw total: `16/26` and `16/16 (+10 legacy-exempt)` are the same mine, and without
  # "of N" a reader sees progress that never happened. This is a LEDGER COUNT, not a completeness
  # warranty (ruled 2026-07-31) — it counts materials with ≥1 coverage.md line; whether extraction is
  # COMPLETE is the gaps skill's axis. The label says `records` so the ratio is not read as a warranty.
  local covline="coverage records $n_cov/$n_denom material(s)"
  [ "$n_legacy" -gt 0 ] && covline="coverage records $n_cov/$n_denom of $n_mats material(s) ($n_legacy legacy-exempt)"
  local retline=""; [ "$n_retr" -gt 0 ] && retline=" · retracted $n_retr"
  echo "census: truth files $n_files · index entries $n_index · live $n_live (ok $n_ok · conflict $n_conf · unsupported $n_unsup) · discarded $n_res$retline · $covline"
  [ -n "$unexplained" ] && echo "  numbering holes (ids never assigned or files lost — confirm which):$unexplained"
  [ -n "$explained" ] && echo "  numbering holes, explained by changelog 'removed:':$explained"
  # Both sides now count the same population, so the only way left to exceed the denominator is a
  # `## legacy` entry that ALSO has its own `## m<id>` section — the message names only that cause.
  [ "$n_cov" -gt "$n_denom" ] && echo "  ✗ coverage numerator exceeds denominator ($n_cov/$n_denom) — a '## legacy' entry names a material that also has its own '## m<id>' section, so it is subtracted from the denominator while still counted in the numerator; drop the legacy exemption (it is covered, not exempt)"
  # Complain only when bullets were present and NONE parsed — use `n_legparsed`, not `n_legacy`
  # (which is also 0 when every bullet parsed then named a retracted material).
  if [ -f "$TRUTHS/coverage.md" ] && [ "$n_legparsed" -eq 0 ] \
     && grep -qiE '^##[ 	]+legacy' "$TRUTHS/coverage.md" \
     && [ "$(nocomment < "$TRUTHS/coverage.md" | section_all - "legacy" | countlines '^[[:space:]]*- ')" -gt 0 ]; then
    echo "  ✗ truths/coverage.md '## legacy' has bullets, but none begins with an m-id — no exemption was applied (format: '- m001 — <ruling>')"
  fi
  # Sets, not counts: a count-only comparison let a missing-truth entry and a no-entry truth CANCEL
  # OUT (a swapped id read as in-sync). Name both sides, and send the unindexable case (no
  # frontmatter → never indexed → reindex loops) to validate, which can explain it.
  if [ "$n_files" -gt 0 ] || [ "$n_index" -gt 0 ]; then
    local idx_only file_only
    idx_only=$(LC_ALL=C comm -23 \
      <(grep -oE '^- t[0-9]+:' "$TRUTHS/index.md" 2>/dev/null | sed -E 's/^- (t[0-9]+):/\1/' | LC_ALL=C sort -u) \
      <(ls "$TRUTHS"/t[0-9]*.md 2>/dev/null | while read -r _f; do basename "$_f" .md; done | LC_ALL=C sort -u) | tr '\n' ' ')
    file_only=$(LC_ALL=C comm -13 \
      <(grep -oE '^- t[0-9]+:' "$TRUTHS/index.md" 2>/dev/null | sed -E 's/^- (t[0-9]+):/\1/' | LC_ALL=C sort -u) \
      <(ls "$TRUTHS"/t[0-9]*.md 2>/dev/null | while read -r _f; do basename "$_f" .md; done | LC_ALL=C sort -u) | tr '\n' ' ')
    [ "$n_index_lines" -gt "$n_index" ] && echo "  ✗ truths/index.md holds $n_index_lines entry line(s) for $n_index distinct id(s) — one id is listed more than once. reindex writes one line per truth file, so two files carry the same 'id:'; run 'weavedoc validate', which names the file whose id does not match its filename"
    [ -n "${idx_only// /}" ] && echo "  ✗ index entries with no truth file: ${idx_only% } — run 'weavedoc reindex'"
    [ -n "${file_only// /}" ] && echo "  ✗ truth files with no index entry: ${file_only% } — run 'weavedoc reindex'; if it comes back, the file is one validate rejects (e.g. no frontmatter) and reindex cannot see it — run 'weavedoc validate' for the cause"
  fi
  # The status tallies must sum to the file count — a duplicate `status:` line tallies one file twice
  # (`live 3 · retracted 1` over 3 files). validate names the key; this makes the arithmetic refuse.
  [ $(( n_live + n_res + n_retr )) -ne "$n_files" ] && echo "  ✗ status tallies sum to $(( n_live + n_res + n_retr )) but there are $n_files truth file(s) — a file carries a status outside the enum (the commonest cause: none of these buckets counts it), a duplicate 'status:' line, or none at all; run 'weavedoc validate'"
  return 0
}

# ===================== gaps (census + declared-marker scan — non-blocking floor for the weavedoc-gaps skill) =====================
# Census first (numbers the skill reuses), then self-declared incompleteness markers in the mine's
# source-of-truth files (converted.md + truths/ ONLY). ALWAYS exits 0: gaps are fill-or-accept, not
# failures. Semantic gaps (reference/enumeration/symmetry) are the weavedoc-gaps skill's; this is the
# mechanical floor. Markers from config gaps.markers (else a default); unchecked `- [ ]` are a
# separate class. The CLI reports raw lines; the skill triages (a marker in prose is not a declaration).
cmd_gaps() {
  local id f ln markers n=0 c=0
  markers=$(cfgval markers)
  [ -z "$markers" ] && markers='미정|미완성|미확정|미상|TBD|TODO|추후 보강|추후 작업|추후 결정|정해지지 않|미해결'
  # Validate the pattern BEFORE scanning: a malformed alternation made every grep exit 2, `2>/dev/null`
  # swallowed the reason, and the floor reported "0 marker line(s)" while off. A misconfig, so exits non-zero.
  printf '' | grep -qE "$markers" 2>/dev/null
  if [ $? -gt 1 ]; then
    echo "config gaps.markers is not a valid 'grep -E' pattern: $markers" >&2
    echo "  the declared-marker scan cannot run — fix gaps.markers in .weavedoc/config.yaml" >&2
    return 2
  fi
  cmd_census
  echo "declared-marker scan (converted.md + truths/t*.md only):"
  while IFS= read -r id; do
    f="$MATERIALS/$id/converted.md"; [ -f "$f" ] || continue
    while IFS= read -r ln; do printf '  %s:%s\n' "$id" "$ln"; n=$((n+1)); done < <(grep -nE "$markers" "$f" 2>/dev/null)
  done < <(material_ids)
  for f in "$TRUTHS"/t[0-9]*.md; do
    [ -f "$f" ] || continue
    while IFS= read -r ln; do printf '  %s:%s\n' "$(basename "$f")" "$ln"; n=$((n+1)); done < <(grep -nE "$markers" "$f" 2>/dev/null)
  done
  echo "unchecked-checkbox scan (converted.md + truths/t*.md only):"
  while IFS= read -r id; do
    f="$MATERIALS/$id/converted.md"; [ -f "$f" ] || continue
    while IFS= read -r ln; do printf '  %s:%s\n' "$id" "$ln"; c=$((c+1)); done < <(grep -nE '^[[:space:]]*- \[ \]' "$f" 2>/dev/null)
  done < <(material_ids)
  for f in "$TRUTHS"/t[0-9]*.md; do
    [ -f "$f" ] || continue
    while IFS= read -r ln; do printf '  %s:%s\n' "$(basename "$f")" "$ln"; c=$((c+1)); done < <(grep -nE '^[[:space:]]*- \[ \]' "$f" 2>/dev/null)
  done
  # Name the accepted register beside the raw count: this scan does NOT read gaps.md, so an accepted
  # gap reprints every run, and a number that never drops stops being read. Reconciling prose
  # locations is the weavedoc-gaps skill's job.
  local nacc=0
  [ -f "$ROOT/gaps.md" ] && nacc=$(nocomment < "$ROOT/gaps.md" | section_body - "Accepted" | countlines '^[[:space:]]*- ')
  [ "${nacc:-0}" -eq 0 ] && [ -f "$ROOT/gaps.md" ] && nacc=$(nocomment < "$ROOT/gaps.md" | section_body2 - "Accepted" | countlines '^[[:space:]]*- ')
  echo "— $n marker line(s) + $c unchecked checkbox(es) — RAW scan, not an open count: gaps.md records ${nacc:-0} already accepted. Non-blocking; run the weavedoc-gaps skill to reconcile these against gaps.md and to cover reference/enumeration/symmetry + fill-or-accept."
}

# ===================== reindex (regenerate truths/index.md + tree.md from frontmatter) =====================
# THE only writer of the generated index files — hand edits drift and corrupt entries; regeneration
# is one deterministic pass.
#   reindex          write both files
#   reindex --check  compare regenerated content against disk; write nothing.
#                    exit 0 = identical, 1 = differs (prints a short diff summary).
cmd_reindex() {
  preflight_gnu || return 2
  local check="" rec tmpi tmpt rc=0
  # A typo used to be silently ignored — `reindex --chek` meant "read-only check" to the user and
  # "rewrite both index files" to the tool. A write command must not guess.
  case "${1:-}" in ""|--check) ;; *) echo "usage: weavedoc reindex [--check]" >&2; return 2 ;; esac
  [ -n "${2:-}" ] && { echo "usage: weavedoc reindex [--check]" >&2; return 2; }
  [ "${1:-}" = "--check" ] && check=1
  if ! ls "$TRUTHS"/t[0-9]*.md >/dev/null 2>&1; then echo "no truths to index"; return 0; fi
  rec=$(awk '
    # Strip \x01 on the way in too: the writer sanitises, but a hand-written file can still hold
    # one, and "the separator cannot occur in the text" is only true if something removes it.
    function val(   s){ s=$0; sub(/^[^:]*:[[:space:]]*/,"",s); if(s !~ /^"/){ sub(/[[:space:]]+#.*$/,"",s); if(s ~ /^#/) s="" } sub(/[[:space:]]*$/,"",s); sub(/^"/,"",s); sub(/"$/,"",s); gsub(/\001/," ",s); return s }
    FNR==1 { infm=($0 ~ /^---[[:space:]]*$/); id=claim=src=st=tg=ao=pv=am="" ; next }
    # \x01, not \t: a TAB inside a hand-written `claim:` used to shift every field right, so
    # index.md printed the source as a tag and tree.md grew a `## ok` section while the real tag
    # vanished — and reindex --check called the result "in sync". \x01 cannot occur in the text.
    infm && /^---[[:space:]]*$/ { infm=0; print id "\x01" claim "\x01" src "\x01" st "\x01" tg "\x01" ao "\x01" pv "\x01" am; nextfile }
    infm && /^id[[:space:]]*:/          { id=val() }
    infm && /^claim[[:space:]]*:/       { claim=val() }
    infm && /^source[[:space:]]*:/      { src=val() }
    infm && /^status[[:space:]]*:/      { st=val() }
    infm && /^tags[[:space:]]*:/        { tg=val(); gsub(/[]["]/,"",tg) }
    infm && /^as_of[[:space:]]*:/       { ao=val() }
    infm && /^provenance[[:space:]]*:/  { pv=val() }
    infm && /^assumptions[[:space:]]*:/ { am=val() }
  ' "$TRUTHS"/t[0-9]*.md)
  # Labels ride the index surfaces too (field report D1): the SAME truth_labels call pull makes,
  # so both entry paths show one fact. Material stage/status come from the batch fm cache; the
  # lines are BUILT in shell so the label text has exactly one spelling — porting truth_labels
  # into awk would be the second copy that drifts.
  local -A rmstage_=() rmstat_=() rtcnt_=()
  local -a rmpre_=() rtarr_=()
  local rmf_ rmb_ rid_ rcl_ rsrc_ rst_ rtg_ rao_ rpv_ ram_ rlab_ rline_ rtag_ rsfx_ rp_ rms_ rmss_ rpairs_=""
  for rmf_ in "$MATERIALS"/*/converted.md; do [ -f "$rmf_" ] && rmpre_+=("$rmf_"); done
  if [ "${#rmpre_[@]}" -gt 0 ]; then
    fm_preload "${rmpre_[@]}"
    for rmf_ in "${rmpre_[@]}"; do
      rmb_=${rmf_%/converted.md}; rmb_=${rmb_##*/}
      fmv "$rmf_" stage;  rmstage_[$rmb_]=$REPLY
      fmv "$rmf_" status; rmstat_[$rmb_]=$REPLY
    done
  fi
  tmpi=$(mktemp); tmpt=$(mktemp)
  {
    echo "# truths/index.md — 진실 색인 (generated, 수정 금지)"
    echo ""
    while IFS=$'\x01' read -r rid_ rcl_ rsrc_ rst_ rtg_ rao_ rpv_ ram_; do
      [ -n "$rid_" ] || continue
      # ` ·· ` opens the label tail — pull strips it before matching, so the guard here keeps a
      # claim that happens to contain the separator from truncating its own searchable text.
      rcl_=${rcl_//··/· ·}; rtg_=${rtg_//··/· ·}
      rms_=""; rmss_=""
      [ -n "$rsrc_" ] && { rms_=${rmstage_[$rsrc_]:-}; rmss_=${rmstat_[$rsrc_]:-}; }
      truth_labels "$rao_" "$rpv_" "$ram_" "$rms_" "$rmss_"; rlab_=$REPLY
      rline_="- $rid_: $rcl_ [$rsrc_] — [$rtg_]"
      [ -n "$rst_" ] && [ "$rst_" != "ok" ] && rline_="$rline_ [$rst_]"
      [ -n "$rlab_" ] && rline_="$rline_ ··$rlab_"
      printf '%s\n' "$rline_"
      # tree pairs in the same pass: tag sections in LC_ALL=C sorted order (ASCII first, then
      # Korean — the standing convention); within a section, truths keep id order via a counter.
      rsfx_=""
      [ -n "$rst_" ] && [ "$rst_" != "ok" ] && rsfx_=" [$rst_]"
      [ -n "$rlab_" ] && rsfx_="$rsfx_ ··$rlab_"
      IFS=',' read -ra rtarr_ <<< "$rtg_"
      for rtag_ in "${rtarr_[@]}"; do
        rtag_=${rtag_#"${rtag_%%[![:space:]]*}"}; rtag_=${rtag_%"${rtag_##*[![:space:]]}"}
        [ -n "$rtag_" ] || continue
        rtcnt_[$rtag_]=$(( ${rtcnt_[$rtag_]:-0} + 1 ))
        printf -v rp_ '%s\x01%06d\x01- %s: %s%s' "$rtag_" "${rtcnt_[$rtag_]}" "$rid_" "$rcl_" "$rsfx_"
        rpairs_+="$rp_"$'\n'
      done
    done <<< "$rec"
  } > "$tmpi"
  {
    echo "# truths/tree.md — 태그별 진실 (generated, 수정 금지)"
    echo ""
    printf '%s' "$rpairs_" \
    | LC_ALL=C sort -t $'\x01' -k1,1 -k2,2 \
    | awk -F'\x01' '{ if($1!=prev){ if(NR>1) print ""; print "## " $1; prev=$1 } print $3 }'
  } > "$tmpt"
  if [ -n "$check" ]; then
    local di dt nfiles nrec
    # A truth file with no frontmatter emits no record, so it is missing from BOTH the regenerated
    # index and the file on disk — and the diff called that "in sync" while census and validate
    # both reported drift. The check that exists to catch index drift went green on it.
    nfiles=$(ls "$TRUTHS"/t[0-9]*.md 2>/dev/null | grep -c . || true)
    nrec=$(printf '%s\n' "$rec" | grep -c . || true)
    if [ "${nfiles:-0}" -ne "${nrec:-0}" ]; then
      echo "reindex: $nfiles truth file(s) but only $nrec produced a record — the rest have no readable frontmatter (line 1 must be '---'); index/tree cannot represent them"
      rc=1
    fi
    di=$(mktemp); dt=$(mktemp)
    tr -d '\r' < "$TRUTHS/index.md" > "$di" 2>/dev/null || true
    tr -d '\r' < "$TRUTHS/tree.md"  > "$dt" 2>/dev/null || true
    if diff -q "$tmpi" "$di" >/dev/null 2>&1; then echo "index.md: in sync"
    else echo "index.md: DIFFERS from regenerated content:"; diff "$di" "$tmpi" | head -20; rc=1; fi
    if diff -q "$tmpt" "$dt" >/dev/null 2>&1; then echo "tree.md: in sync"
    else echo "tree.md: DIFFERS from regenerated content:"; diff "$dt" "$tmpt" | head -20; rc=1; fi
    rm -f "$di" "$dt"
  else
    # Same-filesystem staging + atomic rename (WD-IO-001): mktemp lives on another mount, so a
    # bare cp could die mid-write and leave a half-index behind. Failures propagate, not vanish.
    require_inside_root "$TRUTHS" reindex || { rm -f "$tmpi" "$tmpt"; return 1; }
    local sti="$TRUTHS/.index.md.tmp.$$" stt="$TRUTHS/.tree.md.tmp.$$"
    if cp "$tmpi" "$sti" && cp "$tmpt" "$stt" \
       && mv "$sti" "$TRUTHS/index.md" && mv "$stt" "$TRUTHS/tree.md"; then
      echo "regenerated truths/index.md + truths/tree.md ($(printf '%s\n' "$rec" | grep -c .) truths)"
    else
      rm -f "$sti" "$stt" "$tmpi" "$tmpt"
      echo "reindex: write failed — the staged copies were discarded" >&2
      return 1
    fi
  fi
  rm -f "$tmpi" "$tmpt"
  return $rc
}

# ===================== retag (rename/merge a tag across the mine) =====================
# Rewrites a tag everywhere the format GUARANTEES a parseable list: truths 'tags:', project
# 'required_tags:', plan 'scope_tags:'. Merging is the same op (old → an existing new dedupes).
# Free-text mentions (gaps.md, questions.md, verify.md) are listed, not rewritten. Reindexes after a
# real truth-tag rewrite; run validate afterwards.
#   retag <old> <new> [--dry]     --dry: report what would change, write nothing.
cmd_retag() {
  preflight_gnu || return 2
  local old="${1:-}" new="${2:-}" flag="${3:-}" dry=0 f d c t total=0 truthhits=0
  case "$old$new" in *--dry*) echo "usage: weavedoc retag <old> <new> [--dry]"; return 2 ;; esac
  { [ -n "$old" ] && [ -n "$new" ]; } || { echo "usage: weavedoc retag <old> <new> [--dry]"; return 2; }
  [ "$old" = "$new" ] && { echo "retag: old and new are identical"; return 2; }
  # An unknown third flag used to be ignored — "--forcee" meant "--dry misspelled" to the user
  # and "write everything" to the tool. A write command must not guess.
  case "$flag" in "") ;; --dry) dry=1 ;; *) echo "usage: weavedoc retag <old> <new> [--dry]"; return 2 ;; esac
  # Write mode is a transaction (WD-IO-001): targets are guarded, every file is snapshotted before
  # its first edit, and the whole rename answers to a post-write full validation — fail and every
  # byte is restored, indexes re-synced. A tag rename must not be able to half-happen.
  local RETAG_BAK=""
  if [ "$dry" -eq 0 ]; then
    require_inside_root "$TRUTHS" retag || return 1
    require_inside_root "$DOCUMENTS" retag || return 1
    RETAG_BAK=$(mktemp -d "$ROOT/.retag-bak.XXXXXX") || { echo "retag: cannot create the backup dir"; return 1; }
  fi
  # `old`/`new` ride via ENVIRON, never `awk -v`: -v escape-processes the value, so a backslash in a
  # tag expands to a real newline+TAB and splits the rewritten line, which validate then reads clean.
  # Frontmatter ONLY: matching over the whole file rewrote a BODY that quotes a list-shaped line
  # (`tags: [위약, 대금]`, which FORMATS encourages when the wording is the fact), breaking the seal
  # on the tool's own edit. The body is sealed; the only writer here must not touch it.
  local prog='
    function strip(s){ gsub(/^[[:space:]]+|[[:space:]]+$/,"",s); gsub(/^"|"$/,"",s); return s }
    BEGIN { old=ENVIRON["WD_OLD"]; new=ENVIRON["WD_NEW"] }
    FNR==1 { infm = ($0 ~ /^---[[:space:]]*$/); if(mode=="w") print; next }
    infm && /^---[[:space:]]*$/ { infm=0; if(mode=="w") print; next }
    infm && $0 ~ ("^" key "[[:space:]]*:[[:space:]]*\\[") {
      inner=$0; sub(/^[^[]*\[/,"",inner); sub(/\].*$/,"",inner)
      # Everything after the closing `]` rides along unchanged (a trailing YAML comment is not part
      # of the value). The sub RETURN VALUE matters: with no closing `]` it strips nothing and
      # appending `tail` corrupts the line, so an unclosed list is left EXACTLY as-is (falling through
      # to the print rule — skipping would delete it). validate names the unclosed bracket.
      tail=$0; closed=sub(/^[^]]*\]/,"",tail)
      if(closed){
        n=split(inner,el,","); out=""; hit=0; delete seen
        for(i=1;i<=n;i++){ e=strip(el[i]); if(e=="") continue
          if(e==old){ e=new; hit=1 }
          if(!(e in seen)){ seen[e]=1; out=(out=="") ? e : out ", " e } }
        if(hit){
          if(mode=="s" && !(FILENAME in pf)){ pf[FILENAME]=1; print FILENAME }
          if(mode=="c") chg++
          if(mode=="w") $0=key ": [" out "]" tail
        }
      }
    }
    mode=="w" { print }
    END { if(mode=="c") print chg+0 }'
  rewrite_file() { # $1=file $2=key — in-place via tmp, original snapshotted once for rollback
    if [ -n "$RETAG_BAK" ]; then
      local rel=${1#"$ROOT"/} bk
      bk="$RETAG_BAK/${rel//\//__}"
      if [ ! -f "$bk" ]; then cp "$1" "$bk" && printf '%s\n' "$rel" >> "$RETAG_BAK/.list"; fi
    fi
    t=$(mktemp)
    # Preserve the file's line endings: awk writes LF, so a one-tag rename rewrote every line of a
    # CRLF file — a whole-file diff for one word. Trailing CRs normalised to exactly one.
    if WD_OLD="$old" WD_NEW="$new" awk -v key="$2" -v mode=w "$prog" "$1" > "$t"; then
      # Detected with bash read, NOT grep: grep under MSYS strips CR on input, so `grep -q` never
      # matched and the whole preservation step was dead code that looked correct.
      IFS= read -r _l0 < "$1"
      case "$_l0" in *$'\r') sed -i 's/\r*$/\r/' "$t" ;; esac
      cp "$t" "$1"
    fi
    rm -f "$t"
  }
  [ "$dry" -eq 1 ] && echo "retag '$old' → '$new' (dry run — nothing written):" || echo "retag '$old' → '$new':"
  # Truths: ONE awk scan across all files (per-file spawns cost minutes on MSYS), then rewrite only
  # the files that hit.
  if ls "$TRUTHS"/t[0-9]*.md >/dev/null 2>&1; then
    local hitlist
    hitlist=$(WD_OLD="$old" WD_NEW="$new" awk -v key="tags" -v mode=s "$prog" "$TRUTHS"/t[0-9]*.md)
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      printf '  %s (tags)\n' "$f"; total=$((total+1)); truthhits=$((truthhits+1))
      [ "$dry" -eq 0 ] && rewrite_file "$f" tags
    done <<< "$hitlist"
  fi
  if [ -f "$PROJECT" ]; then
    c=$(WD_OLD="$old" WD_NEW="$new" awk -v key="required_tags" -v mode=c "$prog" "$PROJECT")
    if [ "${c:-0}" -gt 0 ]; then
      printf '  %s (required_tags)\n' "$PROJECT"; total=$((total+1))
      [ "$dry" -eq 0 ] && rewrite_file "$PROJECT" required_tags
    fi
  fi
  while IFS= read -r d; do
    [ -f "$DOCUMENTS/$d/plan.md" ] || continue
    c=$(WD_OLD="$old" WD_NEW="$new" awk -v key="scope_tags" -v mode=c "$prog" "$DOCUMENTS/$d/plan.md")
    if [ "${c:-0}" -gt 0 ]; then
      printf '  %s (scope_tags)\n' "$DOCUMENTS/$d/plan.md"; total=$((total+1))
      [ "$dry" -eq 0 ] && rewrite_file "$DOCUMENTS/$d/plan.md" scope_tags
    fi
  done < <(doc_ids)
  if [ "$total" -eq 0 ]; then echo "  no list-field occurrences of '$old'"; fi
  local freetext=""
  for f in "$ROOT/gaps.md" "$ROOT/questions.md" "$TRUTHS/verify.md"; do
    [ -f "$f" ] && grep -qF -- "$old" "$f" && freetext="$freetext $f"
  done
  [ -n "$freetext" ] && echo "  review manually (free-text mentions of '$old', not rewritten):$freetext"
  if [ "$dry" -eq 1 ]; then return 0; fi
  if [ "$total" -eq 0 ]; then rm -rf "$RETAG_BAK"; return 0; fi
  # Commit path: regenerate the views, then the same full validation everything answers to.
  local vout vrc=0
  if [ "$truthhits" -gt 0 ]; then cmd_reindex "" >/dev/null || vrc=1; fi
  if [ "$vrc" -eq 0 ]; then vout=$(cmd_validate 2>&1) || vrc=1; fi
  if [ "$vrc" -eq 0 ]; then
    rm -rf "$RETAG_BAK"
    echo "done — $total file(s) rewritten · post-validate clean."
    return 0
  fi
  # Rollback: restore every snapshot, re-sync the generated views to the restored tags.
  printf '%s\n' "${vout:-}" | sed 's/^/  /'
  local rel
  if [ -f "$RETAG_BAK/.list" ]; then
    while IFS= read -r rel; do
      [ -n "$rel" ] && cp "$RETAG_BAK/${rel//\//__}" "$ROOT/$rel"
    done < "$RETAG_BAK/.list"
  fi
  [ "$truthhits" -gt 0 ] && cmd_reindex "" >/dev/null 2>&1
  rm -rf "$RETAG_BAK"
  echo "retag: post-write validation FAILED — every edit rolled back, indexes re-synced; the mine is as before. The problems above predate the rename." >&2
  return 1
}

# ===================== pull (protocol-correct mine lookup — the read-side census) =====================
# The read-side census: searches claims+tags (index.md), falls back to body-text grep, and applies
# READ.md mechanically — superseded → winner, conflict/unsupported flagged unusable, as_of/derived/
# plan-stage labels attached. Use this instead of eye-filtering raw truth files.
cmd_pull() {
  local term="${1:-}"
  [ -z "$term" ] && { echo "usage: weavedoc pull <tag-or-keyword>"; return 2; }
  ls "$TRUTHS"/t[0-9]*.md >/dev/null 2>&1 || { echo "pull: no truths yet"; return 0; }
  [ -f "$TRUTHS/index.md" ] || { echo "pull: truths/index.md missing (run 'weavedoc reindex')"; return 2; }
  # Case-insensitive search in awk (index + tolower): git-bash grep 3.0 SEGFAULTs on -iF with
  # multibyte input. awk tolower() folds ASCII only, leaving Korean bytes untouched. Term via
  # ENVIRON (not -v) so backslashes are not escape-processed.
  local ids id
  # Labels are OUTPUT, not search text (D1 follow-through): the match runs on the line with its
  # ` ··<labels>` tail stripped, or pulling a word that occurs only in label prose ("evidence",
  # "PLAN") would hit every labeled truth in the mine.
  ids=$(WVTERM="$term" awk 'BEGIN{ t=tolower(ENVIRON["WVTERM"]) }
        { hay=$0; sub(/ ··.*$/, "", hay); if (index(tolower(hay), t)) print }' \
        "$TRUTHS/index.md" | grep -oE '^- t[0-9]+' | sed 's/^- //')
  if [ -z "$ids" ]; then
    ids=$(WVTERM="$term" awk 'BEGIN{ t=tolower(ENVIRON["WVTERM"]) }
        index(tolower($0), t){ if(!(FILENAME in seen)){ seen[FILENAME]=1; print FILENAME } }' \
        "$TRUTHS"/t[0-9]*.md 2>/dev/null | sed -E 's/.*[\/\\](t[0-9]+)\.md$/\1/')
    [ -n "$ids" ] && echo "(no claim/tag match — body-text matches below)"
  fi
  [ -z "$ids" ] && { echo "pull '$term': no matches (claims, tags, bodies)"; return 0; }
  local -a tfiles=()
  local n=0
  for id in $ids; do [ -f "$TRUTHS/$id.md" ] && { tfiles+=("$TRUTHS/$id.md"); n=$((n+1)); }; done
  # index hits without files = stale index. MUST bail: awk with zero file args would read stdin (hang).
  [ "$n" -eq 0 ] && { echo "pull '$term': index matches have no truth files — stale index, run 'weavedoc reindex'"; return 1; }
  [ "$n" -gt 60 ] && echo "($n matches — narrow the term if this is noise)"
  # one awk pass extracts the fields of all hit files (per-file fm spawns are the MSYS trap)
  local rec
  rec=$(awk '
    function val(   s){ s=$0; sub(/^[^:]*:[[:space:]]*/,"",s); if(s !~ /^"/){ sub(/[[:space:]]+#.*$/,"",s); if(s ~ /^#/) s="" } sub(/[[:space:]]*$/,"",s); sub(/^"/,"",s); sub(/"$/,"",s); gsub(/\001/," ",s); return s }
    function flush(){ if(tid!="") printf "%s\x01%s\x01%s\x01%s\x01%s\x01%s\x01%s\x01%s\x01%s\x01%s\n", tid, st, cl, src, asof, prov, cw, res, asm, bd1 }
    FNR==1 { flush(); n=split(FILENAME,pp,"/"); fn=pp[n]; sub(/\.md$/,"",fn); tid=fn
             st="";cl="";src="";asof="";prov="";cw="";res="";asm="";bd1=""; infm=($0 ~ /^---[[:space:]]*$/); next }
    infm && /^---[[:space:]]*$/ { infm=0; next }
    # The first body line too, because the CLAIM is all pull has shown and the claim is the one field
    # nothing verifies (validate seals the BODY, not the claim). Printing them together puts what the
    # machine warranted next to what it did not — the claim stays a paraphrase, uncheckable by design.
    !infm && bd1=="" && $0 ~ /[^[:space:]]/ { bd1=$0; sub(/^[[:space:]]+/,"",bd1); gsub(/\001/," ",bd1) }
    infm && /^status[[:space:]]*:/        { st=val() }
    infm && /^claim[[:space:]]*:/         { cl=val() }
    infm && /^source[[:space:]]*:/        { src=val() }
    infm && /^as_of[[:space:]]*:/         { asof=val() }
    infm && /^provenance[[:space:]]*:/    { prov=val() }
    infm && /^conflict_with[[:space:]]*:/ { cw=val() }
    infm && /^resolution[[:space:]]*:/    { res=val() }
    infm && /^assumptions[[:space:]]*:/   { asm=val() }
    END { flush() }
  ' "${tfiles[@]}")
  # material stage/status looked up once per unique source (few)
  declare -A mstage mstat
  local st cl src asof prov cw res asm bd1 lab w sc
  local n_live=0 n_res=0 n_conf=0 n_unsup=0 n_retr=0
  # \x01 separator, not tab — tab is IFS whitespace, so bash read COLLAPSES consecutive tabs
  # and empty fields shift (reindex uses \x01 for the same reason).
  while IFS=$'\x01' read -r id st cl src asof prov cw res asm bd1; do
    [ -n "$id" ] || continue
    if [ -n "$src" ] && [ -z "${mstat[$src]+x}" ]; then
      if [ -f "$MATERIALS/$src/converted.md" ]; then
        fmv "$MATERIALS/$src/converted.md" status; mstat[$src]=$REPLY
        fmv "$MATERIALS/$src/converted.md" stage;  mstage[$src]=$REPLY
      else mstat[$src]=""; mstage[$src]=""; fi
    fi
    # Guarded: a truth with no `source:` gives an empty subscript, which bash reports as
    # "bad array subscript" on stderr — noise on an otherwise correct result.
    if [ -n "$src" ]; then
      truth_labels "$asof" "$prov" "$asm" "${mstage[$src]:-}" "${mstat[$src]:-}"
    else
      truth_labels "$asof" "$prov" "$asm" "" ""
    fi
    lab=$REPLY
    case "$st" in
      discarded|resolved)
        # "resolved" = pre-rename legacy value (validate flags it); winner-self is legacy too. Both
        # still rendered usable so a mid-migration mine reads correctly.
        w=""; [[ "$res" =~ winner[[:space:]]*:[[:space:]]*(\[[^]]*\]|[^,\}]+) ]] && w=${BASH_REMATCH[1]}
        # Key spelling must allow a space before the colon here too (`scope : [금액]`), or a reader
        # following READ.md is told a PARTIAL supersede was total — the opposite fact.
        sc=""; [[ "$res" =~ scope[[:space:]]*:[[:space:]]*(\[[^]]*\]) ]] && sc=${BASH_REMATCH[1]}
        if [ -n "$w" ] && [[ "$w" =~ (^|[^0-9A-Za-z])${id}([^0-9]|$) ]]; then
          printf '%s  [WON ITS CONFLICT — usable; legacy stamp, set status: ok] %s [%s]%s\n' "$id" "$cl" "$src" "$lab"
          [ -n "$bd1" ] && printf '      ↳ sealed: %s\n' "$bd1"
          n_live=$((n_live+1))
        elif [ -n "$sc" ]; then
          # PARTIAL discard (field report D4): READ.md rule 2 sends the reader to the SURVIVING
          # half of this very row — which therefore needs its source and labels exactly like a
          # live row. The old printf dropped $lab and [$src] here alone, so the half a consumer
          # may use printed with no as_of, no DERIVED, no PLAN-STAGE (eclypse t040).
          printf '%s  [DISCARDED → %s · scope %s] %s [%s]%s\n' "$id" "${w:-?}" "$sc" "$cl" "$src" "$lab"
          n_res=$((n_res+1))
        else
          # FULL discard: the protocol says follow the successor — nothing here is for use, so
          # the row stays terse and label-free on purpose.
          printf '%s  [DISCARDED → %s] %s\n' "$id" "${w:-?}" "$cl"
          n_res=$((n_res+1))
        fi;;
      conflict)
        printf '%s  [!! CONFLICT vs %s — unresolved, use NEITHER side] %s [%s]%s\n' "$id" "${cw:-?}" "$cl" "$src" "$lab"
        n_conf=$((n_conf+1));;
      unsupported)
        printf '%s  [!! UNSUPPORTED — grounding gone, do not use] %s%s\n' "$id" "$cl" "$lab"
        n_unsup=$((n_unsup+1));;
      retracted)
        printf '%s  [!! RETRACTED — was never a valid extraction; tombstone only, no successor] %s%s\n' "$id" "$cl" "$lab"
        n_retr=$((n_retr+1));;
      *)
        if [ -n "$res" ] && printf '%s' "$res" | grep -q 'type[[:space:]]*:[[:space:]]*attribute'; then
          lab="$lab [ATTRIBUTED — cite both sides, per resolution]"
        fi
        printf '%s  %s [%s]%s\n' "$id" "$cl" "$src" "$lab"
        # Only on the usable rows: everywhere else the protocol is telling the reader NOT to use the
        # value, and the quote would just be noise under an instruction to look elsewhere.
        [ -n "$bd1" ] && printf '      ↳ sealed: %s\n' "$bd1"
        n_live=$((n_live+1));;
    esac
  done <<< "$rec"
  echo "— usable $n_live · discarded $n_res (successor in resolution) · conflict $n_conf · unsupported $n_unsup · retracted $n_retr (no successor)"
  echo "  bodies: truths/<id>.md · protocol: .weavedoc/READ.md"
  return 0
}

# ===================== version =====================
# Runtime bundle version (.weavedoc/VERSION, date-stamped). Every install carries it; comparing the
# distribution repo against an install catches divergence early. Bump the date on any bundle change.
cmd_version() {
  # The date label alone cannot identify a bundle — two installs can share it while their bin differs.
  # The fingerprint is content, so comparing installs is real.
  local vf="" fp
  if   [ -f "$ROOT/.weavedoc/VERSION" ]; then vf="$ROOT/.weavedoc/VERSION"
  elif [ -f "$SCRIPT_DIR/../VERSION" ];  then vf="$SCRIPT_DIR/../VERSION"
  else echo "(no VERSION file)"; return 1; fi
  fp=$(cat "$SCRIPT_DIR/weavedoc" "$SCRIPT_DIR/../schema" 2>/dev/null \
       | { command -v sha1sum >/dev/null 2>&1 && sha1sum || cksum; } | awk '{print $1}')
  if [ "$WD_JSON" = 1 ]; then
    printf '{"output_schema_version":1,"command":"version","bundle":"%s","fingerprint":"%s","schema_version":%s}\n' \
      "$(json_esc "$(cat "$vf")")" "$(json_esc "${fp:0:12}")" "$(schema_ver)"
    return 0
  fi
  cat "$vf"
  [ -n "$fp" ] && echo "fingerprint: ${fp:0:12}  (bin+schema — compare this, not just the date)"
  echo "schema: $(schema_ver) (this runtime reads ≤$(schema_ver); a v1 mine migrates via 'upgrade')"
  return 0
}

# ===================== scope (what a verify round still owes) =====================
# The unverified set, COMPUTED — never judged. Two ledgers, both mechanical: a material carries its
# own `status`, and truths are covered by `## Verified units` in verify.md; disk is the population,
# the difference is the round's scope. A command and not a paragraph because scope was a judgement
# call that failed three rounds running — asked which truths a round owed, a real run answered "all
# 264", three times, when ~40 were unverified, and §7's re-check table said so and was never opened.
compress_ids() { # stdin: sorted canonical ids -> one line, consecutive runs collapsed to a-b
  awk '
    function pad(pp, nn) { return sprintf("%s%03d", pp, nn+0) }
    function flush() { if (n0=="") return; if (n0==n1) printf "%s ", pad(p,n0); else printf "%s-%s ", pad(p,n0), pad(p,n1) }
    { cp = substr($0,1,1); cn = substr($0,2)+0
      if (n0 != "" && cp == p && cn == n1+1) { n1 = cn; next }
      flush(); p = cp; n0 = cn; n1 = cn }
    END { flush(); printf "\n" }'
}
scan_verified_units() { # -> "V<TAB><id>" per covered id · "U<TAB><line>" per entry with no verdict
  # Reads the ledger by VERDICT, never by line shape: the production mine writes a table and the
  # shipped template writes bullets, so a shape-bound parser would read the other as "nothing
  # verified" — the full-mine round this command prevents, back through the door. Judge the token.
  [ -f "$TRUTHS/verify.md" ] || return 0
  # Normalised first so every awk bracket below stays pure ASCII (a multibyte dash inside `[...]`
  # reads as a range endpoint). `·` becomes a space — it only ever separates ids (`t194·t195`).
  nocomment < "$TRUTHS/verify.md" | section_all - "Verified units" \
    | sed 's/–/-/g; s/—/-/g; s/·/ /g' \
    | awk -v mark="${SCH[verify.units.verified]}" '
    function pad(pp, nn) { return sprintf("%s%03d", pp, nn+0) }
    BEGIN { if (mark == "") mark = "verified"; mark = tolower(mark) }
    {
      line = $0
      if (line !~ /^[[:space:]]*[|-]/) next                # prose, not a ledger entry
      if (line ~ /^[[:space:]]*\|[[:space:]|:-]*$/) next   # table separator row
      if (line !~ /[mt][0-9]/) next                        # names no unit (header row, note)
      # THE VERDICT DECIDES, not the presence of ids: entries here name units while reporting them
      # failed or unrun (`**미통과**`, `R3 미실행`), so harvesting ids blind would certify what the
      # ledger refused. A substring test fails too (`unverified` contains `verified`), so the entry
      # must END with the marker once trailing decoration is stripped — the verdict is last on the line.
      v = line; gsub(/[[:space:]|*.-]+$/, "", v)
      if (tolower(v) !~ ("(^|[^a-z_])" mark "$")) { print "U\t" line; next }
      # Ranges are validated BEFORE anything from this line is emitted: a reversed span expands
      # to zero in a naive loop (silent), an absurd one to millions (one typo minting coverage) —
      # either way the LINE covers nothing and is named with the other cover-nothing entries.
      s = line; badrange = 0
      while (match(s, /[mt][0-9]+-[mt][0-9]+/)) {
        r = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
        i = index(r, "-"); a = substr(r, 1, i-1); b = substr(r, i+1)
        if (substr(a,1,1) != substr(b,1,1)) continue
        if (substr(b,2)+0 < substr(a,2)+0 || substr(b,2)+0 - substr(a,2)+0 > 9999) { badrange = 1; break }
      }
      if (badrange) { print "U\t" line; next }
      s = line
      while (match(s, /[mt][0-9]+-[mt][0-9]+/)) {
        r = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
        i = index(r, "-"); a = substr(r, 1, i-1); b = substr(r, i+1)
        if (substr(a,1,1) != substr(b,1,1)) continue
        for (k = substr(a,2)+0; k <= substr(b,2)+0; k++) print "V\t" pad(substr(a,1,1), k)
      }
      s = line   # range endpoints print twice; the sort -u downstream makes that free
      while (match(s, /[mt][0-9]+/)) {
        tok = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
        print "V\t" pad(substr(tok,1,1), substr(tok,2) + 0)
      }
    }'
}
cmd_seal_review() { # seal-review <doc-id> [draft|final] — pin what the clean review reviewed
  preflight_gnu || return 2
  # Writes reviewed_kind + reviewed_digest + review_context_digest into review.md frontmatter.
  # Digests are computed HERE, never by hand — one spelling. The review skill calls this right
  # after finishing a round, while "what the reviewer read" and "what is on disk" are one thing.
  # A review_legacy marker is REMOVED on seal (v0.3.2): the marker says "v1 history, digest-less
  # by definition", and a freshly sealed review is neither — leaving it parked a demotion path
  # (strip the seal later and the review read as legacy again, reopening the gate).
  local d="${1:-}" kind="${2:-draft}"
  [ -n "$d" ] || { echo "usage: weavedoc seal-review <doc-id> [draft|final]"; return 2; }
  case "$d" in *[/\\]*|.|..) echo "seal-review: '$d' is not a document id (ids are plain folder names under documents/)"; return 2 ;; esac
  case "$kind" in draft|final) ;; *) echo "seal-review: kind '$kind' must be draft|final"; return 2 ;; esac
  local rev="$DOCUMENTS/$d/review.md"
  [ -f "$rev" ] || { echo "seal-review: no review.md for '$d' — run review first"; return 2; }
  head -1 "$rev" | grep -q '^---[ 	]*$' || { echo "seal-review: review.md has no frontmatter block to seal into (line 1 must be exactly '---') — nothing sealed"; return 2; }
  local art adg cdg
  if [ "$kind" = draft ]; then art=$(doc_draft_path "$d") || { echo "seal-review: no draft for '$d'"; return 2; }
  else art=$(doc_final_path "$d") || { echo "seal-review: no final for '$d'"; return 2; }; fi
  adg=$(artifact_digest "$art") || { echo "seal-review: cannot digest $art"; return 2; }
  cdg=$(context_digest "$d")
  local tmp="$rev.tmp.$$"
  awk -v k="$kind" -v a="sha256:$adg" -v c="sha256:$cdg" '
    NR==1 && /^---[[:space:]]*$/ { infm=1; print; next }
    infm && /^---[[:space:]]*$/ {
      print "reviewed_kind: " k
      print "reviewed_digest: " a
      print "review_context_digest: " c
      infm=0; print; next }
    infm && /^(reviewed_kind|reviewed_digest|review_context_digest|review_legacy)[[:space:]]*:/ { next }
    { print }' "$rev" > "$tmp" && mv "$tmp" "$rev" \
    || { rm -f "$tmp" 2>/dev/null; echo "seal-review: write failed"; return 1; }
  printf 'seal-review: %s %s sealed\n  reviewed_digest: sha256:%s\n  review_context_digest: sha256:%s\n' \
    "$d" "$kind" "$adg" "$cdg"
  return 0
}
cmd_consecrate() { # consecrate <doc-id> — stage candidate, verify seals, ONE full validation, atomic promote
  preflight_gnu || return 2
  # The §5.3 flow, mechanized: the reviewed draft becomes final byte-for-byte or nothing changes.
  local d="${1:-}"
  [ -n "$d" ] || { echo "usage: weavedoc consecrate <doc-id>"; return 2; }
  # A doc id is a plain folder name under documents/ — a path fragment must be refused before
  # any filesystem access, or '../x' resolves relative to the tree (v0.3.3).
  case "$d" in *[/\\]*|.|..) echo "consecrate: '$d' is not a document id (ids are plain folder names under documents/)"; return 2 ;; esac
  local rev="$DOCUMENTS/$d/review.md"
  [ -f "$rev" ] || { echo "consecrate: no review.md for '$d' — run review first"; return 2; }
  # A leftover backup means an earlier consecration died mid-validate: the final slot may hold
  # an UNVALIDATED candidate and .final.bak is the only original. This run must not delete that
  # backup (the old code did) — a human decides: restore the backup over final, or remove it.
  if [ -e "$DOCUMENTS/$d/.final.bak" ]; then
    echo "consecrate: interrupted consecration detected — $DOCUMENTS/$d/.final.bak exists, so the current final may be an unvalidated candidate. Restore the backup over final (or remove it if the current final is known good), then re-run. Nothing was touched."
    return 1
  fi
  if [ -e "$DOCUMENTS/$d/.consecrate.inflight" ]; then
    # The recovery guidance says COMPARE FIRST (v0.3.3): a crash BEFORE the swap leaves the
    # ORIGINAL at final, so "remove final" as a blanket instruction deletes the wrong file.
    echo "consecrate: interrupted consecration detected — $DOCUMENTS/$d/.consecrate.inflight exists, so a consecration is running or died here. If nothing is running, byte-compare final against the reviewed draft BEFORE deciding: identical → it is the staged candidate (safe to remove); different → it is your original (keep it; the crash came before the swap); absent with .final.bak present → restore the backup. Then delete the marker and re-run. Nothing was touched."
    return 1
  fi
  # Two finals at once: doc_final_path resolves the directory, so proceeding would back up ONLY
  # final/ and then overwrite final.md with the candidate — no backup — and the post-swap
  # validation would see a mine where the dual state had vanished. Both prior artifacts were
  # destroyed on the success path (v0.3.2 finding). Refused before the first write, the same
  # reading validate blocks as GATE-DUAL-FINAL.
  if [ -f "$DOCUMENTS/$d/final.md" ] && [ -d "$DOCUMENTS/$d/final" ]; then
    echo "consecrate: $d has both final.md and final/ — only one can be the consecrated output and consecrate cannot know which to preserve; remove the one that is not the reviewed artifact, then re-run. Nothing was touched."
    return 1
  fi
  # 1. The gate must be empty — the same reader validate uses, or the two could disagree.
  local line
  while IFS= read -r line; do
    is_noise "$line" && continue
    echo "consecrate: open gate — review.md 'Fidelity violations' is non-empty ('$line'). Refine until the gate is clean"; return 2
  done < <(fid_body "$rev")
  # 2. Sealed, and sealed over the DRAFT (consecrate promotes a reviewed draft).
  local rdg rkind
  rdg=$(fm "$rev" reviewed_digest); rdg=${rdg#sha256:}
  [ -n "$rdg" ] || { echo "consecrate: unsealed review (no reviewed_digest) — after the clean round run: weavedoc seal-review $d draft"; return 2; }
  rkind=$(fm "$rev" reviewed_kind)
  [ "$rkind" = "draft" ] || { echo "consecrate: reviewed_kind is '$rkind' — consecrate promotes a reviewed DRAFT; re-seal with kind draft"; return 2; }
  # 3. The draft on disk must BE the reviewed bytes.
  local art cur
  art=$(doc_draft_path "$d") || { echo "consecrate: no draft for '$d'"; return 2; }
  cur=$(artifact_digest "$art")
  [ "$cur" = "$rdg" ] || { echo "consecrate: draft changed after the clean review (digest mismatch) — re-review, then consecrate"; return 2; }
  # 4. The ground must not have shifted under the review.
  local rcx nowcx
  rcx=$(fm "$rev" review_context_digest); rcx=${rcx#sha256:}
  if [ -n "$rcx" ]; then
    nowcx=$(context_digest "$d")
    [ "$nowcx" = "$rcx" ] || { echo "consecrate: review context changed (cited truth, source material, config or schema) — the clean review no longer describes this mine; re-review"; return 2; }
  fi
  # 5. Stage the candidate on the same filesystem, verify the copy, mark, swap, validate ONCE.
  local isdir=0 cand fin oldfin="" bak="$DOCUMENTS/$d/.final.bak" mark="$DOCUMENTS/$d/.consecrate.inflight"
  [ -d "$art" ] && isdir=1
  if [ $isdir -eq 1 ]; then cand="$DOCUMENTS/$d/.candidate.final"; rm -rf "$cand"
    cp -r "$art" "$cand" || { rm -rf "$cand"; echo "consecrate: cannot stage the candidate copy — nothing promoted"; return 1; }
  else cand="$DOCUMENTS/$d/.candidate.final.md"
    cp "$art" "$cand" || { rm -f "$cand"; echo "consecrate: cannot stage the candidate copy — nothing promoted"; return 1; }
  fi
  [ "$(artifact_digest "$cand")" = "$rdg" ] \
    || { rm -rf "$cand"; echo "consecrate: candidate copy does not match the reviewed digest — copy failed; nothing promoted"; return 1; }
  oldfin=$(doc_final_path "$d") || oldfin=""
  if [ $isdir -eq 1 ]; then fin="$DOCUMENTS/$d/final"; else fin="$DOCUMENTS/$d/final.md"; fi
  # The durable in-flight marker precedes the FIRST final mutation and is removed LAST — and
  # only behind a VERIFIED postcondition (v0.3.3): a first-ever consecration has no .final.bak,
  # so a hard kill used to leave an unvalidated candidate at final with NO trace. Creation is
  # exclusive (noclobber): two concurrent consecrations cannot both hold the transaction. The
  # marker is written first but not fsynced — power-loss protection is only as good as the
  # filesystem's ordering; process-level kills are fully covered.
  if ! ( set -o noclobber; printf 'started: %s\ndoc: %s\n' "$(date +%F)" "$d" > "$mark" ) 2>/dev/null; then
    rm -rf "$cand"
    echo "consecrate: cannot create the in-flight marker (it appeared concurrently, or the directory is unwritable) — another consecration may be running; nothing promoted"
    return 1
  fi
  # stage guards the abort — and is promoted BEFORE each mutation it names (v0.3.3): assignment
  # is not atomic with mv, and an INT landing between `mv cand fin` and a late promotion left
  # the candidate in place while the abort skipped its removal. For a single-file doc $oldfin
  # and $fin are the SAME path, so an abort before the aside-move must not rm the original.
  local stage="staged"
  consec_abort() {
    trap - INT TERM
    [ "$stage" = "placed" ] && rm -rf "$fin" 2>/dev/null
    [ -n "$oldfin" ] && [ -e "$bak" ] && mv "$bak" "$oldfin" 2>/dev/null
    rm -rf "$cand" 2>/dev/null
    # The marker leaves ONLY behind a verified postcondition — restore incomplete means the
    # marker stays and validate blocks until a human resolves it. Fail-closed beats tidy.
    local ok_=1
    if [ -n "$oldfin" ]; then { [ -e "$oldfin" ] && [ ! -e "$bak" ]; } || ok_=0
    else [ -e "$fin" ] && ok_=0; fi
    if [ "$ok_" = 1 ] && rm -f "$mark" 2>/dev/null; then
      echo "consecrate: interrupted — candidate removed, original final restored" >&2
    else
      echo "consecrate: interrupted — RESTORE INCOMPLETE; the in-flight marker stays and validate blocks until resolved (byte-compare final against the reviewed draft before deciding what to keep)" >&2
    fi
    exit 130
  }
  trap consec_abort INT TERM
  if [ -n "$oldfin" ]; then
    mv "$oldfin" "$bak" || { trap - INT TERM; rm -rf "$cand"
      if [ -e "$oldfin" ] && [ ! -e "$bak" ]; then rm -f "$mark"; fi
      echo "consecrate: cannot move the current final aside — nothing promoted$([ -e "$mark" ] && printf '%s' ' (marker kept: state unclear, validate blocks until resolved)')"
      return 1; }
  fi
  stage="placed"
  mv "$cand" "$fin" || { trap - INT TERM
    [ -n "$oldfin" ] && [ -e "$bak" ] && mv "$bak" "$oldfin" 2>/dev/null
    rm -rf "$cand"
    local mvok_=1
    if [ -n "$oldfin" ]; then { [ -e "$oldfin" ] && [ ! -e "$bak" ]; } || mvok_=0
    else [ -e "$fin" ] && mvok_=0; fi
    [ "$mvok_" = 1 ] && rm -f "$mark"
    echo "consecrate: cannot place the candidate at final — original restored where possible; nothing promoted$([ -e "$mark" ] && printf '%s' ' (marker kept: state unclear, validate blocks until resolved)')"
    return 1; }
  # The validation window: the one moment an unvalidated candidate sits in the final slot. The
  # in-process validate skips THIS doc's in-flight artifacts via a function argument — never a
  # variable, which the environment can inject (v0.3.3).
  if cmd_validate "$d"; then
    trap - INT TERM
    if [ -n "$oldfin" ]; then
      rm -rf "$bak" || echo "consecrate: warning — could not remove ${bak#"$ROOT"/}; validate blocks while it remains, remove it by hand"
    fi
    rm -f "$mark"
    echo "consecrate: $d consecrated — full validation: 1 run, clean. The reviewed draft IS the final, byte for byte."
    [ "$(cfgval completeness)" != "required" ] \
      && echo "  note: completeness is off — undetected omissions are outside this document's warranty (fidelity.completeness)"
    return 0
  else
    trap - INT TERM
    rm -rf "$fin"
    local rok_=1
    if [ -n "$oldfin" ]; then mv "$bak" "$oldfin" || rok_=0; fi
    if [ "$rok_" = 1 ]; then
      rm -f "$mark"
      echo "consecrate: full validation FAILED after staging — candidate rejected, original final preserved untouched. Fix the problems above and re-run."
    else
      # Restore failed: the backup is the only original. The marker stays — a mine whose final
      # slot is empty while the original sits in .final.bak must not validate green.
      echo "consecrate: full validation FAILED and the backup could NOT be restored over final — the original is still in ${bak#"$ROOT"/}; restore it by hand. The in-flight marker stays (validate blocks until resolved)."
    fi
    return 1
  fi
}
scan_upgrade() { # -> kind<TAB>display, one v1→v2 migration item per line. Read-only; shared by
  # --check, --dry-run and --apply so the three can never disagree about what the migration IS.
  local pv cv b c d f n
  pv=$(fm "$PROJECT" version 2>/dev/null); cv=$(cfgval version)
  [ "$pv" = "1" ] && printf 'version\tproject.md version: 1 → 2\n'
  [ "$cv" = "1" ] && printf 'version\tconfig.yaml version: 1 → 2\n'
  for d in "$MATERIALS"/*/; do
    [ -d "$d" ] || continue; b=$(basename "$d")
    c=$(canon_id "$b") || continue
    [ "$b" = "$c" ] || printf 'rename\tmaterials/%s → %s (folder, id:, catalog, strict references)\n' "$b" "$c"
  done
  for f in "$TRUTHS"/t[0-9]*.md; do
    [ -f "$f" ] || continue; b=$(basename "$f" .md)
    c=$(canon_id "$b") || continue
    [ "$b" = "$c" ] || printf 'rename\ttruths/%s → %s (file, id:, strict references)\n' "$b" "$c"
  done
  if [ -f "$TRUTHS/verify.md" ]; then
    # Verdictless rows: success-shaped (passes N/N) gain the verdict word; anything else is named
    # for human review — the machine never certifies what the ledger did not.
    nocomment < "$TRUTHS/verify.md" | section_all - "Verified units" | sed 's/·/ /g' \
      | awk -v vd="${SCH[verify.units.verified]}" '
        BEGIN { if (vd == "") vd = "verified" }
        { line=$0
          if (line !~ /^[[:space:]]*[|-]/) next
          if (line ~ /^[[:space:]]*\|[[:space:]|:-]*$/) next
          if (line !~ /[mt][0-9]/) next
          v=line; gsub(/[[:space:]|*.-]+$/, "", v)
          if (tolower(v) ~ ("(^|[^a-z_])" vd "$")) next
          # Success evidence means COMPLETE evidence: `passes 1/2` is a run that stopped short,
          # and stamping it verified would erase unfinished work from the debt (v0.3.1 finding).
          ok2 = 0
          if (match(line, /passes[[:space:]]*[0-9]+\/[0-9]+/)) {
            pn = substr(line, RSTART, RLENGTH)
            sub(/passes[[:space:]]*/, "", pn); split(pn, ab, "/")
            if (ab[1] + 0 == ab[2] + 0 && ab[2] + 0 > 0) ok2 = 1
          }
          if (ok2)
            print "verdict\tVerified units row gains its trailing verdict word: " line
          else
            print "verdict-manual\trow names units but shows no COMPLETE success evidence (passes N/N with N=N) — review by hand: " line }'
    while IFS= read -r b; do
      nocomment < "$TRUTHS/verify.md" | grep -qE "^#{1,2}[ 	]+${b}[ 	]*\$" \
        || printf 'verify-section\ttruths/verify.md gains an empty section: ## %s\n' "$b"
    done < <(pipes "${SCH[verify.sections]}")
  fi
  grep -qE '^[[:space:]]+repeat:[[:space:]]*[0-9]' "$CONFIG" 2>/dev/null \
    && printf 'repeat\tconfig scalar repeat → per-scale map (skip 0 · light/standard keep the scalar · full is one stricter)\n'
  # v1 reviews are digest-less by definition; on schema 2 they need the audit marker or the
  # unsealed-review block would refuse the very mine the migration just produced. Gated on v1
  # like the ledger materialization below — cmd_upgrade already refuses v2 mines, but THIS item
  # is the one that laundered stripped seals into "history" when it ran ungated (v0.3.2).
  if [ "$pv" = "1" ] || [ "$cv" = "1" ]; then
    for d in $(doc_ids); do
      f="$DOCUMENTS/$d/review.md"; [ -f "$f" ] || continue
      fmv "$f" reviewed_digest;  [ -n "$REPLY" ] && continue
      fmv "$f" review_legacy;    [ -n "$REPLY" ] && continue
      printf 'review-legacy\tdocuments/%s/review.md → marked review_legacy (v1 history, digest-less; new rounds seal via seal-review)\n' "$d"
    done
  fi
  for d in $(doc_ids); do
    f="$DOCUMENTS/$d/review.md"; [ -f "$f" ] || continue
    n=$(nocomment < "$f" | awk '
      /^#/ { sec=$0; sub(/^#+[[:space:]]*/, "", sec); sub(/[[:space:]]*$/, "", sec); next }
      sec != "Fidelity violations" && /^[[:space:]]*[-|*].*\[[A-Za-z_ -]+\]/ {
        s=$0; match(s, /\[[A-Za-z_ -]+\]/); k=substr(s, RSTART+1, RLENGTH-2)
        gsub(/[^a-zA-Z]/, "", k); k=tolower(k)
        if (k=="contradiction" || k=="unsupported" || k=="missingrequired") cnt++ }
      END { print cnt+0 }')
    [ "${n:-0}" -gt 0 ] && printf 'review-history\tdocuments/%s/review.md: %s bracketed kind record(s) outside the gate → brackets removed (record form; VERIFY none was an open violation)\n' "$d" "$n"
  done
  # Ledger materialization belongs to the v1 migration only: on a v2 mine, a markdown row with
  # no sidecar twin is the LEGAL legacy-unbound state (preserved, re-verified by risk) — not
  # pending work, or "nothing to do" would be unreachable for any mine with history.
  if [ "$pv" = "1" ] || [ "$cv" = "1" ]; then
    # Two lanes, two sources (v0.3.2): t-ids come from the markdown Verified units — that ledger
    # is the TRUTHS lane. An m-id mention there is extraction scope, not a conversion verdict
    # (WD-COR-001); the material lane's v1 record is the material's own `status: verified`, and
    # minting m rows from the mention demoted mandatory debt into non-blocking legacy backlog.
    local vids scov miss mfmv_ mm_ mmiss_ mcov_
    vids=$(scan_verified_units | sed -n 's/^V\t//p' | grep -E '^t[0-9]' | LC_ALL=C sort -u || true)
    scov=$(ledger_rows | cut -f1 | LC_ALL=C sort -u)
    miss=$(comm -23 <(printf '%s\n' "$vids" | grep . || true) <(printf '%s\n' "$scov" | grep . || true))
    [ -n "$miss" ] && printf 'ledger\t%s markdown-verified truth unit(s) → verify-ledger.tsv rows verdict=legacy-unbound origin=%s (digest NOT back-stamped — §11 decision)\n' \
      "$(printf '%s' "$miss" | grep -c .)" "${SCH[verify.ledger.origin.truths]:-v1-truths-ledger}"
    mfmv_=""
    while IFS= read -r mm_; do
      [ -f "$MATERIALS/$mm_/converted.md" ] || continue
      fmv "$MATERIALS/$mm_/converted.md" status
      [ "$REPLY" = "verified" ] && mfmv_="$mfmv_$mm_"$'\n'
    done < <(material_ids)
    # Material-lane coverage is origin-aware (v0.3.3): an origin-less m legacy row (a ≤0.3.1
    # mint) is NOT material evidence, so it must not block the correct row on a resumed
    # migration — only a real verdict or the material origin token covers this lane.
    mcov_=$(ledger_rows | awk -F'\t' -v tok="${SCH[verify.ledger.origin.material]:-v1-material-frontmatter}" \
      '$1 ~ /^m/ && ($3 != "legacy-unbound" || $4 == tok) { print $1 }' | LC_ALL=C sort -u)
    mmiss_=$(comm -23 <(printf '%s' "$mfmv_" | grep . | LC_ALL=C sort -u || true) <(printf '%s\n' "$mcov_" | grep . || true))
    [ -n "$mmiss_" ] && printf 'ledger\t%s material(s) with v1 status: verified → verify-ledger.tsv rows verdict=legacy-unbound origin=%s\n' \
      "$(printf '%s' "$mmiss_" | grep -c .)" "${SCH[verify.ledger.origin.material]:-v1-material-frontmatter}"
  fi
  return 0
}
cmd_upgrade() { # upgrade [--check|--dry-run|--apply] [--from 0.1] — v1 mine → schema 2
  local mode="--check" from="0.1"
  while [ $# -gt 0 ]; do
    case "$1" in
      --check|--dry-run|--apply) mode="$1" ;;
      --from) shift; from="${1:-}" ;;
      *) echo "usage: weavedoc upgrade [--check|--dry-run|--apply] [--from 0.1]"; return 2 ;;
    esac
    shift
  done
  [ "$from" = "0.1" ] || { echo "upgrade: only --from 0.1 is supported (v1 → schema $(schema_ver))"; return 2; }
  # upgrade is the v1→2 migration and NOTHING else (v0.3.2): it runs only while at least one
  # version record still says 1. A crashed apply stamps project before config, so a half-stamped
  # mine must still read as v1 — requiring BOTH would make a crash unrecoverable. A mine already
  # at schema 2 gets "nothing to do" WITHOUT scanning: the scan's items are migration writes, and
  # running them on a v2 mine was the seal-laundering path (strip the seals, run --apply, and the
  # review_legacy marker stamped tamper as history). A mine NEWER than this runtime is
  # fail-closed, mirroring validate: guessing at a future format is how corruption ships.
  # The version matrix is CLOSED (v0.3.3): each record is 1 or the current schema, nothing
  # else — `version: banana` used to skip the numeric future-check and read as "already at
  # schema 2" with exit 0, a success report over a mine this migration cannot even classify.
  local pv_ cv_ v_ sv_
  pv_=$(fm "$PROJECT" version 2>/dev/null); cv_=$(cfgval version); sv_=$(schema_ver)
  for v_ in "$pv_" "$cv_"; do
    case "$v_" in
      1|"$sv_") ;;
      ''|*[!0-9]*)
        echo "upgrade: version record '${v_:-<missing>}' is not a version this migration understands — a v1 mine says 1, a current mine says $sv_; fix the version: fields in project.md/config.yaml first"
        return 2 ;;
      *)
        if [ "$v_" -gt "$sv_" ]; then
          echo "upgrade: this mine declares schema $v_, newer than this runtime (schema $sv_) — refusing to touch a format this code cannot read; use a newer runtime"
        else
          echo "upgrade: version record '$v_' is not a version this migration understands — supported records are 1 and $sv_"
        fi
        return 2 ;;
    esac
  done
  if [ "$pv_" != "1" ] && [ "$cv_" != "1" ]; then
    echo "upgrade: nothing to do — the mine is already at schema $sv_"
    return 0
  fi
  local items n
  items=$(scan_upgrade)
  n=$(printf '%s' "$items" | grep -c . || true); n=${n:-0}
  if [ "$n" -eq 0 ]; then
    echo "upgrade: nothing to do — the mine is already at schema $(schema_ver)"
    return 0
  fi
  case "$mode" in
    --check)
      echo "upgrade --check: $n migration item(s) v1 → schema $(schema_ver)  (read-only — nothing written)"
      printf '%s\n' "$items" | awk -F'\t' '{ printf "  [%s] %s\n", $1, $2 }'
      echo "  next: weavedoc upgrade --dry-run (full plan) · weavedoc upgrade --apply (staged, rollback-safe)"
      return 1 ;;
    --dry-run)
      echo "upgrade --dry-run: $n item(s), 0 write(s) — the plan:"
      printf '%s\n' "$items" | awk -F'\t' '{ print "  would: " $2 }'
      echo "  expected after apply: project at schema $(schema_ver) · validate clean · history preserved as legacy-unbound, never back-stamped"
      return 1 ;;
    --apply)
      upgrade_apply "$n" ;;
  esac
}
upgrade_apply() { # the staged, rollback-safe v1 → v2 transaction (§8 safety principles 1–12)
  local nitems="$1" today bak
  today=$(date +%F)
  bak="$ROOT/.upgrade-backup-$today.$$"

  # -- helpers: every touched path is snapshotted ONCE before its first edit; every created path
  # -- is recorded. Rollback = remove created, restore touched, in that order.
  bkup() { local p="$1"
    [ -e "$ROOT/$p" ] || return 0
    [ -e "$bak/$p" ] && return 0
    # A path this transaction CREATED is not an original — snapshotting it would make rollback
    # resurrect the mid-transaction copy right after the created-removal pass deleted it.
    [ -f "$bak/.created" ] && grep -qxF "$p" "$bak/.created" && return 0
    mkdir -p "$bak/$(dirname "$p")" 2>/dev/null
    cp -r "$ROOT/$p" "$bak/$p"
    printf '%s\n' "$p" >> "$bak/.touched"
  }
  crtd() { printf '%s\n' "$1" >> "$bak/.created"; }
  rollback() {
    local p
    [ -f "$bak/.created" ] && while IFS= read -r p; do rm -rf "$ROOT/$p"; done < "$bak/.created"
    [ -f "$bak/.touched" ] && while IFS= read -r p; do rm -rf "$ROOT/$p"; cp -r "$bak/$p" "$ROOT/$p"; done < "$bak/.touched"
    rm -rf "$bak"
  }
  canon_refs() { # $1=old $2=new — canonicalize STRICT reference fields + ledgers; NEVER prose
    local o="$1" nw="$2" f pass
    for pass in 1 2; do   # boundary regex can eat a shared separator between adjacent ids
      for f in "$TRUTHS"/t[0-9]*.md; do
        [ -f "$f" ] || continue
        bkup "${f#"$ROOT"/}"
        sed -E -i "/^[[:space:]]*(source|conflict_with|derived_from|corroborated_by|winner|corrects)[[:space:]]*:/ s/(^|[^0-9A-Za-z])${o}([^0-9A-Za-z]|\$)/\\1${nw}\\2/g" "$f"
      done
      if [ -f "$ROOT/catalog.md" ]; then
        bkup catalog.md
        sed -E -i "s/\|([[:space:]]*)${o}([[:space:]]*)\|/|\\1${nw}\\2|/g" "$ROOT/catalog.md"
      fi
      if [ -f "$TRUTHS/coverage.md" ]; then
        bkup "${TRUTHS#"$ROOT"/}/coverage.md"
        sed -E -i "s/(^|[^0-9A-Za-z])${o}([^0-9A-Za-z]|\$)/\\1${nw}\\2/g" "$TRUTHS/coverage.md"
      fi
      for f in $(doc_ids); do
        [ -f "$DOCUMENTS/$f/plan.md" ] || continue
        bkup "${DOCUMENTS#"$ROOT"/}/$f/plan.md"
        sed -E -i "/^[[:space:]]*cited_truths[[:space:]]*:/ s/(^|[^0-9A-Za-z])${o}([^0-9A-Za-z]|\$)/\\1${nw}\\2/g" "$DOCUMENTS/$f/plan.md"
      done
    done
  }

  # -- precheck (§8 principle 3): every rename target must be free BEFORE one byte moves — free
  # -- on disk AND free among the other renames: t01 and t1 both canonicalize to t001, and a
  # -- sequential apply would have the second silently overwrite the first (v0.3.1 finding).
  local b c d f pairs="" mtargets=" " ttargets=" "
  for d in "$MATERIALS"/*/; do
    [ -d "$d" ] || continue; b=$(basename "$d"); c=$(canon_id "$b") || continue
    [ "$b" = "$c" ] && continue
    [ -e "$MATERIALS/$c" ] && { echo "upgrade: rename collision — materials/$c already exists next to materials/$b; resolve by hand (nothing written)"; return 1; }
    case "$mtargets" in *" $c "*) echo "upgrade: rename collision — two material folders both canonicalize to $c; resolve by hand (nothing written)"; return 1 ;; esac
    mtargets="$mtargets$c "
    pairs="$pairs m:$b:$c"
  done
  for f in "$TRUTHS"/t[0-9]*.md; do
    [ -f "$f" ] || continue; b=$(basename "$f" .md); c=$(canon_id "$b") || continue
    [ "$b" = "$c" ] && continue
    [ -e "$TRUTHS/$c.md" ] && { echo "upgrade: rename collision — truths/$c.md already exists next to truths/$b.md; resolve by hand (nothing written)"; return 1; }
    case "$ttargets" in *" $c "*) echo "upgrade: rename collision — two truth files both canonicalize to $c (e.g. t01.md and t1.md); resolve by hand (nothing written)"; return 1 ;; esac
    ttargets="$ttargets$c "
    pairs="$pairs t:$b:$c"
  done
  # -- verdict-manual rows block the WHOLE apply: stamping schema 2 over rows the machine cannot
  # -- certify would leave --check red forever while apply reports success (broken idempotence),
  # -- and worse, would move unfinished verification out of sight. Human first, stamp second.
  local manual
  manual=$(scan_upgrade | grep '^verdict-manual' || true)
  if [ -n "$manual" ]; then
    echo "upgrade: rows in ## Verified units need a human ruling before apply can stamp schema 2 (nothing written):"
    printf '%s\n' "$manual" | awk -F'\t' '{ print "  - " $2 }'
    echo "  fix each row (complete the verification, or mark its real verdict), then re-run"
    return 1
  fi
  mkdir -p "$bak" || { echo "upgrade: cannot create backup dir $bak"; return 1; }

  # -- 1. canonical renames + strict-reference rewrite (prose and changelog history untouched:
  # -- lenient resolution reads old spellings, and consecrated bytes are never edited).
  local kind old new
  for b in $pairs; do
    kind=${b%%:*}; c=${b#*:}; old=${c%%:*}; new=${c#*:}
    if [ "$kind" = "m" ]; then
      bkup "${MATERIALS#"$ROOT"/}/$old"
      cp -r "$MATERIALS/$old" "$MATERIALS/$new"; rm -rf "$MATERIALS/$old"
      crtd "${MATERIALS#"$ROOT"/}/$new"
      sed -i "s/^id: $old\$/id: $new/" "$MATERIALS/$new/converted.md"
    else
      bkup "${TRUTHS#"$ROOT"/}/$old.md"
      cp "$TRUTHS/$old.md" "$TRUTHS/$new.md"; rm -f "$TRUTHS/$old.md"
      crtd "${TRUTHS#"$ROOT"/}/$new.md"
      sed -i "s/^id: $old\$/id: $new/" "$TRUTHS/$new.md"
    fi
    canon_refs "$old" "$new"
  done

  # -- 2. verify.md: success rows gain their verdict word; missing sections appended empty.
  if [ -f "$TRUTHS/verify.md" ]; then
    bkup "${TRUTHS#"$ROOT"/}/verify.md"
    awk -v vd="${SCH[verify.units.verified]}" '
      BEGIN { if (vd == "") vd = "verified" }
      { line=$0; t=line; gsub(/·/, " ", t)
        if (t !~ /^[[:space:]]*[|-]/ || t ~ /^[[:space:]]*\|[[:space:]|:-]*$/ || t !~ /[mt][0-9]/) { print line; next }
        v=t; gsub(/[[:space:]|*.-]+$/, "", v)
        if (tolower(v) ~ ("(^|[^a-z_])" vd "$")) { print line; next }
        ok2 = 0
        if (match(t, /passes[[:space:]]*[0-9]+\/[0-9]+/)) {
          pn = substr(t, RSTART, RLENGTH)
          sub(/passes[[:space:]]*/, "", pn); split(pn, ab, "/")
          if (ab[1] + 0 == ab[2] + 0 && ab[2] + 0 > 0) ok2 = 1
        }
        if (ok2) print line " · " vd; else print line }
    ' "$TRUTHS/verify.md" > "$TRUTHS/.verify.tmp" && mv "$TRUTHS/.verify.tmp" "$TRUTHS/verify.md"
    while IFS= read -r b; do
      nocomment < "$TRUTHS/verify.md" | grep -qE "^#{1,2}[ 	]+${b}[ 	]*\$" \
        || printf '\n## %s\n' "$b" >> "$TRUTHS/verify.md"
    done < <(pipes "${SCH[verify.sections]}")
  fi

  # -- 3. review history: bracketed kinds outside the gate lose their brackets (record form).
  for d in $(doc_ids); do
    f="$DOCUMENTS/$d/review.md"; [ -f "$f" ] || continue
    bkup "${DOCUMENTS#"$ROOT"/}/$d/review.md"
    awk '
      /^#/ { sec=$0; sub(/^#+[[:space:]]*/, "", sec); sub(/[[:space:]]*$/, "", sec); print; next }
      sec != "Fidelity violations" && /^[[:space:]]*[-|*].*\[[A-Za-z_ -]+\]/ {
        s=$0; match(s, /\[[A-Za-z_ -]+\]/); k=substr(s, RSTART+1, RLENGTH-2)
        kn=k; gsub(/[^a-zA-Z]/, "", kn); kn=tolower(kn)
        if (kn=="contradiction" || kn=="unsupported" || kn=="missingrequired") { sub(/\[[A-Za-z_ -]+\]/, k, s); print s; next } }
      { print }' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  done

  # -- 4. config: scalar repeat → per-scale map; then version stamps (both records of one fact).
  if grep -qE '^[[:space:]]+repeat:[[:space:]]*[0-9]' "$CONFIG" 2>/dev/null; then
    bkup .weavedoc/config.yaml
    awk '
      /^  repeat:[[:space:]]*[0-9]/ {
        v=$0; sub(/^  repeat:[[:space:]]*/, "", v); sub(/[[:space:]#].*$/, "", v)
        print "  repeat:                # clean rounds IN A ROW required to pass, by scale (migrated from scalar " v ")"
        print "    skip:     0"
        print "    light:    " v
        print "    standard: " v
        print "    full:     " v+1
        next }
      { print }' "$CONFIG" > "$CONFIG.tmp" && mv "$CONFIG.tmp" "$CONFIG"
  fi

  # -- 5. regenerate the generated views under the canonical spellings.
  bkup "${TRUTHS#"$ROOT"/}/index.md"; bkup "${TRUTHS#"$ROOT"/}/tree.md"
  cmd_reindex >/dev/null 2>&1

  # -- 6. materialize digest-less verified history as legacy-unbound sidecar rows — preserved,
  # -- never back-stamped with a digest the verification never computed (§11 decision). Two
  # -- lanes, two sources (v0.3.2): t-ids from the markdown Verified units (the truths lane —
  # -- an m-id mention there is extraction scope, not a conversion verdict, WD-COR-001), and
  # -- materials from their OWN `status: verified`. Each row records its origin in the standard
  # -- column, which is what lets scope tell a correct mint from a pre-0.3.2 cross-lane one.
  local vids scov miss lf mfmv_ mm_ mmiss_ mcov_
  vids=$(scan_verified_units | sed -n 's/^V\t//p' | grep -E '^t[0-9]' | LC_ALL=C sort -u || true)
  scov=$(ledger_rows | cut -f1 | LC_ALL=C sort -u)
  miss=$(comm -23 <(printf '%s\n' "$vids" | grep . || true) <(printf '%s\n' "$scov" | grep . || true))
  mfmv_=""
  while IFS= read -r mm_; do
    [ -f "$MATERIALS/$mm_/converted.md" ] || continue
    fmv "$MATERIALS/$mm_/converted.md" status
    [ "$REPLY" = "verified" ] && mfmv_="$mfmv_$mm_"$'\n'
  done < <(material_ids)
  # Material-lane coverage is origin-aware (v0.3.3) — same rule as the scan: an origin-less m
  # legacy row (a ≤0.3.1 mint) must not block the correct row on a resumed migration.
  mcov_=$(ledger_rows | awk -F'\t' -v tok="${SCH[verify.ledger.origin.material]:-v1-material-frontmatter}" \
    '$1 ~ /^m/ && ($3 != "legacy-unbound" || $4 == tok) { print $1 }' | LC_ALL=C sort -u)
  mmiss_=$(comm -23 <(printf '%s' "$mfmv_" | grep . | LC_ALL=C sort -u || true) <(printf '%s\n' "$mcov_" | grep . || true))
  if [ -n "$miss" ] || [ -n "$mmiss_" ]; then
    lf="$TRUTHS/$(ledger_file)"
    if [ -f "$lf" ]; then bkup "${TRUTHS#"$ROOT"/}/$(ledger_file)"; else crtd "${TRUTHS#"$ROOT"/}/$(ledger_file)"; fi
    { [ -f "$lf" ] && cat "$lf" \
        || printf '# machine-owned verification ledger — append-only; LAST row per id wins. Written by `weavedoc attest`.\n# id\tsha256\tverdict\tround\tstandard\tdate\n'
      printf '%s\n' "$miss" | grep . | awk -v d="$today" -v o="${SCH[verify.ledger.origin.truths]:-v1-truths-ledger}" \
        '{ printf "%s\t-\tlegacy-unbound\t-\t%s\t%s\n", $1, o, d }'
      printf '%s\n' "$mmiss_" | grep . | awk -v d="$today" -v o="${SCH[verify.ledger.origin.material]:-v1-material-frontmatter}" \
        '{ printf "%s\t-\tlegacy-unbound\t-\t%s\t%s\n", $1, o, d }'
    } > "$lf.tmp" && mv "$lf.tmp" "$lf"
  fi

  # -- 6b. digest-less reviews receive the audit marker — the record that says "v1 history",
  # -- which is what lets the v2 unsealed-review block distinguish history from tamper.
  for d in $(doc_ids); do
    f="$DOCUMENTS/$d/review.md"; [ -f "$f" ] || continue
    fmv "$f" reviewed_digest;  [ -n "$REPLY" ] && continue
    fmv "$f" review_legacy;    [ -n "$REPLY" ] && continue
    if head -1 "$f" | grep -q '^---[ 	]*$'; then
      bkup "${DOCUMENTS#"$ROOT"/}/$d/review.md"
      awk -v dt="$today" '
        NR==1 && /^---[ \t]*$/ { print; print "review_legacy: " dt "   # v1 review, digest-less by definition — migrated, not tampered"; next }
        { print }' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    else
      # A genuine v0.1 review may have NO frontmatter block at all. The scan promised a marker
      # this branch could not insert, so post-validate hit GATE-UNSEALED and rolled the whole
      # migration back — such a mine was permanently unmigratable (v0.3.2 finding). The marker
      # gets a fresh block instead.
      bkup "${DOCUMENTS#"$ROOT"/}/$d/review.md"
      { printf -- '---\nreview_legacy: %s   # v1 review, digest-less by definition — migrated, not tampered\n---\n\n' "$today"
        cat "$f"; } > "$f.tmp" && mv "$f.tmp" "$f"
    fi
  done

  # -- 7. version stamps, LAST among the edits: a crashed apply resumes as a v1 rescan.
  bkup project.md; sed -i 's/^version: 1$/version: 2/' "$PROJECT"
  bkup .weavedoc/config.yaml; sed -i 's/^version: 1/version: 2/' "$CONFIG"

  # -- 8. the same full validation everything else answers to (§8 principles 7–8).
  if cmd_validate; then
    { echo "upgrade applied: $today · bundle $(cat "$ROOT/.weavedoc/VERSION" 2>/dev/null) · $nitems item(s)"
      echo "touched (originals preserved in this directory):"
      [ -f "$bak/.touched" ] && sed 's/^/  /' "$bak/.touched" | LC_ALL=C sort -u
      echo "created:"
      [ -f "$bak/.created" ] && sed 's/^/  /' "$bak/.created" | LC_ALL=C sort -u
    } > "$bak/MANIFEST.txt"
    echo "upgrade --apply: applied $nitems item(s) — schema $(schema_ver), validate clean."
    echo "  backup + manifest: ${bak#"$ROOT"/}/ (originals; delete when you no longer want the restore point)"
    return 0
  else
    rollback
    echo "upgrade --apply: post-apply validation FAILED — every change rolled back, the mine is byte-identical to before. Fix the problems above (they predate the migration), then re-run."
    return 1
  fi
}
cmd_attest() { # attest <verified|failed> <round> <standard> <id...> — the verification write path
  preflight_gnu || return 2
  # THE one writer of verification records: the digest is computed here, never by hand, so the
  # hash rule has a single spelling. All-or-nothing: every id resolves before one byte is written.
  [ $# -ge 4 ] || { echo "usage: weavedoc attest <verified|failed> <round> <standard> <id...>"; return 2; }
  local verdict="$1" round="$2" standard="$3"; shift 3
  local vds; vds=${SCH[verify.ledger.verdicts]}; vds=${vds:-verified|failed}
  in_list "$verdict" "$vds" \
    || { echo "attest: verdict '$verdict' must be one of: $vds"; return 2; }
  case "$round" in ''|0|*[!0-9]*) echo "attest: round '$round' must be a positive integer"; return 2 ;; esac
  local id cid st dg tf today rows="" line="" names=""
  today=$(date +%F)
  for id in "$@"; do
    cid=$(canon_id "$id") || { echo "attest: '$id' is not a material/truth id — nothing written"; return 2; }
    case "$cid" in
      m*) [ -f "$MATERIALS/$cid/converted.md" ] || { echo "attest: no converted.md for '$id' ($cid) — nothing written"; return 2; }
          st=$(fm "$MATERIALS/$cid/converted.md" status) ;;
      *)  tf=$(tfile_for "$cid") || { echo "attest: no truth file for '$id' ($cid) — nothing written"; return 2; }
          st=$(fm "$tf" status) ;;
    esac
    case "$st" in retracted|discarded)
      echo "attest: $cid is $st — a tombstone is outside the verification population; nothing written"; return 2 ;; esac
    dg=$(unit_digest "$cid") || { echo "attest: cannot digest '$id' ($cid) — nothing written"; return 2; }
    printf -v line '%s\t%s\t%s\t%s\t%s\t%s' "$cid" "$dg" "$verdict" "$round" "$standard" "$today"
    rows="$rows$line"$'\n'
    names="$names $cid"
  done
  local lf tmp; lf="$TRUTHS/$(ledger_file)"; tmp="$lf.tmp.$$"
  [ -d "$TRUTHS" ] || { echo "attest: no truths/ directory"; return 2; }
  { if [ -f "$lf" ]; then cat "$lf"
    else printf '# machine-owned verification ledger — append-only; LAST row per id wins. Written by `weavedoc attest`.\n# id\tsha256\tverdict\tround\tstandard\tdate\n'; fi
    printf '%s' "$rows"; } > "$tmp" && mv "$tmp" "$lf" \
    || { rm -f "$tmp" 2>/dev/null; echo "attest: ledger write failed"; return 1; }
  # Human mirror line into `## Verified units` — the markdown stays the readable view. The sidecar
  # is scope's source of truth, so a missing section costs readability, never coverage. Failed
  # verdicts stay sidecar-only: a markdown row ending otherwise would be named as covering nothing.
  if [ "$verdict" = "verified" ] && [ -f "$TRUTHS/verify.md" ] \
     && grep -qE '^#+[[:space:]]*Verified units[[:space:]]*$' "$TRUTHS/verify.md"; then
    local mline mtmp
    mline=$(printf -- '- %s — R%s %s · %s · verified' "$(printf '%s' "$names" | sed 's/^ //; s/ / · /g')" "$round" "$today" "$standard")
    mtmp="$TRUTHS/verify.md.tmp.$$"
    awk -v line="$mline" '{ print } !done && /^#+[[:space:]]*Verified units[[:space:]]*$/ { print line; done=1 }' \
      "$TRUTHS/verify.md" > "$mtmp" && mv "$mtmp" "$TRUTHS/verify.md" || rm -f "$mtmp" 2>/dev/null
  fi
  printf 'attest: %s — R%s · %s · %s —%s\n' "$verdict" "$round" "$standard" "$today" "$names"
  return 0
}
cmd_scope() {
  local ledger ledger_bad ledger_sbad
  ledger=$(ledger_rows)
  ledger_sbad=$(ledger_rows_badstruct | tr '\n' ' ')
  # ONE frontmatter pass for every material + a bash map over the ledger (v0.3.4): the loop
  # below used to spawn fm_load's awk per material and a printf|awk row lookup per material.
  local -a spre_=()
  local sf_ lrid_ lrrest_
  for sf_ in "$MATERIALS"/*/converted.md; do [ -f "$sf_" ] && spre_+=("$sf_"); done
  [ "${#spre_[@]}" -gt 0 ] && fm_preload "${spre_[@]}"
  local -A LROW=()
  while IFS=$'\t' read -r lrid_ lrrest_; do [ -n "$lrid_" ] && LROW[$lrid_]=$lrrest_; done <<< "$ledger"
  # Unknown verdicts are quarantined BEFORE classification — they cover nothing and are named;
  # letting them fall through to the digest compare is how a typo once counted as verified.
  ledger_bad=$(printf '%s\n' "$ledger" | awk -F'\t' 'NF >= 3 && $3 != "verified" && $3 != "failed" && $3 != "legacy-unbound" { print $1 " (" $3 ")" }')
  ledger=$(printf '%s\n' "$ledger" | awk -F'\t' '$3 == "verified" || $3 == "failed" || $3 == "legacy-unbound"')

  # ---- materials: population = converted.md holders minus tombstones. Evidence precedence:
  # sidecar row (digest decides bound/stale, verdict decides failed) > v1 `status: verified`
  # (legacy-unbound: real history, binds no bytes) > nothing (unverified).
  local m mstat row dg vd std
  local n_mconv=0 n_mbound=0 n_mlegacy=0 n_mstale=0 n_mfail=0 n_munver=0 n_mused=0
  local munver="" mstale="" mfail="" mlegacy="" m_originless="" cur
  while IFS= read -r m; do
    [ -f "$MATERIALS/$m/converted.md" ] || continue
    fmv "$MATERIALS/$m/converted.md" status; mstat=$REPLY
    [ "$mstat" = "retracted" ] && continue
    n_mconv=$((n_mconv+1))
    row=${LROW[$m]-}
    dg=""; vd=""; std=""
    [ -n "$row" ] && IFS=$'\t' read -r dg vd std <<< "$row"
    if [ -n "$row" ] && [ "$vd" = "legacy-unbound" ] \
       && [ "$std" != "${SCH[verify.ledger.origin.material]:-v1-material-frontmatter}" ]; then
      # A pre-0.3.2 migration minted material rows from the TRUTHS-lane markdown ledger — an
      # m-id mention there is extraction scope, not a conversion verdict (WD-COR-001). Such a
      # row is not material evidence: the material falls back to its own frontmatter (owed
      # again when that says nothing), and the ignored row is SHOWN, never absorbed.
      m_originless="$m_originless $m"
      row=""
    fi
    if [ -n "$row" ]; then
      if [ "$vd" = "failed" ]; then n_mfail=$((n_mfail+1)); mfail="$mfail $m"
      elif [ "$vd" = "legacy-unbound" ]; then
        # migration-written row: history preserved, no bytes bound — never digest-compared
        n_mlegacy=$((n_mlegacy+1)); mlegacy="$mlegacy $m"
      else
        cur=$(mat_digest "$MATERIALS/$m/converted.md")
        if [ "$cur" = "$dg" ]; then n_mbound=$((n_mbound+1))
        else n_mstale=$((n_mstale+1)); mstale="$mstale $m"; fi
      fi
    elif [ "$mstat" = "verified" ]; then
      n_mlegacy=$((n_mlegacy+1)); mlegacy="$mlegacy $m"
    else
      # `used` lands here too — lifecycle, not a verdict (WD-COR-001).
      n_munver=$((n_munver+1)); munver="$munver $m"
      [ "$mstat" = "used" ] && n_mused=$((n_mused+1))
    fi
  done < <(material_ids)

  # ---- truths: ONE awk pass classifies live vs tombstone (retracted/discarded leave the
  # population — the same rule retracted materials follow). Emits class<TAB>canon<TAB>rawbase.
  local tl ondisk tomb n_t=0 n_tomb=0
  tl=$(awk '
    function emit() { if (f == "") return
      n = split(f, seg, /[\/\\]/); raw = seg[n]; sub(/\.md$/, "", raw)
      canon = sprintf("t%03d", substr(raw, 2) + 0)
      if (st == "retracted" || st == "discarded") print "X\t" canon "\t" raw
      else print "L\t" canon "\t" raw }
    FNR==1 { emit(); f=FILENAME; st=""; infm=0 }
    FNR==1 && /^---[[:space:]]*$/ { infm=1; next }
    infm && /^---[[:space:]]*$/   { infm=0; next }
    infm && st=="" && /^status[[:space:]]*:/ {
      st=$0; sub(/^status[[:space:]]*:[[:space:]]*/, "", st)
      if (st !~ /^"/) sub(/[[:space:]]+#.*$/, "", st)
      sub(/[[:space:]]*$/, "", st); next }
    END { emit() }' "$TRUTHS"/t[0-9]*.md 2>/dev/null)
  ondisk=$(printf '%s\n' "$tl" | awk -F'\t' '$1=="L" { print $2 }' | LC_ALL=C sort -u)
  tomb=$(printf '%s\n' "$tl" | awk -F'\t' '$1=="X" { print $2 }' | LC_ALL=C sort -u)
  n_t=$(printf '%s' "$ondisk" | grep -c . || true); n_t=${n_t:-0}
  n_tomb=$(printf '%s' "$tomb" | grep -c . || true); n_tomb=${n_tomb:-0}

  # ---- sidecar-covered live truths: current digests in ONE sha256sum spawn, then classify.
  local strows scov="" tclass="" incov files cur_t
  strows=$(printf '%s\n' "$ledger" | grep -E '^t[0-9]' || true)
  if [ -n "$strows" ]; then
    scov=$(printf '%s\n' "$strows" | cut -f1 | LC_ALL=C sort -u)
    incov=$(comm -12 <(printf '%s\n' "$ondisk") <(printf '%s\n' "$scov"))
    if [ -n "$incov" ]; then
      files=$(awk -F'\t' 'NR==FNR { want[$0]=1; next } $1=="L" && ($2 in want) { print $3 ".md" }' \
        <(printf '%s\n' "$incov") <(printf '%s\n' "$tl"))
      cur_t=$(cd "$TRUTHS" && sha256sum $files 2>/dev/null \
        | awk '{ f=$NF; sub(/^\*/, "", f)              # MSYS sha256sum defaults to binary mode: "hash *name"
                 n=split(f, s, /[\/\\]/); b=s[n]; sub(/\.md$/, "", b); printf "t%03d\t%s\n", substr(b, 2) + 0, $1 }')
      tclass=$(awk -F'\t' '
        NR==FNR { cur[$1]=$2; next }
        { if (!($1 in cur)) next
          if ($3 == "legacy-unbound") { print "L\t" $1; next }
          if ($3 == "failed") print "F\t" $1
          else if (cur[$1] == $2) print "B\t" $1
          else print "S\t" $1 }' <(printf '%s\n' "$cur_t") <(printf '%s\n' "$strows"))
    fi
  fi
  local n_tbound n_tstale n_tfail tstale tfail
  n_tbound=$(printf '%s\n' "$tclass" | grep -c '^B' || true)
  n_tstale=$(printf '%s\n' "$tclass" | grep -c '^S' || true)
  n_tfail=$(printf '%s\n' "$tclass" | grep -c '^F' || true)
  tstale=$(printf '%s\n' "$tclass" | sed -n 's/^S\t//p' | LC_ALL=C sort -u)
  tfail=$(printf '%s\n' "$tclass" | sed -n 's/^F\t//p' | LC_ALL=C sort -u)

  # ---- v1 markdown ledger: verified ids not covered by the sidecar are legacy-unbound.
  local scan vids unmarked tlegacy tunver tghost diskany n_tlegacy n_tunver
  scan=$(scan_verified_units)
  vids=$(printf '%s\n' "$scan" | sed -n 's/^V\t//p' | grep -E '^t[0-9]' | LC_ALL=C sort -u)
  unmarked=$(printf '%s\n' "$scan" | sed -n 's/^U\t//p')
  diskany=$(printf '%s\n' "$ondisk" "$tomb" | grep . | LC_ALL=C sort -u)
  tlegacy=$(comm -12 <(printf '%s\n' "$vids") <(printf '%s\n' "$ondisk") | comm -23 - <(printf '%s\n' "$scov"))
  # sidecar rows written by migration carry the legacy verdict themselves — union both sources
  tlegacy=$(printf '%s\n' "$tlegacy" "$(printf '%s\n' "$tclass" | sed -n 's/^L\t//p')" | grep . | LC_ALL=C sort -u)
  tunver=$(comm -23 <(printf '%s\n' "$ondisk") <(printf '%s\n' "$scov") | comm -23 - <(printf '%s\n' "$vids"))
  tghost=$(printf '%s\n' "$vids" "$scov" | grep . | LC_ALL=C sort -u | comm -23 - <(printf '%s\n' "$diskany"))
  n_tlegacy=$(printf '%s' "$tlegacy" | grep -c . || true)
  n_tunver=$(printf '%s' "$tunver" | grep -c . || true)

  if [ "$WD_JSON" = 1 ]; then
    # Sets, not adjectives — the same five evidence classes the human view prints, as arrays a
    # consumer can act on (a verify round owes unverified + stale + failed).
    jarr() { local out="" x; for x in $1; do out+="${out:+,}\"$(json_esc "$x")\""; done; printf '[%s]' "$out"; }
    printf '{"output_schema_version":1,"command":"scope","bundle":"%s","schema_version":%s,' \
      "$(json_esc "$(cat "$ROOT/.weavedoc/VERSION" 2>/dev/null)")" "$(schema_ver)"
    printf '"materials":{"converted":%s,"verified_bound":%s,"legacy_unbound":%s,"stale":%s,"failed":%s,"unverified":%s,"used_but_unverified":%s,"originless_rows_ignored":%s,"owed":%s},' \
      "$n_mconv" "$n_mbound" "$n_mlegacy" "$n_mstale" "$n_mfail" "$n_munver" "$n_mused" "$(jarr "$m_originless")" "$(jarr "$munver $mstale $mfail")"
    printf '"truths":{"live":%s,"verified_bound":%s,"legacy_unbound":%s,"stale":%s,"failed":%s,"unverified":%s,"tombstones":%s,"owed":%s},' \
      "$n_t" "$n_tbound" "$n_tlegacy" "$n_tstale" "$n_tfail" "$n_tunver" "$n_tomb" \
      "$(jarr "$(printf '%s %s %s' "$tunver" "$tstale" "$tfail" | tr '\n' ' ')")"
    printf '"ghost_ledger_ids":%s}\n' "$(jarr "$(printf '%s' "$tghost" | tr '\n' ' ')")"
    return 0
  fi
  echo "scope — what a verify round still owes (computed from disk + the ledgers, not judged)"
  if [ "$n_mconv" -eq 0 ] && [ "$n_t" -eq 0 ] && [ "$n_tomb" -eq 0 ]; then
    echo "  nothing to verify yet — no converted material, no truths"
    return 0
  fi
  if [ "$n_mconv" -gt 0 ]; then
    printf '  materials  %s converted · %s verified (digest-bound) · %s legacy-unbound · %s stale · %s failed · %s unverified   (source: truths/%s + material frontmatter)\n' \
      "$n_mconv" "$n_mbound" "$n_mlegacy" "$n_mstale" "$n_mfail" "$n_munver" "$(ledger_file)"
    [ -n "$munver" ] && printf '    → %s\n' "$(printf '%s\n' $munver | LC_ALL=C sort -u | compress_ids)"
    [ "$n_mused" -gt 0 ] && printf '    (%s of them status:used — `used` records citation, not verification; a verify round still owes them)\n' "$n_mused"
    [ -n "$mstale" ]  && printf '    → stale: %s\n'  "$(printf '%s\n' $mstale  | LC_ALL=C sort -u | compress_ids)"
    [ -n "$mfail" ]   && printf '    → failed: %s\n' "$(printf '%s\n' $mfail   | LC_ALL=C sort -u | compress_ids)"
    [ -n "$mlegacy" ] && printf '    → legacy-unbound: %s\n' "$(printf '%s\n' $mlegacy | LC_ALL=C sort -u | compress_ids)"
    # SHOWN, never absorbed: an ignored row that vanished silently would look identical to a
    # ledger that never held it, and nobody would know a mine migrated by ≤0.3.1 needs re-verify.
    [ -n "$m_originless" ] && printf '    (%s pre-0.3.2 m-id ledger row(s) ignored — origin-less legacy rows are truths-lane history, not material evidence; each material reads from its own status instead: %s)\n' \
      "$(printf '%s\n' $m_originless | grep -c . || true)" "$(printf '%s\n' $m_originless | LC_ALL=C sort -u | compress_ids)"
  fi
  if [ "$n_t" -gt 0 ] || [ "$n_tomb" -gt 0 ]; then
    printf '  truths     %s live · %s verified (digest-bound) · %s legacy-unbound · %s stale · %s failed · %s unverified   (source: truths/%s + ## Verified units)\n' \
      "$n_t" "$n_tbound" "$n_tlegacy" "$n_tstale" "$n_tfail" "$n_tunver" "$(ledger_file)"
    [ "$n_tunver" -gt 0 ] && printf '    → %s\n' "$(printf '%s\n' "$tunver" | compress_ids)"
    [ -n "$tstale" ] && printf '    → stale: %s\n' "$(printf '%s\n' "$tstale" | compress_ids)"
    [ -n "$tfail" ]  && printf '    → failed: %s\n' "$(printf '%s\n' "$tfail" | compress_ids)"
    [ "$n_tlegacy" -gt 0 ] && printf '    → legacy-unbound: %s\n' "$(printf '%s\n' "$tlegacy" | compress_ids)"
    [ "$n_tomb" -gt 0 ] && printf '    (%s tombstone truth(s) — retracted/discarded — out of scope)\n' "$n_tomb"
    if [ ! -f "$TRUTHS/verify.md" ] && [ ! -f "$TRUTHS/$(ledger_file)" ]; then
      echo "    (no verification ledger — nothing has been cold-verified, so every truth is owed)"
    elif [ -n "$tghost" ]; then
      # A ledger naming ids that no longer exist covers nothing; said out loud because the covered
      # count would otherwise look larger than the mine and nobody could tell why.
      printf '    ledger names %s id(s) with no truth file — they cover nothing: %s\n' \
        "$(printf '%s' "$tghost" | grep -c . || true)" "$(printf '%s\n' "$tghost" | compress_ids)"
    fi
  fi
  # SHOWN, never absorbed — the same discipline `status` applies to untagged queue entries. An
  # entry that names units but carries no verdict covers nothing, and the safe failure direction is
  # to verify it again; but silently treating it as unverified would look identical to a ledger
  # that simply hadn't got there yet, and nobody would know a line needed one word added.
  if [ -n "$unmarked" ]; then
    printf '  ledger: %s entry(s) name units but end in no "%s" verdict — they cover nothing; add the verdict or leave the units owed:\n' \
      "$(printf '%s' "$unmarked" | grep -c . || true)" "${SCH[verify.units.verified]}"
    printf '%s\n' "$unmarked" | sed 's/^[[:space:]]*/    /'
  fi
  if [ -n "$ledger_bad" ]; then
    printf '  ledger: row(s) with unknown verdicts — they cover nothing [LEDGER-VERDICT]: %s\n' \
      "$(printf '%s' "$ledger_bad" | tr '\n' ' ')"
  fi
  if [ -n "${ledger_sbad% }" ]; then
    # The shared strict filter dropped these before classification — shown here so a truncated
    # or hand-mangled row reads as "covers nothing" in scope AND blocks in validate, never one
    # without the other (v0.3.3: two parsers on one ledger was the drift class itself).
    printf '  ledger: structurally malformed row(s) — they cover nothing [LEDGER-MALFORMED]: %s\n' "$ledger_sbad"
  fi
  local owed=$((n_munver + n_mstale + n_mfail + n_tunver + n_tstale + n_tfail))
  if [ "$owed" -eq 0 ] && [ $((n_mlegacy + n_tlegacy)) -gt 0 ]; then
    printf '  → nothing unverified — %s legacy-unbound unit(s) await digest binding: re-verify by risk (final-cited · high-risk · research/adopted/derived first). History is preserved, never counted digest-bound.\n' "$((n_mlegacy + n_tlegacy))"
  elif [ "$owed" -eq 0 ]; then
    echo "  → nothing unverified. A round here would re-check what the ledger already covers."
  else
    echo "  → a round examines the sets above. Units already covered are not re-verified without a reason recorded in verify.md."
  fi
  return 0
}

# ===================== dispatch =====================
# Every command validates its FULL argument list (WD-CLI-001): an extra argument or an unknown
# flag is a typo'd intention, and a tool that ignores it does something other than what was asked.
usage2() { echo "usage: $1" >&2; exit 2; }
case "${1:-}" in
  validate) shift; [ "${1:-}" = "--json" ] && { WD_JSON=1; shift; }; [ $# -eq 0 ] || usage2 "weavedoc validate [--json]"; cmd_validate ;;
  impact)   shift; [ $# -eq 1 ] || usage2 "weavedoc impact <material-id>"; cmd_impact "$1" ;;
  status)   shift; [ $# -eq 0 ] || usage2 "weavedoc status";   cmd_status ;;
  scope)    shift; [ "${1:-}" = "--json" ] && { WD_JSON=1; shift; }; [ $# -eq 0 ] || usage2 "weavedoc scope [--json]"; cmd_scope ;;
  attest)   shift; cmd_attest "$@" ;;
  seal-review) shift; { [ $# -ge 1 ] && [ $# -le 2 ]; } || usage2 "weavedoc seal-review <doc-id> [draft|final]"; cmd_seal_review "$1" "${2:-}" ;;
  consecrate)  shift; [ $# -eq 1 ] || usage2 "weavedoc consecrate <doc-id>"; cmd_consecrate "$1" ;;
  upgrade)  shift; cmd_upgrade "$@" ;;
  gaps)     shift; [ $# -eq 0 ] || usage2 "weavedoc gaps";     cmd_gaps ;;
  census)   shift; [ $# -eq 0 ] || usage2 "weavedoc census";   cmd_census ;;
  reindex)  shift; cmd_reindex "$@" ;;
  retag)    shift; { [ $# -ge 2 ] && [ $# -le 3 ]; } || usage2 "weavedoc retag <old> <new> [--dry]"; cmd_retag "$1" "$2" "${3:-}" ;;
  pull)     shift; [ $# -eq 1 ] || usage2 "weavedoc pull <term>"; cmd_pull "$1" ;;
  lang)     shift; [ $# -eq 0 ] || usage2 "weavedoc lang";     cmd_lang ;;
  locale)   shift; [ $# -eq 0 ] || usage2 "weavedoc locale";   cmd_locale ;;
  version)  shift; [ "${1:-}" = "--json" ] && { WD_JSON=1; shift; }; [ $# -eq 0 ] || usage2 "weavedoc version [--json]"; cmd_version ;;
  *) echo "weavedoc — validate | pull <term> | impact <material-id> | status | scope | attest <verdict> <round> <standard> <id...> | seal-review <doc-id> [draft|final] | consecrate <doc-id> | gaps | census | reindex [--check] | retag <old> <new> [--dry] | version | lang | locale"; exit 2 ;;
esac
