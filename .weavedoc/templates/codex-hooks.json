{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${WEAVEDOC_ROOT:+$WEAVEDOC_ROOT/}.weavedoc/bin/hooks/lease.mjs\"",
            "commandWindows": "if defined WEAVEDOC_ROOT (node \"%WEAVEDOC_ROOT%/.weavedoc/bin/hooks/lease.mjs\") else (node .weavedoc/bin/hooks/lease.mjs)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${WEAVEDOC_ROOT:+$WEAVEDOC_ROOT/}.weavedoc/bin/hooks/gate.mjs\"",
            "commandWindows": "if defined WEAVEDOC_ROOT (node \"%WEAVEDOC_ROOT%/.weavedoc/bin/hooks/gate.mjs\") else (node .weavedoc/bin/hooks/gate.mjs)"
          }
        ]
      }
    ]
  }
}
